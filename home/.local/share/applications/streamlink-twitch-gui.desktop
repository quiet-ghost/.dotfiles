[Desktop Entry]
Type=Application
Name=Streamlink Twitch GUI
GenericName=Twitch.tv browser for Streamlink
Comment=Browse Twitch.tv and watch streams in your videoplayer of choice
Keywords=streamlink;twitch;streaming;
Categories=AudioVideo;Network;
StartupWMClass=streamlink-twitch-gui
Exec=/usr/bin/streamlink-twitch-gui --force-device-scale-factor=1
Icon=streamlink-twitch-gui
