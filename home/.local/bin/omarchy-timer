#!/bin/bash

set -euo pipefail

STATE_DIR="$HOME/.cache/omarchy-timer"
STATE_FILE="$STATE_DIR/state"
FINISHED_FILE="$STATE_DIR/finished"
UNIT="omarchy-timer"
ALARM_UNIT="omarchy-timer-alarm"
CONFIG_FILE="$HOME/.config/omarchy/timer.conf"

TIMER_ALARM_SOUND="alarm-clock-elapsed"
TIMER_ALARM_REPEAT=4
TIMER_ALARM_INTERVAL=1
TIMER_ALARM_PLAY_TIMEOUT=2
TIMER_NOTIFICATION_TIMEOUT=10000

if [[ -f $CONFIG_FILE ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

clear_state() {
  rm -f "$STATE_FILE"
}

clear_finished() {
  rm -f "$FINISHED_FILE"
}

read_state() {
  [[ -f "$STATE_FILE" ]] || return 1

  mapfile -t state_lines < "$STATE_FILE"
  (( ${#state_lines[@]} >= 2 )) || return 1

  end_epoch=${state_lines[0]}
  label=${state_lines[1]}
  kind=${state_lines[2]:-timer}
  cycle=${state_lines[3]:-0}
  case $kind in
    timer|focus|short-break|long-break) ;;
    *) kind=timer ;;
  esac
  [[ $cycle =~ ^[0-9]+$ ]] || cycle=0
}

format_remaining() {
  local total=$1
  local hours minutes seconds

  (( hours = total / 3600 ))
  (( minutes = (total % 3600) / 60 ))
  (( seconds = total % 60 ))

  if (( hours > 0 )); then
    printf '%d:%02d:%02d' "$hours" "$minutes" "$seconds"
  else
    printf '%02d:%02d' "$minutes" "$seconds"
  fi
}

normalize_label() {
  local total=$1
  local hours minutes seconds

  (( hours = total / 3600 ))
  (( minutes = (total % 3600) / 60 ))
  (( seconds = total % 60 ))

  if (( hours > 0 && minutes > 0 && seconds == 0 )); then
    printf '%dh %dm' "$hours" "$minutes"
  elif (( hours > 0 && minutes == 0 && seconds == 0 )); then
    printf '%dh' "$hours"
  elif (( hours == 0 && minutes > 0 && seconds == 0 )); then
    printf '%dm' "$minutes"
  elif (( hours == 0 && minutes == 0 )); then
    printf '%ds' "$seconds"
  else
    printf '%ds' "$total"
  fi
}

parse_duration() {
  local input=$1
  input=${input,,}
  input=${input// /}

  if [[ $input =~ ^[0-9]+$ ]]; then
    duration_seconds=$(( 10#$input * 60 ))
    duration_label="${input}m"
    return 0
  fi

  if [[ $input =~ ^([0-9]+)(s|m|h)$ ]]; then
    local value=${BASH_REMATCH[1]}
    local unit=${BASH_REMATCH[2]}

    case $unit in
      s) duration_seconds=$(( 10#$value )) ;;
      m) duration_seconds=$(( 10#$value * 60 )) ;;
      h) duration_seconds=$(( 10#$value * 3600 )) ;;
    esac

    duration_label="$(normalize_label "$duration_seconds")"
    return 0
  fi

  return 1
}

prompt() {
  exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=Timer -e bash -lc 'omarchy-timer prompt-ui; status=$?; if (( status != 130 )); then omarchy-show-done; fi; exit $status'
}

show_timer_banner() {
  clear
  echo -e "\033[32m"
  cat <<'EOF'
████████╗██╗███╗   ███╗███████╗██████╗
╚══██╔══╝██║████╗ ████║██╔════╝██╔══██╗
   ██║   ██║██╔████╔██║█████╗  ██████╔╝
   ██║   ██║██║╚██╔╝██║██╔══╝  ██╔══██╗
   ██║   ██║██║ ╚═╝ ██║███████╗██║  ██║
   ╚═╝   ╚═╝╚═╝     ╚═╝╚══════╝╚═╝  ╚═╝
EOF
  echo -e "\033[0m"
  echo
}

prompt_ui() {
  local input

  show_timer_banner

  input=$(gum input \
    --header="Set a timer" \
    --prompt="Duration> " \
    --placeholder="10, 25m, 1h, 90s" \
    --value="10") || exit 130

  if [[ -z ${input// /} ]]; then
    exit 130
  fi

  start_timer "$input"
  echo
  printf 'Started timer for %s\n' "$duration_label"
}

start_timer() {
  local input=$1
  local requested_label=${2:-}
  local requested_kind=${3:-timer}
  local requested_cycle=${4:-0}
  local now end command

  if ! parse_duration "$input"; then
    omarchy-notification-send -u normal "Invalid timer" "Use minutes by default, or specify 10m, 1h, or 90s."
    exit 1
  fi

  if [[ -n $requested_label ]]; then
    [[ $requested_label != *$'\n'* && $requested_label != *$'\r'* ]] || {
      printf 'Timer label may not contain a newline.\n' >&2
      exit 2
    }
    duration_label=$requested_label
  fi

  case $requested_kind in
    timer|focus|short-break|long-break) ;;
    *)
      printf 'Unknown timer kind: %s\n' "$requested_kind" >&2
      exit 2
      ;;
  esac
  [[ $requested_cycle =~ ^[0-9]+$ ]] && (( requested_cycle <= 9999 )) || {
    printf 'Timer cycle must be between 0 and 9999.\n' >&2
    exit 2
  }

  ensure_state_dir
  systemctl --user stop "$UNIT".service >/dev/null 2>&1 || true
  clear_finished

  now=$(date +%s)
  end=$(( now + duration_seconds ))
  printf '%s\n%s\n%s\n%s\n' "$end" "$duration_label" "$requested_kind" "$requested_cycle" > "$STATE_FILE"

  printf -v command '%q finish %q %q %q' "$0" "$duration_label" "$requested_kind" "$requested_cycle"
  systemd-run --user --unit="$UNIT" --collect /bin/bash -lc "sleep $duration_seconds; $command" >/dev/null

  omarchy-notification-send -u low "Timer started" "$duration_label" -t 3000
}

finish_timer() {
  local finished_label=${1:-}
  local finished_kind=${2:-timer}
  local finished_cycle=${3:-0}

  [[ $finished_label != *$'\n'* && $finished_label != *$'\r'* ]] || exit 2
  case $finished_kind in
    timer|focus|short-break|long-break) ;;
    *) exit 2 ;;
  esac
  [[ $finished_cycle =~ ^[0-9]+$ ]] && (( finished_cycle <= 9999 )) || exit 2

  if [[ -z $finished_label ]] && read_state; then
    finished_label=$label
  fi

  ensure_state_dir
  printf '%s\n%s\n%s\n' "$finished_kind" "$finished_cycle" "$finished_label" > "$FINISHED_FILE"
  clear_state
  omarchy-notification-send -u critical "Timer done" "${finished_label:-Your timer} finished." -t "$TIMER_NOTIFICATION_TIMEOUT"
  systemd-run --user --unit="$ALARM_UNIT" --collect "$0" alarm >/dev/null 2>&1 || true
}

cancel_timer() {
  local should_notify=0

  if [[ -f "$STATE_FILE" ]]; then
    should_notify=1
  fi

  systemctl --user stop "$UNIT".service >/dev/null 2>&1 || true
  systemctl --user stop "$ALARM_UNIT".service >/dev/null 2>&1 || true
  clear_state
  clear_finished
  if (( should_notify == 1 )); then
    omarchy-notification-send -u low "Timer canceled" -t 2000
  fi
}

state() {
  local now remaining=0 active=false
  local finished_kind="" finished_cycle=0 finished_label=""

  if read_state; then
    now=$(date +%s)
    remaining=$(( end_epoch - now ))
    if (( remaining > 0 )); then
      active=true
    else
      clear_state
    fi
  else
    end_epoch=0
    label=""
    kind="timer"
    cycle=0
  fi

  if [[ -f $FINISHED_FILE ]]; then
    mapfile -t finished_lines < "$FINISHED_FILE"
    finished_kind=${finished_lines[0]:-}
    finished_cycle=${finished_lines[1]:-0}
    finished_label=${finished_lines[2]:-}
  fi

  jq -cn \
    --argjson active "$active" \
    --argjson remaining "$remaining" \
    --arg label "$label" \
    --arg kind "$kind" \
    --argjson cycle "$cycle" \
    --arg finishedKind "$finished_kind" \
    --argjson finishedCycle "$finished_cycle" \
    --arg finishedLabel "$finished_label" \
    '{active:$active,remaining:$remaining,label:$label,kind:$kind,cycle:$cycle,finished:{kind:$finishedKind,cycle:$finishedCycle,label:$finishedLabel}}'
}

status() {
  local now remaining text tooltip

  if ! read_state; then
    clear_state
    exit 0
  fi

  now=$(date +%s)
  remaining=$(( end_epoch - now ))

  if (( remaining <= 0 )); then
    clear_state
    exit 0
  fi

  text="󰔛 $(format_remaining "$remaining")"
  tooltip="$label remaining\nLeft click: set timer\nRight click: cancel timer"
  jq -cn --arg text "$text" --arg tooltip "$tooltip" --arg class "active" '{text:$text,tooltip:$tooltip,class:$class}'
}

play_alarm_sound() {
  local i

  for (( i = 0; i < TIMER_ALARM_REPEAT; i++ )); do
    if [[ -f $TIMER_ALARM_SOUND ]]; then
      timeout "$TIMER_ALARM_PLAY_TIMEOUT" pw-play "$TIMER_ALARM_SOUND" >/dev/null 2>&1 || \
        timeout "$TIMER_ALARM_PLAY_TIMEOUT" paplay "$TIMER_ALARM_SOUND" >/dev/null 2>&1 || true
    else
      timeout "$TIMER_ALARM_PLAY_TIMEOUT" canberra-gtk-play -i "$TIMER_ALARM_SOUND" >/dev/null 2>&1 || true
    fi

    if (( i + 1 < TIMER_ALARM_REPEAT )); then
      sleep "$TIMER_ALARM_INTERVAL"
    fi
  done
}

case ${1:-} in
  prompt)
    prompt
    ;;
  prompt-ui)
    prompt_ui
    ;;
  alarm)
    play_alarm_sound
    ;;
  start)
    shift
    start_timer "${1:-}" "${2:-}" "${3:-timer}" "${4:-0}"
    ;;
  finish)
    shift
    finish_timer "${1:-}" "${2:-timer}" "${3:-0}"
    ;;
  cancel)
    cancel_timer
    ;;
  status)
    status
    ;;
  state)
    state
    ;;
  acknowledge)
    clear_finished
    ;;
  *)
    printf 'Usage: %s {prompt|start <duration> [label kind cycle]|finish [label kind cycle]|cancel|status|state|acknowledge}\n' "$0" >&2
    exit 1
    ;;
esac
