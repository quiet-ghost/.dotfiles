#!/usr/bin/env bash
# Open a ghui pull request as an editable local worktree.
set -euo pipefail

# ghui may inherit Herdr's minimal PATH. Keep sibling dotfile commands visible.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PATH="$SCRIPT_DIR:$HOME/.local/bin:$PATH"
export PATH

usage() {
  cat <<'EOF'
Usage: ghui-pr-worktree <owner/repo> <pr-number>

Resolve or clone the repository, create/reuse a PR worktree under ~/dev/worktrees, and open
Neovim with Diffview. Herdr and tmux are detected by wt; without a multiplexer,
Neovim runs in the current terminal.
EOF
}

die() {
  printf 'ghui-pr-worktree: %s\n' "$1" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

remote_matches_repo() {
  local url="$1"
  local repo="$2"

  url="${url%/}"
  url="${url%.git}"
  [[ "$url" == *":${repo}" || "$url" == *"/${repo}" ]]
}

find_matching_remote() {
  local repo_path="$1"
  local repo="$2"
  local remote url
  local -A seen=()

  for remote in origin upstream $(git -C "$repo_path" remote); do
    [[ -n "$remote" && -z "${seen[$remote]:-}" ]] || continue
    seen["$remote"]=1
    url="$(git -C "$repo_path" remote get-url "$remote" 2>/dev/null || true)"
    if [[ -n "$url" ]] && remote_matches_repo "$url" "$repo"; then
      printf '%s\n' "$remote"
      return 0
    fi
  done

  return 1
}

clone_destination() {
  local repo="$1"
  local owner="${repo%%/*}"
  local name="${repo#*/}"
  local viewer base destination

  viewer="$(gh api user --jq .login)"
  if [[ "${owner,,}" == "${viewer,,}" ]]; then
    base="$HOME/dev/projects"
  else
    base="$HOME/dev/repos"
  fi

  destination="$base/$name"
  if [[ -e "$destination" ]]; then
    destination="$base/${owner}-${name}"
  fi
  [[ ! -e "$destination" ]] || die "clone destination already exists: $destination"

  mkdir -p "$base"
  printf 'Cloning %s into %s\n' "$repo" "$destination" >&2
  gh repo clone "$repo" "$destination" >&2
  printf '%s\n' "$destination"
}

resolve_repo_path() {
  local repo="$1"
  local path

  if path="$(gh-repo-path "$repo" 2>/dev/null)"; then
    printf '%s\n' "$path"
  else
    clone_destination "$repo"
  fi
}

worktree_for_branch() {
  local repo_path="$1"
  local branch="$2"

  git -C "$repo_path" worktree list --porcelain |
    awk -v target="refs/heads/$branch" '
      $1 == "worktree" { path = substr($0, 10) }
      $1 == "branch" && $2 == target { print path; exit }
    '
}

main() {
  [[ $# -eq 2 ]] || {
    usage >&2
    exit 2
  }

  local repo="$1"
  local requested_number="$2"
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "invalid repository: $repo"
  [[ "$requested_number" =~ ^[1-9][0-9]*$ ]] || die "invalid PR number: $requested_number"

  local command
  for command in gh git jq nvim wt gh-repo-path; do
    need_cmd "$command"
  done

  local repo_path remote metadata number base_ref pr_url branch review_ref
  repo_path="$(resolve_repo_path "$repo")"
  remote="$(find_matching_remote "$repo_path" "$repo")" || die "no remote in $repo_path matches $repo"

  metadata="$(gh pr view "$requested_number" --repo "$repo" --json number,baseRefName,url)"
  number="$(jq -er '.number' <<<"$metadata")"
  base_ref="$(jq -er '.baseRefName' <<<"$metadata")"
  pr_url="$(jq -er '.url' <<<"$metadata")"
  branch="pr/$number"
  review_ref="refs/remotes/ghui/pr/$number"

  printf 'Fetching %s PR #%s\n' "$repo" "$number" >&2
  git -C "$repo_path" fetch "$remote" --prune
  git -C "$repo_path" fetch "$remote" "+refs/pull/$number/head:$review_ref"

  if ! git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_path" branch --no-track "$branch" "$review_ref"
  fi

  local review_ref_q repo_q number_q url_q base_q diffview_q editor_command
  printf -v review_ref_q '%q' "$review_ref"
  printf -v repo_q '%q' "$repo"
  printf -v number_q '%q' "$number"
  printf -v url_q '%q' "$pr_url"
  printf -v base_q '%q' "$base_ref"
  printf -v diffview_q '%q' "DiffviewOpen ${remote}/${base_ref}...HEAD --imply-local"

  editor_command="if ! git merge --ff-only $review_ref_q; then printf '%s\\n' 'PR branch has local commits or changes; opening without fast-forwarding.' >&2; fi; GHUI_PR_REPO=$repo_q GHUI_PR_NUMBER=$number_q GHUI_PR_URL=$url_q GHUI_PR_BASE_REF=$base_q nvim -c $diffview_q"

  cd "$repo_path"

  if [[ -n "${HERDR_ENV:-}" || -n "${HERDR_SOCKET_PATH:-}" || -n "${TMUX:-}" ]]; then
    exec wt --no-fetch --window-name "pr-$number" --exec "$editor_command" "$branch"
  fi

  wt --no-fetch --mux none "$branch" >/dev/null
  local worktree_path
  worktree_path="$(worktree_for_branch "$repo_path" "$branch")"
  [[ -n "$worktree_path" ]] || die "could not find worktree for $branch"
  cd "$worktree_path"
  exec bash -c "$editor_command"
}

main "$@"
