#!/usr/bin/env bash
# Git worktree deleter - Remove worktrees and optionally branches
# Usage: wd [branch-name]

set -euo pipefail

_WT_PATHS=""
if [[ -f "${BASH_SOURCE[0]%/*}/../lib/wt-paths.sh" ]]; then
  _WT_PATHS="${BASH_SOURCE[0]%/*}/../lib/wt-paths.sh"
elif [[ -f "$HOME/.local/lib/wt-paths.sh" ]]; then
  _WT_PATHS="$HOME/.local/lib/wt-paths.sh"
else
  printf 'Error: missing wt-paths.sh\n' >&2
  exit 1
fi
# shellcheck source=../lib/wt-paths.sh
source "$_WT_PATHS"

DELETE_REMOTE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --delete-remote)
      DELETE_REMOTE=true
      shift
      ;;
    --help|-h)
      printf 'Usage: wd [--delete-remote] [branch-name]\n'
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

branch_name_for_path() {
  local path="$1"

  git -C "$path" branch --show-current
}

herdr_workspace_for_path() {
  local path="$1"

  if ! command -v herdr >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    return 0
  fi

  herdr workspace list 2>/dev/null |
    jq -r --arg path "$path" \
      '.result.workspaces[]? | select(.worktree.checkout_path == $path) | .workspace_id' |
    head -n1
}

close_herdr_workspace() {
  local path="$1"
  local workspace_id

  workspace_id="$(herdr_workspace_for_path "$path")"
  if [[ -z "$workspace_id" ]]; then
    return 0
  fi

  echo "Closing Herdr workspace: $workspace_id"
  if ! herdr workspace close "$workspace_id" >/dev/null; then
    printf 'Error: Failed to close Herdr workspace %s; worktree was not removed\n' "$workspace_id" >&2
    exit 1
  fi
}

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

MAIN_CHECKOUT="$(wt_main_checkout)"
REPO_ROOT="$MAIN_CHECKOUT"
cd "$REPO_ROOT"

worktrees=()
declare -A worktree_paths=()
declare -A worktree_branches=()

path=""
branch=""
bare=""
detached=""
while IFS= read -r line; do
  case "$line" in
    worktree\ *)
      path="${line#worktree }"
      branch=""
      bare=""
      detached=""
      ;;
    branch\ *)
      branch="${line#branch refs/heads/}"
      ;;
    bare)
      bare=1
      ;;
    detached)
      detached=1
      ;;
    "")
      if [[ -n "$path" && -z "$bare" && "$path" != "$MAIN_CHECKOUT" ]]; then
        display_name="$(wt_display_name_for_path "$path" "$MAIN_CHECKOUT")"
        if [[ -n "${worktree_paths[$display_name]:-}" ]]; then
          display_name="${display_name} (${path})"
        fi
        worktrees+=("$display_name")
        worktree_paths["$display_name"]="$path"
        if [[ -z "$detached" && -n "$branch" ]]; then
          worktree_branches["$display_name"]="$branch"
        fi
      fi
      path=""
      branch=""
      bare=""
      detached=""
      ;;
  esac
done < <(git worktree list --porcelain; printf '\n')

if [ ${#worktrees[@]} -eq 0 ]; then
  echo "No linked worktrees found"
  exit 0
fi

if [ -n "${1:-}" ]; then
  WORKTREE_NAME="$1"

  if [[ -n "${worktree_paths[$WORKTREE_NAME]:-}" ]]; then
    WORKTREE_ABS_PATH="${worktree_paths[$WORKTREE_NAME]}"
  else
    matched=""
    for name in "${worktrees[@]}"; do
      if [[ "${worktree_branches[$name]:-}" == "$WORKTREE_NAME" ]]; then
        matched="$name"
        break
      fi
    done
    if [[ -n "$matched" ]]; then
      WORKTREE_NAME="$matched"
      WORKTREE_ABS_PATH="${worktree_paths[$WORKTREE_NAME]}"
    else
      echo "Error: Worktree '$WORKTREE_NAME' not found"
      exit 1
    fi
  fi
else
  echo "Select worktree to remove:"
  WORKTREE_NAME=$(printf '%s\n' "${worktrees[@]}" | gum choose)

  if [ -z "$WORKTREE_NAME" ]; then
    echo "Cancelled."
    exit 0
  fi

  WORKTREE_ABS_PATH="${worktree_paths[$WORKTREE_NAME]}"
fi

BRANCH_NAME="${worktree_branches[$WORKTREE_NAME]:-}"
if [[ -z "$BRANCH_NAME" ]]; then
  BRANCH_NAME="$(branch_name_for_path "$WORKTREE_ABS_PATH")"
fi

if ! gum confirm "Remove worktree '$WORKTREE_NAME'?"; then
  echo "Cancelled."
  exit 0
fi

DELETE_BRANCH=false
if [[ -n "$BRANCH_NAME" ]] && git show-ref --verify --quiet "refs/heads/${BRANCH_NAME}"; then
  if gum confirm "Also delete branch '$BRANCH_NAME'?"; then
    DELETE_BRANCH=true
  fi
fi

close_herdr_workspace "$WORKTREE_ABS_PATH"

echo "Removing worktree: $WORKTREE_ABS_PATH"
git worktree remove "$WORKTREE_ABS_PATH" --force

if [ "$DELETE_BRANCH" = true ]; then
  echo "Deleting branch: $BRANCH_NAME"
  git branch -D "$BRANCH_NAME"

  if [ "$DELETE_REMOTE" = true ] && git ls-remote --exit-code --heads origin "$BRANCH_NAME" >/dev/null 2>&1; then
    echo "Deleting remote branch: origin/$BRANCH_NAME"
    git push origin --delete "$BRANCH_NAME"
  fi
fi

echo "✓ Worktree removed successfully!"
