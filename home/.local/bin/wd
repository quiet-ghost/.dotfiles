#!/usr/bin/env bash
# Git worktree deleter - Remove worktrees and optionally branches
# Usage: wd [branch-name]

set -euo pipefail

WORKTREE_DIR=".worktrees"
DELETE_REMOTE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --delete-remote)
      DELETE_REMOTE=true
      shift
      ;;
    --help|-h)
      printf 'Usage: wd [--delete-remote] [branch-name]\n'
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

resolve_worktree_path() {
  local worktree_name="$1"
  local candidate_path="$REPO_ROOT/$WORKTREE_DIR/$worktree_name"

  if [ -d "$candidate_path" ]; then
    printf '%s\n' "$candidate_path"
    return 0
  fi

  return 1
}

display_name_for_path() {
  local path="$1"
  local relative="${path#"$REPO_ROOT/$WORKTREE_DIR/"}"

  case "$relative" in
    issue/*|pr/*)
      printf '%s\n' "$relative"
      ;;
    *)
      printf '%s\n' "$relative"
      ;;
  esac
}

branch_name_for_path() {
  local path="$1"

  git -C "$path" branch --show-current
}

herdr_workspace_for_path() {
  local path="$1"

  if ! command -v herdr >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    return 0
  fi

  herdr workspace list 2>/dev/null |
    jq -r --arg path "$path" \
      '.result.workspaces[]? | select(.worktree.checkout_path == $path) | .workspace_id' |
    head -n1
}

close_herdr_workspace() {
  local path="$1"
  local workspace_id

  workspace_id="$(herdr_workspace_for_path "$path")"
  if [[ -z "$workspace_id" ]]; then
    return 0
  fi

  echo "Closing Herdr workspace: $workspace_id"
  if ! herdr workspace close "$workspace_id" >/dev/null; then
    printf 'Error: Failed to close Herdr workspace %s; worktree was not removed\n' "$workspace_id" >&2
    exit 1
  fi
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

# Get repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Check if .worktrees directory exists
if [ ! -d "$WORKTREE_DIR" ]; then
  echo "No worktrees directory found"
  exit 0
fi

# Get list of worktrees in .worktrees/
worktrees=()
declare -A worktree_paths=()
while IFS= read -r line; do
  path="${line%% *}"

  case "$path" in
    "$REPO_ROOT/$WORKTREE_DIR"/*)
      display_name="$(display_name_for_path "$path")"
      worktrees+=("$display_name")
      worktree_paths["$display_name"]="$path"
      ;;
  esac
done < <(git worktree list)

if [ ${#worktrees[@]} -eq 0 ]; then
  echo "No worktrees found in $WORKTREE_DIR/"
  exit 0
fi

# If argument provided, use it; otherwise let user choose
if [ -n "${1:-}" ]; then
  WORKTREE_NAME="$1"

  # Verify it exists
  if [[ -n "${worktree_paths[$WORKTREE_NAME]:-}" ]]; then
    WORKTREE_ABS_PATH="${worktree_paths[$WORKTREE_NAME]}"
  elif ! WORKTREE_ABS_PATH="$(resolve_worktree_path "$WORKTREE_NAME")"; then
    echo "Error: Worktree '$WORKTREE_NAME' not found in $WORKTREE_DIR/"
    exit 1
  fi
else
  # Use gum to choose worktree
  echo "Select worktree to remove:"
  WORKTREE_NAME=$(printf '%s\n' "${worktrees[@]}" | gum choose)
  
  if [ -z "$WORKTREE_NAME" ]; then
    echo "Cancelled."
    exit 0
  fi

  WORKTREE_ABS_PATH="${worktree_paths[$WORKTREE_NAME]}"
fi

WORKTREE_PATH="${WORKTREE_DIR}/${WORKTREE_NAME}"
BRANCH_NAME="$(branch_name_for_path "$WORKTREE_ABS_PATH")"

# Confirm removal
if ! gum confirm "Remove worktree '$WORKTREE_NAME'?"; then
  echo "Cancelled."
  exit 0
fi

# Ask about branch deletion
DELETE_BRANCH=false
if [[ -n "$BRANCH_NAME" ]] && git show-ref --verify --quiet "refs/heads/${BRANCH_NAME}"; then
  if gum confirm "Also delete branch '$BRANCH_NAME'?"; then
    DELETE_BRANCH=true
  fi
fi

# Close any workspace using the checkout before deleting its directory.
close_herdr_workspace "$WORKTREE_ABS_PATH"

# Remove the worktree
echo "Removing worktree: $WORKTREE_PATH"
git worktree remove "$WORKTREE_ABS_PATH" --force

# Delete branch if requested
if [ "$DELETE_BRANCH" = true ]; then
  echo "Deleting branch: $BRANCH_NAME"
  git branch -D "$BRANCH_NAME"

  if [ "$DELETE_REMOTE" = true ] && git ls-remote --exit-code --heads origin "$BRANCH_NAME" >/dev/null 2>&1; then
    echo "Deleting remote branch: origin/$BRANCH_NAME"
    git push origin --delete "$BRANCH_NAME"
  fi
fi

echo "✓ Worktree removed successfully!"
