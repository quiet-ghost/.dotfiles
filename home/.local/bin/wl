#!/usr/bin/env bash
# Git worktree lister - Show all worktrees with formatting
# Usage: wl

set -euo pipefail

_WT_PATHS=""
if [[ -f "${BASH_SOURCE[0]%/*}/../lib/wt-paths.sh" ]]; then
  _WT_PATHS="${BASH_SOURCE[0]%/*}/../lib/wt-paths.sh"
elif [[ -f "$HOME/.local/lib/wt-paths.sh" ]]; then
  _WT_PATHS="$HOME/.local/lib/wt-paths.sh"
else
  printf 'Error: missing wt-paths.sh\n' >&2
  exit 1
fi
# shellcheck source=../lib/wt-paths.sh
source "$_WT_PATHS"

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

MAIN_CHECKOUT="$(wt_main_checkout)"
cd "$MAIN_CHECKOUT"

echo "=== Git Worktrees ==="
echo ""

git worktree list | while IFS= read -r line; do
  path="${line%% *}"

  if [ "$path" = "$MAIN_CHECKOUT" ]; then
    printf '→ main\t%s\n' "$line"
  else
    name="$(wt_display_name_for_path "$path" "$MAIN_CHECKOUT")"
    printf '  %s\t%s\n' "$name" "$line"
  fi
done

echo ""
