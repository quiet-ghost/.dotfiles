#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 2 ]]; then
  printf 'Usage: gh-pr-review-session <owner/repo> <pr-number-or-url>\n' >&2
  exit 1
fi

REPO_NAME="$1"
PR_REF="$2"
PROMPT_TEXT='@code-reviewer: review-pr-for-this-branch'

cd "$(gh-repo-path "$REPO_NAME")"

exec wtpr \
  --no-prompt \
  --window-name "review-${PR_REF}" \
  --exec "opencode --prompt '$PROMPT_TEXT'" \
  "$PR_REF"
