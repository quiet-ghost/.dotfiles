#!/usr/bin/env bash

set -euo pipefail

CONFIG_FILE="${HOME}/.ssh/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-ssh"
HISTORY_FILE="$STATE_DIR/history"

read_hosts_file() {
  local file=$1 line keyword token pattern included
  local -a fields=()

  [[ -f $file ]] || return 0
  file=$(readlink -f "$file")
  [[ -z ${seen_config_files[$file]:-} ]] || return 0
  seen_config_files[$file]=1

  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    read -r -a fields <<<"$line"
    (( ${#fields[@]} > 0 )) || continue
    keyword=${fields[0],,}

    if [[ $keyword == include ]]; then
      for pattern in "${fields[@]:1}"; do
        pattern=${pattern#\"}
        pattern=${pattern%\"}
        pattern=${pattern/#\~/$HOME}
        [[ $pattern == /* ]] || pattern="$HOME/.ssh/$pattern"
        while IFS= read -r included; do
          read_hosts_file "$included"
        done < <(compgen -G "$pattern" || true)
      done
    elif [[ $keyword == host ]]; then
      for token in "${fields[@]:1}"; do
        [[ $token != *['*?!']* && $token =~ ^[A-Za-z0-9._:-]+$ ]] && printf '%s\n' "$token"
      done
    fi
  done < "$file"
}

hosts() {
  declare -A seen_config_files=()
  read_hosts_file "$CONFIG_FILE" | awk '!seen[$0]++'
}

known_hosts() {
  local file="${HOME}/.ssh/known_hosts" entry host
  [[ -f $file ]] || return 0
  while read -r entry _; do
    [[ -z ${entry:-} || $entry == \#* || $entry == \|* ]] && continue
    IFS=',' read -ra hosts <<<"$entry"
    for host in "${hosts[@]}"; do
      host=${host#[}
      if [[ $host == *']:'* ]]; then
        host=${host%%]:*}
      fi
      host=${host%]}
      [[ $host =~ ^[A-Za-z0-9._:-]+$ ]] && printf '%s\n' "$host"
    done
  done <"$file" | awk '!seen[$0]++'
}

valid_host() {
  [[ ${1:-} =~ ^[A-Za-z0-9._:-]+$ ]]
}

record_history() {
  local selected=$1 host
  local -a previous=()

  mkdir -p "$STATE_DIR"
  if [[ -f $HISTORY_FILE ]]; then
    mapfile -t previous < "$HISTORY_FILE"
  fi

  {
    printf '%s\n' "$selected"
    for host in "${previous[@]}"; do
      [[ -n $host && $host != "$selected" ]] && printf '%s\n' "$host"
    done
  } | awk 'NR <= 10' > "$HISTORY_FILE.tmp"
  mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

active_connections() {
  local pid args socket remote host

  while read -r pid args; do
    [[ -n ${pid:-} && $args != *ssh-agent* ]] || continue
    socket=$(ss -Htnp 2>/dev/null | awk -v pid="$pid" '$0 ~ "pid=" pid "," && $1 == "ESTAB" { print $5; exit }')
    [[ -n $socket ]] || continue
    remote=${socket%:*}
    remote=${remote#[}
    remote=${remote%]}
    host=$(sed -n 's/.*ssh[[:space:]]\+\([^[:space:]]*@\)\?\([^[:space:]-][^[:space:]]*\).*/\2/p' <<<"$args")
    [[ -n $host ]] || host=$remote
    jq -cn --argjson pid "$pid" --arg host "$host" --arg remote "$remote" '{pid:$pid,host:$host,remote:$remote}'
  done < <(pgrep -a -u "${USER:?USER is not set}" ssh || true)
}

host_record() {
  local host=$1 source=$2 resolved hostname user
  resolved=$(ssh -G "$host" 2>/dev/null || true)
  hostname=$(awk '$1 == "hostname" { print $2; exit }' <<<"$resolved")
  user=$(awk '$1 == "user" { print $2; exit }' <<<"$resolved")
  jq -cn --arg alias "$host" --arg hostname "${hostname:-$host}" --arg user "$user" --arg source "$source" \
    '{alias:$alias,hostname:$hostname,user:$user,source:$source}'
}

snapshot() {
  local host
  local hosts_json='[]' known_json='[]' history_json='[]' active_json='[]'
  local -A config_hosts=()

  while IFS= read -r host; do
    config_hosts[$host]=1
    hosts_json=$(jq -cn --argjson rows "$hosts_json" --argjson row "$(host_record "$host" "config")" '$rows + [$row]')
  done < <(hosts)

  while IFS= read -r host; do
    [[ -n ${config_hosts[$host]:-} ]] && continue
    known_json=$(jq -cn --argjson rows "$known_json" --argjson row "$(host_record "$host" "known_hosts")" '$rows + [$row]')
  done < <(known_hosts)

  if [[ -f $HISTORY_FILE ]]; then
    history_json=$(jq -Rsc 'split("\n") | map(select(length > 0))' "$HISTORY_FILE")
  fi

  active_json=$(active_connections | jq -sc '.')
  jq -cn --argjson hosts "$hosts_json" --argjson known "$known_json" --argjson history "$history_json" --argjson active "$active_json" \
    '{hosts:$hosts,known:$known,history:$history,active:$active}'
}

forget_host() {
  local host=$1
  valid_host "$host" || return 1
  mkdir -p "$STATE_DIR"
  ssh-keygen -R "$host" >/dev/null 2>&1 || true
  if [[ -f $HISTORY_FILE ]]; then
    awk -v host="$host" '$0 != host' "$HISTORY_FILE" >"$HISTORY_FILE.tmp"
    mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
  fi
}

case ${1:-} in
  snapshot)
    snapshot
    ;;
  connect)
    host=${2:-}
    valid_host "$host" || {
      printf 'Unknown SSH host: %s\n' "$host" >&2
      exit 2
    }
    record_history "$host"
    exec ssh "$host"
    ;;
  forget)
    host=${2:-}
    forget_host "$host" || {
      printf 'Unknown SSH host: %s\n' "$host" >&2
      exit 2
    }
    ;;
  *)
    printf 'Usage: %s {snapshot|connect <host>|forget <host>}\n' "$0" >&2
    exit 1
    ;;
esac
