
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	# Worktree management moved to shell scripts: wt, wd, wl
	# See ~/dev/tools/dev-tools/bin/{wt,wd,wl}

[pull]
	rebase = true

[init]
	defaultBranch = master

[user]
	name = Kevin
	email = 145733929+quiet-ghost@users.noreply.github.com

[coderabbit]
	machineId = cli/redacted-for-public

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
  pager = delta
  excludesFile = /home/ghost/.gitignore

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  line-numbers = true
  side-by-side = true
  syntax-theme = rose-pine

[merge]
  conflictstyle = zdiff3

[diff]
  colorMoved = default
