{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["node", "bun"]
  },
  "include": [
    "lib/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "tests/**/*.ts"
  ]
}
