  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/**": "allow",
      "~/.dotfiles/**": "allow",
      "~/Code/**": "allow",
      "~/.plannotator/**": "allow",
      "~/.local/share/opencode/mcp-auth.json": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "secrets/*": "deny",
      ".dev.vars": "ask",
      "~/.local/share/opencode/mcp-auth.json": "deny"
    },
    "bash": {
      "*": "ask",
      "ast-grep *": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "biome *": "allow",
      "bun *": "allow",
      "cargo *": "allow",
      "cat *": "allow",
      "cloc *": "allow",
      "cp *": "allow",
      "date *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "doggo *": "allow",
      "dot *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "fd *": "allow",
      "file *": "allow",
      "find *": "allow",
      "fnm *": "allow",
      "fzf *": "allow",
      "gh *": "allow",
      "gh * approve*": "ask",
      "gh * close*": "ask",
      "gh * comment*": "ask",
      "gh * create*": "ask",
      "gh * delete*": "ask",
      "gh * edit*": "ask",
      "gh * merge*": "ask",
      "gh * reopen*": "ask",
      "gh * review*": "ask",
      "gh repo clone*": "allow",
      "git *": "allow",
      "git push*": "ask",
      "glab *": "allow",
      "glab * approve*": "ask",
      "glab * close*": "ask",
      "glab * comment*": "ask",
      "glab * create*": "ask",
      "glab * delete*": "ask",
      "glab * edit*": "ask",
      "glab * merge*": "ask",
      "glab * reopen*": "ask",
      "glab * review*": "ask",
      "glab repo clone*": "allow",
      "go *": "allow",
      "grep *": "allow",
      "gsed *": "allow",
      "gunzip *": "allow",
      "gzip *": "allow",
      "head *": "allow",
      "hostname": "allow",
      "id": "allow",
      "jj *": "allow",
      "jj git push*": "ask",
      "jj gp*": "ask",
      "jq *": "allow",
      "ls *": "allow",
      "make *": "allow",
      "mkdir *": "allow",
      "mv *": "allow",
      "npm *": "allow",
      "open *": "allow",
      "pbcopy": "allow",
      "pbpaste": "allow",
      "pnpm *": "allow",
      "prettier *": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "shellcheck *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "stow *": "allow",
      "stylua *": "allow",
      "tail *": "allow",
      "tar *": "allow",
      "tee *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "true": "allow",
      "tsc *": "allow",
      "turbo *": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "unzip *": "allow",
      "vite *": "allow",
      "vitest *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs *": "ask",
      "yarn *": "allow",
      "z *": "allow",
      "zip *": "allow",
      "zoxide *": "allow"
    },
    "edit": "allow",
    "webfetch": "ask"
  },
  "plugins": [
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ]
      }
    },
    "opencode-mobile-notifications"
  ],
  "mcp": {
    "servers": {
      "backstage": {
        "type": "remote",
        "url": "https://backstage.mcp.cfdata.org/mcp",
        "disabled": true
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
        "disabled": true
      },
      "elasticsearch": {
        "type": "remote",
        "url": "https://elasticsearch.mcp.cfdata.org/mcp",
        "disabled": true
      },
      "gitlab": {
        "type": "remote",
        "url": "https://gitlab.mcp.cfdata.org/mcp",
        "disabled": true
      },
      "townlake": {
        "type": "remote",
        "url": "https://mcp.townlake.cfdata.org/mcp",
        "disabled": true
      },
      "wiki": {
        "type": "remote",
        "url": "https://wiki.mcp.cfdata.org/mcp",
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "opensrc": {
        "type": "local",
        "command": ["npx", "-y", "opensrc-mcp"],
        "disabled": false
      },
      "overseer": {
        "type": "local",
        "command": ["npx", "-y", "@dmmulroy/overseer", "mcp"],
        "disabled": true
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": false,
        "oauth": {}
      },
      "github": {
        "type": "local",
        "command": [
          "/bin/sh",
          "-c",
          "GITHUB_PERSONAL_ACCESS_TOKEN=$(/home/ghost/.local/bin/gh auth token --hostname github.com) || exit; export GITHUB_PERSONAL_ACCESS_TOKEN; exec /home/ghost/.local/share/mise/installs/github-github-github-mcp-server/latest/github-mcp-server stdio"
        ],
        "disabled": false
      },
      "planetscale": {
        "type": "remote",
        "url": "https://mcp.pscale.dev/mcp/planetscale",
        "disabled": false,
        "oauth": {}
      },
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com",
        "disabled": false,
        "oauth": {}
      }
    }
  },
  "websearch": {
    "provider": "random"
  }
}
