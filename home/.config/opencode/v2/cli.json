{
  "theme": {
    "name": "rosepine",
    "mode": "system"
  },
  "plugins": [
    "-caveman-tui",
    "./plugins/tui/caveman.tsx"
  ],
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "diffs": {
    "wrap": "word",
    "view": "split"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "enabled": false
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": true
  }
}
