{
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "plugins": [
    "./plugins/tui/caveman.tsx",
    "./plugins/tui/herdr.ts"
  ],
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "diffs": {
    "wrap": "word",
    "view": "split"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "enabled": false
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false
  },
  "tabs": {
    "layout": "vertical",
    "scope": "cwd",
    "enabled": true
  }
}
