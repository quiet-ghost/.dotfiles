# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
cursor-color = #ffffff
cursor-text = #191724

# Font
font-family = "CaskaydiaMono Nerd Font"
font-size = 14
font-feature = +calt

# Window — tight padding so herdr/tmux fill the surface
window-padding-x = 0
window-padding-y = 0
confirm-close-surface=false
resize-overlay = never
copy-on-select = clipboard

# Cursor stlying
cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor

# Auto-launch tms session on startup
# command = zsh -c "tmux has-session -t quietghost 2>/dev/null && tmux attach-session -t quietghost || { tmux new-session -s quietghost -d ; tmux send-keys -t quietghost:1 'opencode' Enter ; tmux new-window -n terminal ; tmux new-session -d -s notes -c '$HOME/personal/Notes/Import' 'nvim .' ; tmux attach-session -t quietghost:2; }"

# Keyboard bindings
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u

# Font zoom controls for Programmer layout
# Use both layout-aware and physical-key forms for reliability.
keybind = ctrl+equal=decrease_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+digit_5=decrease_font_size:1

# Zoom in: '+' is on comma in Programmer layout.
keybind = ctrl+comma=increase_font_size:1
keybind = ctrl+shift+comma=increase_font_size:1
keybind = ctrl+plus=increase_font_size:1

# Physical-key fallbacks in case layout translation differs.
keybind = ctrl+Comma=increase_font_size:1
keybind = ctrl+shift+Comma=increase_font_size:1
keybind = ctrl+Period=increase_font_size:1

keybind = ctrl+kp_add=increase_font_size:1
keybind = ctrl+kp_subtract=decrease_font_size:1
keybind = ctrl+backslash=reset_font_size
keybind = ctrl+digit_0=reset_font_size

keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
