{
  "version": 1,
  "idle": {
    "screensaver": 900,
    "lock": 902
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "ghost.workspaces"
        }
      ],
      "center": [
        {
          "id": "ghost.indicators"
        },
        {
          "id": "tmn73.calendar",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "showYearProgress": false
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "local.timer"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "ghost.ai-usage",
          "refreshIntervalSec": 300,
          "defaultView": "subs",
          "assignments": {
            "codex": "subs",
            "grok": "subs",
            "claude": "subs",
            "opencode": "subs",
            "openai-api": "apis",
            "xai-api": "apis",
            "claude-api": "apis",
            "openrouter": "apis"
          }
        },
        {
          "id": "ghost.opencode-service",
          "pollIntervalSec": 5,
          "openExpanded": false
        },
        {
          "id": "mdick.cloudflare"
        },
        {
          "id": "djjeane.docker-monitor"
        },
        {
          "id": "local.ssh"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "stappmus.activity-monitor",
          "openExpanded": false,
          "samplingSpeed": "Efficient"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "ghost.govee"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "local.youtube-music"
    }
  ]
}
