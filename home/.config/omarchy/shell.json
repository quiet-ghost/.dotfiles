{
  "version": 1,
  "idle": {
    "screensaver": 900,
    "lock": 902
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "ghost.workspaces"
        }
      ],
      "center": [
        {
          "id": "ghost.indicators"
        },
        {
          "id": "tmn73.calendar",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "showYearProgress": false
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "local.timer"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "ghost.ai-usage"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "local.ssh"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "djjeane.docker-monitor"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "stappmus.activity-monitor",
          "openExpanded": false,
          "samplingSpeed": "Efficient"
        },
        {
          "id": "ghost.govee"
        }
      ]
    }
  },
  "plugins": []
}
