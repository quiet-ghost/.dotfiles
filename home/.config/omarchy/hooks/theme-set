#!/bin/bash

# ~/.local/bin/omarchy-theme-set-browser prevents Omarchy from recreating the
# managed BrowserThemeColor policy that overrides browser extension themes.
helium-browser --refresh-platform-policy --no-startup-window >/dev/null 2>&1 || true
chromium --refresh-platform-policy --no-startup-window >/dev/null 2>&1 || true
