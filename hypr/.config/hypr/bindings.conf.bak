# Application bindings
$terminal = uwsm app -- $TERMINAL
$browser = omarchy-launch-browser

bind = SUPER, C, killactive,
bindd = SUPER, return, Terminal, exec, $terminal --dir=$(omarchy-cmd-terminal-cwd)
# bindd = SUPER SHIFT, E, File manager, exec, uwsm app -- nautilus --new-window
bindd = SUPER SHIFT, E, File manager, exec, uwsm app -- thunar "$(omarchy-cmd-terminal-cwd)"
bindd = SUPER, E, File manager, exec, $terminal --title="yazi" -e yazi
bindd = SUPER, B, Browser, exec, $browser
bindd = SUPER SHIFT, B, Browser (private), exec, $browser --private
bindd = SUPER, N, Editor, exec, omarchy-launch-editor
bindd = SUPER, D, Docker, exec, omarchy-launch-tui lazydocker
bindd = SUPER SHIFT, S, Signal, exec, omarchy-launch-or-focus signal "uwsm app -- signal-desktop"
unbind = SUPER, O
bindd = SUPER, O, Pop window out (float & pin), exec, omarchy-hyprland-window-pop
bindd = SUPER, slash, Passwords, exec, uwsm app -- 1password
bindd = ALT, SPACE, Launch apps, exec, walker -p "Start…"
bindd = ALT, P, Screenshot of region, exec, omarchy-cmd-screenshot
bindd = SUPER CTRL, R, Screen record a region, exec, omarchy-cmd-screenrecord output
bindd = SUPER SHIFT, R, Screen record (toggle), exec, omarchy-cmd-screenrecord output --with-audio
bindd = SUPER ALT, F, Force full screen, fullscreen, 0
bindd = SUPER, F, Full width, fullscreen, 1
bindd = SUPER SHIFT, K, Show key bindings, exec, omarchy-menu-keybindings
unbind = SUPER SHIFT, SPACE
bindd = SUPER SHIFT, SPACE, Omarchy menu, exec, omarchy-menu
unbind = SUPER, K
bind = SUPER, K, exec, $terminal --title="Process Killer" --confirm-close-surface=false -e $HOME/.dotfiles/bin/usr/bin/kill-process
unbind = ALT, PRINT
bindd = SUPER CTRL, V, Clipboard manager, exec, omarchy-launch-walker -m clipboard

# If your web app url contains #, type it as ## to prevent hyperland treat it as comments
# bindd = SUPER, H, ChatGPT, exec, omarchy-launch-webapp "https://chatgpt.com"
# bindd = SUPER, G, Grok, exec, omarchy-launch-webapp "https://grok.com"
# bindd = SUPER, Y, YouTube, exec, omarchy-launch-webapp "https://youtube.com/"
# bindd = SUPER, X, X, exec, omarchy-launch-webapp "https://x.com/"
# bindd = SUPER, T, Monkeytype, exec, omarchy-launch-webapp "https://monkeytype.com/"

# Workspace Switching - keyd [alt] layer sends numbers 1-0
# Clear default SUPER+number bindings
unbind = SUPER, 1
unbind = SUPER, 2
unbind = SUPER, 3
unbind = SUPER, 4
unbind = SUPER, 5
unbind = SUPER, 6
unbind = SUPER, 7
unbind = SUPER, 8
unbind = SUPER, 9
unbind = SUPER, 0

# Switch workspaces with ALT + 1-0 (keyd alt layer sends numbers)
bind = ALT, 1, workspace, 1
bind = ALT, 2, workspace, 2
bind = ALT, 3, workspace, 3
bind = ALT, 4, workspace, 4
bind = ALT, 5, workspace, 5
bind = ALT, 6, workspace, 6
bind = ALT, 7, workspace, 7
bind = ALT, 8, workspace, 8
bind = ALT, 9, workspace, 9
bind = ALT, 0, workspace, 10

# Move windows to workspaces with ALT + SHIFT + 1-0
unbind = SUPER SHIFT, 1
unbind = SUPER SHIFT, 2
unbind = SUPER SHIFT, 3
unbind = SUPER SHIFT, 4
unbind = SUPER SHIFT, 5
unbind = SUPER SHIFT, 6
unbind = SUPER SHIFT, 7
unbind = SUPER SHIFT, 8
unbind = SUPER SHIFT, 9
unbind = SUPER SHIFT, 0

bind = ALT SHIFT, 1, movetoworkspace, 1
bind = ALT SHIFT, 2, movetoworkspace, 2
bind = ALT SHIFT, 3, movetoworkspace, 3
bind = ALT SHIFT, 4, movetoworkspace, 4
bind = ALT SHIFT, 5, movetoworkspace, 5
bind = ALT SHIFT, 6, movetoworkspace, 6
bind = ALT SHIFT, 7, movetoworkspace, 7
bind = ALT SHIFT, 8, movetoworkspace, 8
bind = ALT SHIFT, 9, movetoworkspace, 9
bind = ALT SHIFT, 0, movetoworkspace, 10

# Overwrite existing bindings, like putting Omarchy Menu on Super + Space
# unbind = SUPER, Space
# bindd = SUPER, SPACE, Omarchy menu, exec, omarchy-menu

unbind = SUPER, W
unbind = SUPER, SPACE
unbind = SUPER ALT, SPACE
