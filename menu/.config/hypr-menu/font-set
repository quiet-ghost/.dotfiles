#!/bin/bash

# Font management script - improved version
# Lists all font variants with weights and applies selection system-wide

# List all monospace fonts with their full names including weight/style
FONTS=$(fc-list :spacing=100 -f "%{family[0]} %{style[0]}\n" | \
        grep -v -i -E 'emoji|signwriting|symbols|icon' | \
        sed 's/,Regular$//' | \
        sed 's/,.*:style=/:/' | \
        sort -u)

# Get current font from ghostty config for comparison
CURRENT_FONT=$(grep "^font-family" "$HOME/.config/ghostty/config" 2>/dev/null | sed 's/font-family = //')

# Add indicator for current font
FONT_LIST=""
while IFS= read -r font; do
  if [[ "$font" == "$CURRENT_FONT" ]]; then
    FONT_LIST+=" $font [current]\n"
  else
    FONT_LIST+=" $font\n"
  fi
done <<< "$FONTS"

# Use walker to select font
SELECTED=$(echo -e "${FONT_LIST%\\n}" | walker --dmenu --theme omarchy-catppuccin --placeholder " Select Font")

# Extract font name (remove icon and [current] if present)
SELECTED_FONT=$(echo "$SELECTED" | sed 's/^[  ]*//' | sed 's/ \[current\]$//')

if [[ -n "$SELECTED_FONT" && "$SELECTED_FONT" != "CNCLD" ]]; then
  # Verify font exists
  if fc-list | grep -F "$SELECTED_FONT" >/dev/null 2>&1; then
    echo "Setting font to: $SELECTED_FONT"
    
    # Escape special characters for sed
    ESCAPED_FONT=$(printf '%s\n' "$SELECTED_FONT" | sed 's/[[\.*^$()+?{|]/\\&/g')
    
    # Update walker themes
    for theme in "$HOME"/.config/walker/themes/*.css; do
      sed -i "s/font-family: .*/font-family: \"$ESCAPED_FONT\", monospace;/g" "$theme"
    done
    
    # Update ghostty config
    if [[ -f "$HOME/.config/ghostty/config" ]]; then
      sed -i "s/^font-family = .*/font-family = $SELECTED_FONT/g" "$HOME/.config/ghostty/config"
      # Send reload signal to ghostty
      pkill -USR1 ghostty 2>/dev/null || true
    fi
    
    # Update wezterm config (lua format)
    if [[ -f "$HOME/.config/wezterm/wezterm.lua" ]]; then
      sed -i "s/font = wezterm.font.*/font = wezterm.font(\"$ESCAPED_FONT\"),/g" "$HOME/.config/wezterm/wezterm.lua"
    fi
    
    # Update fontconfig for system-wide monospace font
    mkdir -p "$HOME/.config/fontconfig"
    cat > "$HOME/.config/fontconfig/fonts.conf" <<EOF
<?xml version='1.0'?>
<!DOCTYPE fontconfig SYSTEM 'fonts.dtd'>
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend" binding="strong">
      <string>$SELECTED_FONT</string>
    </edit>
  </match>
</fontconfig>
EOF
    
    # Reload font cache
    fc-cache -f
    
    # Notify success but don't exit
    notify-send "Font Changed" "System font set to: $SELECTED_FONT" -t 3000 2>/dev/null || echo "✓ Font set to: $SELECTED_FONT"
    
    # Return to style menu
    exec "$HOME/.local/bin/arch-menu" style
  else
    echo "Error: Font '$SELECTED_FONT' not found."
    sleep 2
    exec "$HOME/.local/bin/arch-menu" style
  fi
else
  # User cancelled, return to style menu
  exec "$HOME/.local/bin/arch-menu" style
fi