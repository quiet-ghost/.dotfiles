\n\
  Lock: Super + Shift + L\n\
󰈆  Exit: Super + Shift + [\n\
  Tab Switcher: Super + Tab\n\
  Screenshot: Super + S"

  echo -e "$keybinds" | walker --dmenu --placeholder "Keybindings"
  show_main_menu
}

# Main execution
if [[ $# -eq 0 ]]; then
  show_main_menu
else
  case "$1" in
    install) show_install_menu ;;
    remove) show_remove_menu ;;
    update) show_update_menu ;;
    style) show_style_menu ;;
    system) show_system_menu ;;
    *) show_main_menu ;;
  esac
fi