# Show system submenu
show_system_menu() {
	local choice
	choice=$(menu "System" "  Lock\n󱄄  Screensaver\n󰤄  Suspend\n  Restart Hyprland\n󰜉  Reboot\n󰐥  Shutdown")

	case "$choice" in
	*Lock*) hyprlock ;;
	*Screensaver*) hyprlock ;;
	*Suspend*) systemctl suspend ;;
	*Restart*Hyprland*) hyprctl dispatch exit ;;
	*Reboot*) systemctl reboot ;;
	*Shutdown*) systemctl poweroff ;;
	*) show_main_menu ;;
	esac
}

# Show performance profile menu
show_performance_menu() {
	# Get current power profile
	local current_profile=""
	if command -v powerprofilesctl &>/dev/null; then
		current_profile=$(powerprofilesctl get 2>/dev/null || echo "unknown")
	else
		current_profile="unknown"
	fi

	# Format current profile for display
	local profile_display=""
	case "$current_profile" in
	performance) profile_display="Performance" ;;
	balanced) profile_display="Balanced" ;;
	power-saver) profile_display="Power Save" ;;
	*) profile_display="Unknown" ;;
	esac

	# Show menu with current profile highlighted
	local choice
	choice=$(menu "Performance Profile (Current: $profile_display)" \
		"󱐋  Performance Mode\n󰗑  Balanced Mode\n󰾆  Power Save Mode\n󰊈  View Current Status")

	case "$choice" in
	*Performance*Mode*)
		if [[ -x "$HOME/.config/hypr/scripts/performance.sh" ]]; then
			$HOME/.config/hypr/scripts/performance.sh
		else
			notify-send "Error" "Performance script not found or not executable"
		fi
		;;
	*Balanced*Mode*)
		if [[ -x "$HOME/.config/hypr/scripts/balanced.sh" ]]; then
			$HOME/.config/hypr/scripts/balanced.sh
		else
			notify-send "Error" "Balanced script not found or not executable"
		fi
		;;
	*Power*Save*Mode*)
		if [[ -x "$HOME/.config/hypr/scripts/powersave.sh" ]]; then
			$HOME/.config/hypr/scripts/powersave.sh
		else
			notify-send "Error" "Power save script not found or not executable"
		fi
		;;
	*View*Current*Status*)
		show_performance_status
		;;
	*) show_main_menu ;;
	esac
}

# Show detailed performance status
show_performance_status() {
	local status_info="󱐋  Performance Status\n\n"

	# Get power profile
	if command -v powerprofilesctl &>/dev/null; then
		local profile=$(powerprofilesctl get 2>/dev/null || echo "unknown")
		status_info+="Power Profile: $profile\n"
	fi

	# Get CPU governor if available
	if [[ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]]; then
		local governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
		status_info+="CPU Governor: $governor\n"
	fi

	# Get CPU frequency info
	if command -v cpupower &>/dev/null; then
		local freq_info=$(cpupower frequency-info 2>/dev/null | grep "current CPU frequency" | head -1)
		if [[ -n "$freq_info" ]]; then
			status_info+="$freq_info\n"
		fi
	fi

	# Get thermal info if available
	if [[ -f /sys/class/thermal/thermal_zone0/temp ]]; then
		local temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
		if [[ -n "$temp" ]]; then
			local temp_c=$((temp / 1000))
			status_info+="CPU Temperature: ${temp_c}°C\n"
		fi
	fi

	echo -e "$status_info" | walker --dmenu --theme dmenu-centered --placeholder "Performance Status"
	show_performance_menu
}

# Main execution
if [[ $# -eq 0 ]]; then
	show_main_menu
else
	case "$1" in
	install) show_install_menu ;;
	remove) show_remove_menu ;;
	update) show_update_menu ;;
	style) show_style_menu ;;
	system) show_system_menu ;;
	performance) show_performance_menu ;;
	*) show_main_menu ;;
	esac
fi
