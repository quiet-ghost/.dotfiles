#!/bin/bash

# TUI App Remover for Arch Linux Menu System

DESKTOP_DIR="$HOME/.local/share/applications"
ICON_DIR="$DESKTOP_DIR/icons"

# Find all TUI apps (those using ghostty)
tui_apps=$(grep -l "ghostty.*class.*TUI" "$DESKTOP_DIR"/*.desktop 2>/dev/null | xargs -I {} basename {} .desktop | fzf --multi --prompt="Select TUI apps to remove> ")

if [[ -n "$tui_apps" ]]; then
  echo "$tui_apps" | while read -r app; do
    rm -f "$DESKTOP_DIR/$app.desktop"
    rm -f "$ICON_DIR/$app.png"
    echo "Removed: $app"
  done
  echo -e "\n✓ TUI apps removed successfully!"
  read -n 1 -s -p "Press any key to close..."
fi
