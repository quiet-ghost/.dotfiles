#!/bin/bash

# Theme Removal Script for Hyprland
# Removes installed themes from the themes directory

# Colors for output
BLUE='\033[0;34m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Themes directory
THEMES_DIR="$HOME/.config/hypr/themes"

echo -e "${BLUE}Let's remove an installed Hyprland theme.\n${NC}"

# Check if themes directory exists
if [[ ! -d "$THEMES_DIR" ]]; then
  echo "No themes directory found"
  echo "Nothing to remove"
  exit 0
fi

# Get list of installed themes
INSTALLED_THEMES=$(ls -d "$THEMES_DIR"/*/ 2>/dev/null | xargs -n 1 basename)

if [[ -z "$INSTALLED_THEMES" ]]; then
  echo "No themes installed"
  exit 0
fi

echo "Installed themes:"
echo ""
echo "$INSTALLED_THEMES" | sed 's/^/  • /'
echo ""

# Get theme to remove using gum
THEME_TO_REMOVE=$(gum input --prompt "Theme to remove> " --placeholder "Enter theme name from the list above")

if [[ -z "$THEME_TO_REMOVE" ]]; then
  echo "Removal cancelled"
  exit 0
fi

# Check if theme exists
if [[ ! -d "$THEMES_DIR/$THEME_TO_REMOVE" ]]; then
  echo -e "${RED}Theme not found: $THEME_TO_REMOVE${NC}"
  exit 1
fi

# Confirm removal using gum
echo ""
if gum confirm "Remove theme '$THEME_TO_REMOVE'? This cannot be undone."; then
  # Remove the theme directory
  if rm -rf "$THEMES_DIR/$THEME_TO_REMOVE"; then
    echo ""
    echo -e "${GREEN}✓ Theme removed: $THEME_TO_REMOVE${NC}"
  else
    echo -e "${RED}Failed to remove theme${NC}"
    exit 1
  fi
else
  echo "Removal cancelled"
fi