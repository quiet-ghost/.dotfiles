#!/bin/bash

# Wallpaper management script for hyprpaper
# Lists wallpapers and applies selection without closing

WALLPAPER_DIR="$HOME/.config/backgrounds"
HYPRPAPER_CONF="$HOME/.config/hypr/hyprpaper.conf"

# Create wallpaper directory if it doesn't exist
mkdir -p "$WALLPAPER_DIR"

# Get current wallpaper from hyprpaper config
CURRENT_WALLPAPER=$(grep "^wallpaper" "$HYPRPAPER_CONF" 2>/dev/null | sed 's/.*\///' | sed 's/$//')

# Find all image files (follow symlinks with -L)
WALLPAPERS=$(find -L "$WALLPAPER_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" -o -iname "*.webp" \) -printf "%f\n" | sort)

if [[ -z "$WALLPAPERS" ]]; then
  notify-send "No Wallpapers" "No wallpapers found in $WALLPAPER_DIR" -t 3000
  echo "No wallpapers found in $WALLPAPER_DIR"
  echo "Add images to this directory and try again."
  sleep 3
  exec "$HOME/.local/bin/arch-menu" style
fi

# Add indicator for current wallpaper
WALLPAPER_LIST=""
while IFS= read -r wp; do
  if [[ "$wp" == "$CURRENT_WALLPAPER" ]]; then
    WALLPAPER_LIST+=" $wp [current]\n"
  else
    WALLPAPER_LIST+=" $wp\n"
  fi
done <<< "$WALLPAPERS"

# Use walker to select wallpaper
SELECTED=$(echo -e "${WALLPAPER_LIST%\\n}" | walker --dmenu --theme omarchy-catppuccin --placeholder " Select Wallpaper")

# Extract wallpaper name (remove icon and [current] if present)
SELECTED_WP=$(echo "$SELECTED" | sed 's/^[  ]*//' | sed 's/ \[current\]$//')

if [[ -n "$SELECTED_WP" && "$SELECTED_WP" != "CNCLD" ]]; then
  WALLPAPER_PATH="$WALLPAPER_DIR/$SELECTED_WP"
  
  if [[ -f "$WALLPAPER_PATH" ]]; then
    echo "Setting wallpaper to: $SELECTED_WP"
    
    # Update hyprpaper config
    cat > "$HYPRPAPER_CONF" <<EOF
preload = $WALLPAPER_PATH
wallpaper = ,$WALLPAPER_PATH
EOF
    
    # Reload hyprpaper
    pkill hyprpaper
    sleep 0.5
    hyprpaper &>/dev/null &
    
    # Notify success
    notify-send "Wallpaper Changed" "Set to: $SELECTED_WP" -t 3000 2>/dev/null || echo "✓ Wallpaper set to: $SELECTED_WP"
    
    # Return to style menu
    exec "$HOME/.local/bin/arch-menu" style
  else
    echo "Error: Wallpaper file not found: $WALLPAPER_PATH"
    sleep 2
    exec "$HOME/.local/bin/arch-menu" style
  fi
else
  # User cancelled, return to style menu
  exec "$HOME/.local/bin/arch-menu" style
fi