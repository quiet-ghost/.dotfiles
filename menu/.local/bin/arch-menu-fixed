#!/bin/bash

# Arch Linux Menu System with proper spacing
# Uses walker for menus and ghostty for presentations

export PATH="$HOME/.local/bin:$PATH"

# Menu wrapper using walker (uses default theme from config)
menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"

  echo -e "$options" | walker --dmenu --placeholder "$prompt" $extra
}

# Terminal wrapper using ghostty
terminal() {
  ghostty --title="ArchMenu" -e "$@"
}

# Presentation terminal with branding
present_terminal() {
  local cmd="$1"
  ghostty --title="ArchMenu" -e bash -c "
    echo -e '\033[34m󰣇 Arch Linux Menu\033[0m\n'
    $cmd
    echo -e '\n\033[32m✓ Done! Press any key to close...\033[0m'
    read -n 1 -s
  "
}

# Show main menu - with proper spacing (2 spaces after icons)
show_main_menu() {
  local choice
  choice=$(menu "Arch Menu" "󰣇  Install\n󰭌  Remove\n  Update\n  Style\n  System\n  Keybindings")

  case "$choice" in
    *Install*) show_install_menu ;;
    *Remove*) show_remove_menu ;;
    *Update*) show_update_menu ;;
    *Style*) show_style_menu ;;
    *System*) show_system_menu ;;
    *Keybindings*) show_keybindings ;;
    *) exit 0 ;;
  esac
}

# Show install submenu - with proper spacing
show_install_menu() {
  local choice
  choice=$(menu "Install" "󰣇  Packages\n󰣇  AUR\n  Web App\n  TUI\n󰸌  Theme")

  case "$choice" in
    *Packages*) terminal "$HOME/.config/hypr-menu/pkg-install" ;;
    *AUR*) terminal "$HOME/.config/hypr-menu/aur-install" ;;
    *Web*) terminal "$HOME/.config/hypr-menu/webapp-install" ;;
    *TUI*) terminal "$HOME/.config/hypr-menu/tui-install" ;;
    *Theme*) show_theme_menu ;;
    *) show_main_menu ;;
  esac
}

# Show remove submenu - with proper spacing
show_remove_menu() {
  local choice
  choice=$(menu "Remove" "󰣇  Package\n  Web App\n  TUI\n󰸌  Theme")

  case "$choice" in
    *Package*) terminal "$HOME/.config/hypr-menu/pkg-remove" ;;
    *Web*) terminal "$HOME/.config/hypr-menu/webapp-remove" ;;
    *TUI*) terminal "$HOME/.config/hypr-menu/tui-remove" ;;
    *Theme*) terminal "$HOME/.config/hypr-menu/theme-remove" ;;
    *) show_main_menu ;;
  esac
}

# Show update submenu - with proper spacing
show_update_menu() {
  local choice
  choice=$(menu "Update" "  System\n  Config\n󰸌  Themes")

  case "$choice" in
    *System*) present_terminal "sudo pacman -Syu --noconfirm" ;;
    *Config*) present_terminal "$HOME/.config/hypr-menu/refresh-config" ;;
    *Themes*) present_terminal "$HOME/.config/hypr-menu/theme-update" ;;
    *) show_main_menu ;;
  esac
}

# Show style submenu - with proper spacing
show_style_menu() {
  local choice
  choice=$(menu "Style" "󰸌  Theme\n  Wallpaper\n  Font")

  case "$choice" in
    *Theme*) "$HOME/.config/hypr-menu/theme-set" ;;
    *Wallpaper*) "$HOME/.config/hypr-menu/wallpaper-set" ;;
    *Font*) "$HOME/.config/hypr-menu/font-set" ;;
    *) show_main_menu ;;
  esac
}

# Show theme submenu (placeholder for now)
show_theme_menu() {
  terminal "$HOME/.config/hypr-menu/theme-set"
  show_install_menu
}

# Show system submenu - with proper spacing
show_system_menu() {
  local choice
  choice=$(menu "System" "  Lock\n󰤄  Suspend\n  Restart\n󰐥  Shutdown")

  case "$choice" in
    *Lock*) hyprlock ;;
    *Suspend*) systemctl suspend ;;
    *Restart*) systemctl reboot ;;
    *Shutdown*) systemctl poweroff ;;
    *) show_main_menu ;;
  esac
}

# Show keybindings - formatted with proper spacing
show_keybindings() {
  local keybinds="󰌌  Keybindings
  
  Terminal: Super + Return
  Kill Window: Super + C
󰈆  Exit Hyprland: Super + Shift + E
  File Manager: Super + E
  Floating Toggle: Super + V
  App Launcher: Alt + Space
  Pseudo Tiling: Super + P
  Toggle Split: Super + Shift + J
  Fullscreen: Super + F
  Screenshot: Alt + P
  AUR Install: Super + A
  Kill Process: Super + K
  Arch Menu: Super + Shift + Space

  Workspaces 1-6: Alt + 1-6
  Move to Workspace: Super + Shift + 1-6
  Special Workspace: Super + `
  Show Scratchpad: Super + S

  Focus: Super + H/J/K/L
  Move: Super + Shift + H/J/K/L
  Resize: Super + Ctrl + H/J/K/L

󱐋  Performance: Super + Alt + P
  Balanced: Super + Alt + B
󰾆  Power Save: Super + Alt + S

  Volume Up: XF86AudioRaiseVolume
  Volume Down: XF86AudioLowerVolume
  Mute: XF86AudioMute
  Brightness Up: XF86MonBrightnessUp
  Brightness Down: XF86MonBrightnessDown

  Next Track: XF86AudioNext
  Play/Pause: XF86AudioPlay
  Previous Track: XF86AudioPrev

  Lock: Super + Shift + L
󰈆  Exit: Super + Shift + [
  Tab Switcher: Super + Tab
  Screenshot: Super + S"

  echo -e "$keybinds" | walker --dmenu --placeholder "Keybindings"
  show_main_menu
}

# Main execution
if [[ $# -eq 0 ]]; then
  show_main_menu
else
  case "$1" in
    install) show_install_menu ;;
    remove) show_remove_menu ;;
    update) show_update_menu ;;
    style) show_style_menu ;;
    system) show_system_menu ;;
    *) show_main_menu ;;
  esac
fi