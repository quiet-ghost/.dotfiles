[Unit]
Description=Hypridle with custom launcher (desktop/laptop detection)
Documentation=https://wiki.hyprland.org/Hypr-Ecosystem/hypridle
# Optional backup path. Prefer Omarchy uwsm-app -- hypridle + PATH wrapper.
# Keep disabled unless autostart path fails.
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/.local/bin/hypridle-launcher

[Service]
Type=simple
ExecStart=%h/.local/bin/hypridle-launcher
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
