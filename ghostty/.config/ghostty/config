# Dynamic theme colors
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# Font
font-family = "CaskaydiaMono Nerd Font"
font-size = 15

# Window
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never

# Cursor stlying
cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor

# Auto-launch tms session on startup
# command = zsh -c "tmux has-session -t quietghost 2>/dev/null && tmux attach-session -t quietghost || { tmux new-session -s quietghost -d ; tmux send-keys -t quietghost:1 'opencode' Enter ; tmux new-window -n terminal ; tmux new-session -d -s notes -c '$HOME/personal/Notes/Import' 'nvim .' ; tmux attach-session -t quietghost:2; }"

# Keyboard bindings
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
