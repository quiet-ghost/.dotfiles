set-option -sa terminal-overrides ',xterm*:Tc'
set -g mouse on
set-option -g status-position top
set-option -g xterm-keys on
set-option -g extended-keys on
set-environment -g PATH "~/.npm-global/bin:/usr/local/bin:/usr/bin"

unbind r
bind r source-file ~/.config/tmux/tmux.conf \; display "Reloaded tmux.conf"
set -g base-index 1

#Windows and Panes index
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

#Set Prefix
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

#Opencode
bind-key -n M-o run-shell '~/.config/tmux/scripts/opencode-session.sh "#{pane_current_path}"'
bind-key -n M-d if-shell 'tmux display-message -p "#{session_name}" | grep -qE "^(opencode-|notes$)"' 'detach-client' 'display-message "Not in opencode or notes session"'

#Kill pane

# Update status bar every 1 second to show SSH status
set -g status-interval 1

# Process killer popup (Alt+K) - compact size to fit content
bind-key -n M-K popup -E -w 60% -h 50% "~/.dotfiles/tmux/.config/tmux/scripts/kill-process.sh"

# Notes popup (Alt+N)
bind-key -n M-N popup -E -w 90% -h 90% "~/.config/tmux/scripts/notes-popup.sh"



# Session switcher popup with fzf (backup)
bind s popup -E -w 90% -h 90% "tmux list-sessions | fzf | cut -d: -f1 | xargs tmux switch-client -t"

# Alt to switch windows (multiple formats for compatibility)
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5

# Alternative Alt bindings for terminals that send escape sequences
bind -n 'M-!' select-window -t 1
bind -n 'M-@' select-window -t 2
bind -n 'M-#' select-window -t 3
bind -n 'M-$' select-window -t 4
bind -n 'M-%' select-window -t 5
bind -n 'M-^' select-window -t 6
bind -n 'M-&' select-window -t 7
bind -n 'M-*' select-window -t 8
bind -n 'M-(' select-window -t 9
bind -n 'M-)' select-window -t 0


# Smart pane switching with awareness of Vim splits.
vim_pattern='(\\S+/)?(g?\\.?)?(view|l?n?vim?x?|fzf|tui-.*)(diff)?(-wrapped)?'
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \\
    | grep -iqE '^[^TXZ ]+ +${vim_pattern}$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'

# Quick detach and kill session
bind q detach-client
bind Q kill-session

#Plugins
set -g @catppuccin_flavour 'mocha'

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'dreamsofcode-io/catppuccin-tmux'
set -g @plugin 'tmux-plugins/tmux-yank'

#Copy mode
set-window-option -g mode-keys vi
bind-key -T copy-mode-vi 'v' send -X begin-selection
bind-key -T copy-mode-vi 'y' send -X copy-selection-and-cancel
bind-key -T copy-mode-vi 'C-v' send -X rectangle-toggle

bind '-' split-window -v -c "#{pane_current_path}"
bind '|' split-window -h -c "#{pane_current_path}"

run '~/.tmux/plugins/tpm/tpm'

# Override catppuccin's status-right to include SSH detection with icons
set -g status-right "#[fg=#f5c2e7,bg=#1e1e2e,nobold,nounderscore,noitalics]█#[fg=#1e1e2e,bg=#f5c2e7,nobold,nounderscore,noitalics] #[fg=#cdd6f4,bg=#313244] #W #{?client_prefix,#[fg=#f38ba8],#[fg=#a6e3a1]}#[bg=#313244]█#{?client_prefix,#[bg=#f38ba8],#[bg=#a6e3a1]}#[fg=#1e1e2e] #[fg=#cdd6f4,bg=#313244] #S #(~/.config/tmux/scripts/ssh-status.sh) "
set -g status-right-length 150

# Enable italics support
set -g default-terminal 'tmux-256color'
set -as terminal-overrides ',xterm*:sitm=[3m:ritm=[23m'
