{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "default_agent": "plan",
  "mcp": {
    "overseer": {
      "type": "local",
      "command": ["npx", "-y", "@dmmulroy/overseer", "mcp"],
      "enabled": true
    }
  },
  "provider": {
    "cloudflare-ai-gateway": {
      "models": {
        "anthropic/claude-sonnet-4": {},
        "openai/gpt-4o": {},
        "openai/gpt-4.1-mini": {},
        "google-ai-studio/gemini-2.5-pro": {}
      }
    }
  }
}
