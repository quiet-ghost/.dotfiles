#!/usr/bin/env bash

# Unified C++ Project Generator
# Creates Standard C++, Qt, or Web/Backend projects
# 
# Usage: 
#   new-cpp                        - Interactive mode (all prompts)
#   new-cpp <project-name>         - Skip project name prompt
#   new-cpp <project-name> <Main>  - Skip project name and main class prompts
#
# Examples:
#   new-cpp                        - Fully interactive
#   new-cpp my-app                 - Use "my-app" as project name
#   new-cpp my-app MyApp           - Use "my-app" and "MyApp" as main class

set -e

# ============================================================================
# Rose Pine Color Scheme
# ============================================================================
BASE="#191724"
SURFACE="#1f1d2e"
OVERLAY="#26233a"
MUTED="#6e6a86"
SUBTLE="#908caa"
TEXT="#e0def4"
LOVE="#eb6f92"
GOLD="#f6c177"
ROSE="#ebbcba"
PINE="#31748f"
FOAM="#9ccfd8"
IRIS="#c4a7e7"
HIGHLIGHT_LOW="#21202e"
HIGHLIGHT_MED="#403d52"
HIGHLIGHT_HIGH="#524f67"

# ============================================================================
# Utility Functions
# ============================================================================

gum_header() {
    gum style \
        --foreground "$IRIS" \
        --border "rounded" \
        --border-foreground "$PINE" \
        --align "center" \
        --padding "1 4" \
        --margin "1 0" \
        "$@"
}

gum_info() {
    gum style --foreground "$FOAM" "󰙎 $*"
}

gum_success() {
    gum style --foreground "$FOAM" --bold " $*"
}

gum_error() {
    gum style --foreground "$LOVE" --bold " $*"
}

gum_section() {
    gum style --foreground "$GOLD" --bold "$*"
}

validate_project_name() {
    local name="$1"
    [[ "$name" =~ ^[a-z0-9-]+$ ]]
}

validate_class_name() {
    local name="$1"
    [[ "$name" =~ ^[A-Z][a-zA-Z0-9]*$ ]]
}

check_command() {
    if ! command -v "$1" &> /dev/null; then
        gum_error "Error: $1 is not installed"
        [ -n "$2" ] && gum_info "Install with: $2"
        exit 1
    fi
}

# ============================================================================
# Standard C++ Dependency Database
# ============================================================================

CPP_DEPENDENCY_DATABASE=$(cat << 'EOF'
# TESTING
catch2:TESTING | Catch2 - Modern C++ testing framework (header-only, BDD-style)
gtest:TESTING | Google Test - Industry standard unit testing framework
doctest:TESTING | doctest - Lightweight testing framework (fastest compile times)
# LOGGING
spdlog:LOGGING | spdlog - Fast C++ logging library (async support)
log4cplus:LOGGING | log4cplus - C++ port of log4j logging library
# FORMATTING
fmt:FORMATTING | fmt - Fast and safe formatting library (C++20 format)
fmtlog:FORMATTING | fmtlog - Formatting with logging capabilities
# JSON
nlohmann-json:JSON | JSON for Modern C++ - Intuitive JSON library (most popular)
rapidjson:JSON | RapidJSON - Fast JSON parser/generator
simdjson:JSON | simdjson - Extremely fast JSON parser (SIMD optimized)
jsoncpp:JSON | JsonCpp - JSON library with good CMake integration
# CLI
cli11:CLI | CLI11 - Modern command line parser (header-only, Python Click-like)
cxxopts:CLI | cxxopts - Lightweight C++ option parser
argparse:CLI | argparse - Argument parser for C++17/20
# HTTP_CLIENT
cpp-httplib:HTTP_CLIENT | cpp-httplib - Single header HTTP/HTTPS client/server
cpr:HTTP_CLIENT | C++ Requests - libcurl wrapper (Python requests-like)
libcurl:HTTP_CLIENT | libcurl - Multi-protocol file transfer library
# SERIALIZATION
cereal:SERIALIZATION | Cereal - C++11 serialization library (header-only)
protobuf:SERIALIZATION | Protocol Buffers - Google's data interchange format
msgpack-cxx:SERIALIZATION | MessagePack - Efficient binary serialization
boost-serialization:SERIALIZATION | Boost.Serialization - Archive-based serialization
# DATABASE
sqlite3:DATABASE | SQLite3 - Embedded SQL database engine
libpq:DATABASE | PostgreSQL C++ client library
libmysqlclient:DATABASE | MySQL client library for C++
sqlitecpp:DATABASE | SQLiteCpp - Smart C++ wrapper for SQLite3
# UTILITIES
boost:UTILITIES | Boost - Comprehensive C++ libraries collection
range-v3:UTILITIES | range-v3 - Range library for C++14/17/20
abseil:UTILITIES | Abseil - Google's C++ common libraries
eigen:UTILITIES | Eigen - C++ template library for linear algebra
stduuid:UTILITIES | stduuid - UUID library for C++17
date:UTILITIES | date - Howard Hinnant's date/time library
# CRYPTO
openssl:CRYPTO | OpenSSL - Cryptography and SSL/TLS toolkit
botan:CRYPTO | Botan - Crypto and TLS library for C++
libsodium:CRYPTO | libsodium - Modern, easy-to-use crypto library
# COMPRESSION
zlib:COMPRESSION | zlib - General purpose data compression library
bzip2:COMPRESSION | bzip2 - High-quality data compression
lz4:COMPRESSION | LZ4 - Extremely fast compression algorithm
# GRAPHICS
glfw3:GRAPHICS | GLFW - Multi-platform OpenGL library
sdl2:GRAPHICS | SDL2 - Cross-platform multimedia library
glm:GRAPHICS | GLM - OpenGL Mathematics library (header-only)
# ASYNC
asio:ASYNC | Asio - Cross-platform C++ networking library
boost-asio:ASYNC | Boost.Asio - Asynchronous I/O library
libcoro:ASYNC | libcoro - C++20 coroutine library
# MISC
yaml-cpp:MISC | yaml-cpp - YAML parser and emitter for C++
toml11:MISC | toml11 - TOML parser/encoder for C++11/14/17
pugixml:MISC | pugixml - Light-weight C++ XML processing library
imgui:MISC | Dear ImGui - Immediate mode GUI library
EOF
)

# ============================================================================
# Qt Dependency Database
# ============================================================================

QT_DEPENDENCY_DATABASE=$(cat << 'EOF'
# CORE
qt6-base:CORE | Qt6 Core - Essential Qt modules (Core, GUI, Widgets, etc.)
qt6-declarative:CORE | Qt6 QML/Quick - Modern declarative UI framework
# NETWORKING
qt6-websockets:NETWORKING | Qt6 WebSockets - WebSocket protocol implementation
qt6-networkauth:NETWORKING | Qt6 Network Authentication - OAuth support
# DATABASE
qt6-base[sql]:DATABASE | Qt6 SQL - Database integration module
# MULTIMEDIA
qt6-multimedia:MULTIMEDIA | Qt6 Multimedia - Audio, video, camera support
# WEB
qt6-webengine:WEB | Qt6 WebEngine - Chromium-based web browser engine
qt6-webview:WEB | Qt6 WebView - Native platform web view
# GRAPHICS
qt6-svg:GRAPHICS | Qt6 SVG - SVG file rendering
qt6-charts:GRAPHICS | Qt6 Charts - Chart components for data visualization
qt6-3d:GRAPHICS | Qt6 3D - 3D graphics support
# TOOLS
qt6-tools:TOOLS | Qt6 Tools - Qt Designer, Qt Linguist, etc.
qt6-serialport:TOOLS | Qt6 Serial Port - Serial port access
# TESTING
qt6-base[test]:TESTING | Qt6 Test - Unit testing framework for Qt
EOF
)

# ============================================================================
# Web/Backend Framework Database
# ============================================================================

WEB_FRAMEWORK_DATABASE=$(cat << 'EOF'
# FRAMEWORKS
drogon:FRAMEWORK | Drogon - High-performance C++14/17 HTTP framework (ORM, WebSocket, HTTP/2)
crow:FRAMEWORK | Crow - Flask-inspired C++ microframework (header-only, simple)
oatpp:FRAMEWORK | oat++ - Zero-dependency web framework (IoT/Robotics optimized)
# UTILITIES
drogon[orm]:UTILITIES | Drogon ORM - Built-in Object-Relational Mapping
drogon[redis]:UTILITIES | Drogon Redis - Redis client integration
jwt-cpp:UTILITIES | jwt-cpp - JSON Web Token library for C++
bcrypt:UTILITIES | bcrypt - Password hashing library
EOF
)

# ============================================================================
# GUI/Graphics Framework Database
# ============================================================================

GUI_FRAMEWORK_DATABASE=$(cat << 'EOF'
# CORE
sfml:CORE | SFML Core - Window, graphics, audio, network modules
sfml-graphics:CORE | SFML Graphics - 2D rendering, sprites, textures
sfml-audio:CORE | SFML Audio - Sound and music playback
sfml-network:CORE | SFML Network - Sockets, HTTP, FTP
gtkmm-4.0:CORE | gtkmm 4.0 - Modern C++ bindings for GTK4
gtkmm-3.0:CORE | gtkmm 3.0 - C++ bindings for GTK3 (stable)
wxwidgets:CORE | wxWidgets - Cross-platform native GUI toolkit
# UTILITIES
box2d:UTILITIES | Box2D - 2D physics engine for games
tmxlite:UTILITIES | tmxlite - Tiled map loader for SFML
glm:UTILITIES | GLM - OpenGL Mathematics for 3D graphics
imgui:UTILITIES | Dear ImGui - Immediate mode GUI for debugging
EOF
)

# ============================================================================
# Main Script
# ============================================================================

# Show help if requested
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << 'EOF'
󰙲 C++ Project Generator

Usage: 
  new-cpp                        - Interactive mode (all prompts)
  new-cpp <project-name>         - Skip project name prompt
  new-cpp <project-name> <Main>  - Skip project name and main class prompts

Examples:
  new-cpp                        - Fully interactive
  new-cpp my-app                 - Use "my-app" as project name
  new-cpp my-app MyApp           - Use "my-app" and "MyApp" as main class

Options:
  -h, --help                     - Show this help message

EOF
    exit 0
fi

# Parse command-line arguments
ARG_PROJECT_NAME="$1"
ARG_MAIN_CLASS="$2"

# Check dependencies
check_command gum "pacman -S gum or brew install gum"
check_command fzf "pacman -S fzf or brew install fzf"
check_command cmake "pacman -S cmake or brew install cmake"

# Welcome screen
gum_header "󰙲 C++ Project Generator" "Create Standard C++, Qt, or Web/Backend projects"

echo ""

# Project type selection
PROJECT_TYPE=$(gum choose \
    --header.foreground "$GOLD" \
    --cursor.foreground "$IRIS" \
    --selected.foreground "$FOAM" \
    --header "󰆧 Select project type:" \
    "󰙲 Standard C++ (Console/CLI)" \
    " Qt Application (GUI)" \
    "󰖟 Web/Backend (HTTP Server)" \
    "󰊗 GUI/Graphics (SFML, GTK, wxWidgets)")

# Extract clean project type (remove icon and get first word)
PROJECT_TYPE_CLEAN=$(echo "$PROJECT_TYPE" | sed 's/^[^ ]* //' | sed 's/ .*//')

echo ""

# Sub-type selection for Qt and Web
if [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
    QT_SUBTYPE=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header " Select Qt UI framework:" \
        "󰙃 Widgets (Traditional Desktop)" \
        "󱓞 QML/Quick (Modern/Touch)")
    
    QT_SUBTYPE_CLEAN=$(echo "$QT_SUBTYPE" | awk '{print $2}')
    echo ""
elif [ "$PROJECT_TYPE_CLEAN" = "Web/Backend" ]; then
    WEB_FRAMEWORK=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header "󰖟 Select web framework:" \
        "󰈸 Drogon (Production-ready, ORM, Coroutines) [Recommended]" \
        "󰩃 Crow (Simple, Flask-like, Header-only)" \
        "󱤆 oat++ (Zero-dependency, IoT/Embedded)")
    
    WEB_FRAMEWORK_CLEAN=$(echo "$WEB_FRAMEWORK" | awk '{print $2}')
    echo ""
elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
    GUI_FRAMEWORK=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header "󰊗 Select GUI/Graphics framework:" \
        "󰊗 SFML (Simple and Fast Multimedia Library - 2D/3D games)" \
        "󰘴 GTK (GNOME Toolkit - Native Linux GUI)" \
        "󰘳 wxWidgets (Cross-platform Native GUI)")
    
    GUI_FRAMEWORK_CLEAN=$(echo "$GUI_FRAMEWORK" | awk '{print $2}')
    echo ""
fi

# Package manager selection
PKG_MANAGER=$(gum choose \
    --header.foreground "$GOLD" \
    --cursor.foreground "$IRIS" \
    --selected.foreground "$FOAM" \
    --header "󰏖 Select package manager:" \
    "󰏖 vcpkg (Microsoft-backed, Simple CMake integration)" \
    "󰏗 Conan (Enterprise standard, Flexible versioning)")

PKG_MANAGER_CLEAN=$(echo "$PKG_MANAGER" | awk '{print $2}')
echo ""

# C++ standard version selection
CPP_STANDARD=$(gum choose \
    --header.foreground "$GOLD" \
    --cursor.foreground "$IRIS" \
    --selected.foreground "$FOAM" \
    --header "󰙱 Select C++ standard:" \
    "C++17 (Stable/Legacy)" \
    "C++20 (Recommended - Modern standard) [Default]" \
    "C++23 (Cutting Edge)")

CPP_STANDARD_NUM=$(echo "$CPP_STANDARD" | awk '{print $1}' | sed 's/C++//')
echo ""

gum_section "󰙅 Project Configuration"
echo ""

# Get project name with validation
if [ -n "$ARG_PROJECT_NAME" ]; then
    PROJECT_NAME="$ARG_PROJECT_NAME"
    
    if ! validate_project_name "$PROJECT_NAME"; then
        gum_error "Invalid project name: $PROJECT_NAME"
        gum_error "Use lowercase letters, numbers, and hyphens only."
        exit 1
    fi
    
    gum_info "Using project name: $PROJECT_NAME"
    echo ""
else
    while true; do
        PROJECT_NAME=$(gum input \
            --prompt.foreground "$FOAM" \
            --placeholder "my-awesome-app" \
            --header "󰈔 Project name (lowercase, alphanumeric, hyphens):" \
            --header.foreground "$SUBTLE" \
            --prompt "󰍟 ")
        
        if [ -z "$PROJECT_NAME" ]; then
            gum_error "Project name cannot be empty"
            continue
        fi
        
        if ! validate_project_name "$PROJECT_NAME"; then
            gum_error "Invalid name. Use lowercase letters, numbers, and hyphens only."
            continue
        fi
        
        break
    done
fi

# Get main class name (for Standard C++, Qt, and GUI frameworks)
if [ "$PROJECT_TYPE_CLEAN" != "Web/Backend" ]; then
    if [ "$PROJECT_TYPE_CLEAN" = "Standard" ]; then
        DEFAULT_MAIN="Main"
    elif [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
        DEFAULT_MAIN="MainWindow"
    elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
        if [ "$GUI_FRAMEWORK_CLEAN" = "SFML" ]; then
            DEFAULT_MAIN="Game"
        elif [ "$GUI_FRAMEWORK_CLEAN" = "GTK" ]; then
            DEFAULT_MAIN="MainWindow"
        elif [ "$GUI_FRAMEWORK_CLEAN" = "wxWidgets" ]; then
            DEFAULT_MAIN="MainFrame"
        fi
    fi
    
    if [ -n "$ARG_MAIN_CLASS" ]; then
        MAIN_CLASS="$ARG_MAIN_CLASS"
        
        if ! validate_class_name "$MAIN_CLASS"; then
            gum_error "Invalid main class name: $MAIN_CLASS"
            gum_error "Use PascalCase (e.g., MyApp, MainClass)."
            exit 1
        fi
        
        gum_info "Using main class: $MAIN_CLASS"
        echo ""
    else
        echo ""
        while true; do
            MAIN_CLASS=$(gum input \
                --prompt.foreground "$FOAM" \
                --placeholder "$DEFAULT_MAIN" \
                --value "$DEFAULT_MAIN" \
                --header "󰡱 Main class name (PascalCase):" \
                --header.foreground "$SUBTLE" \
                --prompt "󰍟 ")
            
            if [ -z "$MAIN_CLASS" ]; then
                MAIN_CLASS="$DEFAULT_MAIN"
            fi
            
            if ! validate_class_name "$MAIN_CLASS"; then
                gum_error "Invalid class name. Use PascalCase (e.g., MyApp, MainClass)."
                continue
            fi
            
            break
        done
    fi
fi

# Set namespace
NAMESPACE="quietghost"
FULL_NAMESPACE="${NAMESPACE}::${PROJECT_NAME//-/_}"

echo ""
gum_section "󰏖 Dependency Selection"
echo ""

# Dependency selection based on project type
selected=""
if [ "$PROJECT_TYPE_CLEAN" = "Standard" ]; then
    # Standard C++ dependencies
    display_list=$(echo "$CPP_DEPENDENCY_DATABASE" | grep -v "^#" | grep -v "^$" | awk -F'|' '{
        split($1, parts, ":")
        category = parts[2]
        gsub(/^[ \t]+|[ \t]+$/, "", category)
        description = $2
        gsub(/^[ \t]+|[ \t]+$/, "", description)
        printf "[%s] %s\n", category, description
    }')
    
    temp_db=$(mktemp)
    echo "$CPP_DEPENDENCY_DATABASE" > "$temp_db"
    
    selected=$(echo "$display_list" | fzf \
        --multi \
        --height=60% \
        --border=rounded \
        --prompt="󰏖 Select dependencies (TAB=multi-select, ENTER=confirm, ESC=skip): " \
        --header="Categories: TESTING, LOGGING, JSON, CLI, HTTP_CLIENT, DATABASE, etc." \
        --preview="bash -c 'desc=\$(echo {} | sed \"s/^\\\[.*\\\] //\"); grep \"| \$desc\$\" $temp_db | cut -d\"|\" -f1 | cut -d\":\" -f1 | xargs'" \
        --preview-window=down:3:wrap \
        --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
        --color='header:italic:underline' \
    ) || true
    
    rm -f "$temp_db"
    
elif [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
    # Qt dependencies
    display_list=$(echo "$QT_DEPENDENCY_DATABASE" | grep -v "^#" | grep -v "^$" | awk -F'|' '{
        split($1, parts, ":")
        category = parts[2]
        gsub(/^[ \t]+|[ \t]+$/, "", category)
        description = $2
        gsub(/^[ \t]+|[ \t]+$/, "", description)
        printf "[%s] %s\n", category, description
    }')
    
    temp_db=$(mktemp)
    echo "$QT_DEPENDENCY_DATABASE" > "$temp_db"
    
    selected=$(echo "$display_list" | fzf \
        --multi \
        --height=60% \
        --border=rounded \
        --prompt=" Select Qt modules (TAB=multi-select, ENTER=confirm, ESC=skip): " \
        --header="Qt6 Modules: CORE, NETWORKING, DATABASE, MULTIMEDIA, WEB, etc." \
        --preview="bash -c 'desc=\$(echo {} | sed \"s/^\\\[.*\\\] //\"); grep \"| \$desc\$\" $temp_db | cut -d\"|\" -f1 | cut -d\":\" -f1 | xargs'" \
        --preview-window=down:3:wrap \
        --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
        --color='header:italic:underline' \
    ) || true
    
    rm -f "$temp_db"
    
elif [ "$PROJECT_TYPE_CLEAN" = "Web/Backend" ]; then
    # Web framework utilities
    display_list=$(echo "$WEB_FRAMEWORK_DATABASE" | grep -v "^#" | grep -v "^$" | awk -F'|' '{
        split($1, parts, ":")
        category = parts[2]
        gsub(/^[ \t]+|[ \t]+$/, "", category)
        description = $2
        gsub(/^[ \t]+|[ \t]+$/, "", description)
        printf "[%s] %s\n", category, description
    }')
    
    temp_db=$(mktemp)
    echo "$WEB_FRAMEWORK_DATABASE" > "$temp_db"
    
    selected=$(echo "$display_list" | fzf \
        --multi \
        --height=60% \
        --border=rounded \
        --prompt="󰖟 Select utilities (TAB=multi-select, ENTER=confirm, ESC=skip): " \
        --header="Web Utilities: ORM, Redis, JWT, Password Hashing, etc." \
        --preview="bash -c 'desc=\$(echo {} | sed \"s/^\\\[.*\\\] //\"); grep \"| \$desc\$\" $temp_db | cut -d\"|\" -f1 | cut -d\":\" -f1 | xargs'" \
        --preview-window=down:3:wrap \
        --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
        --color='header:italic:underline' \
    ) || true
    
    rm -f "$temp_db"

elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
    # GUI/Graphics framework dependencies
    display_list=$(echo "$GUI_FRAMEWORK_DATABASE" | grep -v "^#" | grep -v "^$" | awk -F'|' '{
        split($1, parts, ":")
        category = parts[2]
        gsub(/^[ \t]+|[ \t]+$/, "", category)
        description = $2
        gsub(/^[ \t]+|[ \t]+$/, "", description)
        printf "[%s] %s\n", category, description
    }')
    
    temp_db=$(mktemp)
    echo "$GUI_FRAMEWORK_DATABASE" > "$temp_db"
    
    selected=$(echo "$display_list" | fzf \
        --multi \
        --height=60% \
        --border=rounded \
        --prompt="󰊗 Select modules (TAB=multi-select, ENTER=confirm, ESC=skip): " \
        --header="$GUI_FRAMEWORK_CLEAN Modules: Graphics, Audio, Network, Physics, etc." \
        --preview="bash -c 'desc=\$(echo {} | sed \"s/^\\\[.*\\\] //\"); grep \"| \$desc\$\" $temp_db | cut -d\"|\" -f1 | cut -d\":\" -f1 | xargs'" \
        --preview-window=down:3:wrap \
        --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
        --color='header:italic:underline' \
    ) || true
    
    rm -f "$temp_db"
fi

echo ""
gum_section "󰙅 Project Summary"
echo ""

# Display summary
if [ "$PROJECT_TYPE_CLEAN" = "Web/Backend" ]; then
    gum style \
        --border "rounded" \
        --border-foreground "$PINE" \
        --padding "1 2" \
        --margin "0 2" \
        "$(gum style --foreground "$FOAM" "Type:") $PROJECT_TYPE_CLEAN ($WEB_FRAMEWORK_CLEAN)" \
        "$(gum style --foreground "$FOAM" "Name:") $PROJECT_NAME" \
        "$(gum style --foreground "$FOAM" "Namespace:") $FULL_NAMESPACE" \
        "$(gum style --foreground "$FOAM" "C++ Standard:") C++$CPP_STANDARD_NUM" \
        "$(gum style --foreground "$FOAM" "Package Manager:") $PKG_MANAGER_CLEAN"
elif [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
    gum style \
        --border "rounded" \
        --border-foreground "$PINE" \
        --padding "1 2" \
        --margin "0 2" \
        "$(gum style --foreground "$FOAM" "Type:") $PROJECT_TYPE_CLEAN ($QT_SUBTYPE_CLEAN)" \
        "$(gum style --foreground "$FOAM" "Name:") $PROJECT_NAME" \
        "$(gum style --foreground "$FOAM" "Main Class:") $MAIN_CLASS" \
        "$(gum style --foreground "$FOAM" "Namespace:") $FULL_NAMESPACE" \
        "$(gum style --foreground "$FOAM" "C++ Standard:") C++$CPP_STANDARD_NUM" \
        "$(gum style --foreground "$FOAM" "Package Manager:") $PKG_MANAGER_CLEAN"
elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
    gum style \
        --border "rounded" \
        --border-foreground "$PINE" \
        --padding "1 2" \
        --margin "0 2" \
        "$(gum style --foreground "$FOAM" "Type:") $PROJECT_TYPE_CLEAN ($GUI_FRAMEWORK_CLEAN)" \
        "$(gum style --foreground "$FOAM" "Name:") $PROJECT_NAME" \
        "$(gum style --foreground "$FOAM" "Main Class:") $MAIN_CLASS" \
        "$(gum style --foreground "$FOAM" "Namespace:") $FULL_NAMESPACE" \
        "$(gum style --foreground "$FOAM" "C++ Standard:") C++$CPP_STANDARD_NUM" \
        "$(gum style --foreground "$FOAM" "Package Manager:") $PKG_MANAGER_CLEAN"
else
    gum style \
        --border "rounded" \
        --border-foreground "$PINE" \
        --padding "1 2" \
        --margin "0 2" \
        "$(gum style --foreground "$FOAM" "Type:") $PROJECT_TYPE_CLEAN" \
        "$(gum style --foreground "$FOAM" "Name:") $PROJECT_NAME" \
        "$(gum style --foreground "$FOAM" "Main Class:") $MAIN_CLASS" \
        "$(gum style --foreground "$FOAM" "Namespace:") $FULL_NAMESPACE" \
        "$(gum style --foreground "$FOAM" "C++ Standard:") C++$CPP_STANDARD_NUM" \
        "$(gum style --foreground "$FOAM" "Package Manager:") $PKG_MANAGER_CLEAN"
fi

echo ""

# Confirm before proceeding
if ! gum confirm \
    --selected.foreground "$FOAM" \
    --unselected.foreground "$LOVE" \
    --affirmative "󰄬 Create Project" \
    --negative "󰅖 Cancel" \
    "Proceed with project creation?"; then
    gum_error "Project creation cancelled"
    exit 0
fi

echo ""

# ============================================================================
# Project Generation
# ============================================================================

gum_info "Creating project structure..."
echo ""

# Create project directory
mkdir -p "$PROJECT_NAME"
cd "$PROJECT_NAME"

# Create directory structure
mkdir -p src
mkdir -p include/"${PROJECT_NAME//-/_}"
mkdir -p tests
mkdir -p cmake

# Process selected dependencies
SELECTED_DEPS=()
if [ -n "$selected" ]; then
    mapfile -t selected_lines <<< "$selected"
    
    for display_line in "${selected_lines[@]}"; do
        desc=$(echo "$display_line" | sed 's/^\[.*\] //')
        
        # Find original line based on project type
        if [ "$PROJECT_TYPE_CLEAN" = "Standard" ]; then
            original_line=$(echo "$CPP_DEPENDENCY_DATABASE" | grep "| $desc$")
        elif [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
            original_line=$(echo "$QT_DEPENDENCY_DATABASE" | grep "| $desc$")
        elif [ "$PROJECT_TYPE_CLEAN" = "Web/Backend" ]; then
            original_line=$(echo "$WEB_FRAMEWORK_DATABASE" | grep "| $desc$")
        elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
            original_line=$(echo "$GUI_FRAMEWORK_DATABASE" | grep "| $desc$")
        fi
        
        if [ -n "$original_line" ]; then
            dep_name=$(echo "$original_line" | cut -d'|' -f1 | cut -d':' -f1 | xargs)
            SELECTED_DEPS+=("$dep_name")
        fi
    done
    
    gum_info "Selected ${#SELECTED_DEPS[@]} dependencies"
fi

# Add framework dependency for web and GUI projects
if [ "$PROJECT_TYPE_CLEAN" = "Web/Backend" ]; then
    FRAMEWORK_DEP=$(echo "$WEB_FRAMEWORK_CLEAN" | tr '[:upper:]' '[:lower:]')
    SELECTED_DEPS=("$FRAMEWORK_DEP" "${SELECTED_DEPS[@]}")
elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
    FRAMEWORK_DEP=$(echo "$GUI_FRAMEWORK_CLEAN" | tr '[:upper:]' '[:lower:]')
    SELECTED_DEPS=("$FRAMEWORK_DEP" "${SELECTED_DEPS[@]}")
fi

# ============================================================================
# Generate CMakeLists.txt
# ============================================================================

gum_info "Generating CMakeLists.txt..."

cat > CMakeLists.txt << EOFCMAKE
cmake_minimum_required(VERSION 3.20)
project(${PROJECT_NAME} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD ${CPP_STANDARD_NUM})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Export compile commands for LSP/clangd
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
EOFCMAKE

# Add package manager toolchain
if [ "$PKG_MANAGER_CLEAN" = "vcpkg" ]; then
    cat >> CMakeLists.txt << 'EOFCMAKE'

# vcpkg integration (if using vcpkg)
if(DEFINED ENV{VCPKG_ROOT} AND NOT DEFINED CMAKE_TOOLCHAIN_FILE)
    set(CMAKE_TOOLCHAIN_FILE "$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        CACHE STRING "")
endif()
EOFCMAKE
elif [ "$PKG_MANAGER_CLEAN" = "Conan" ]; then
    cat >> CMakeLists.txt << 'EOFCMAKE'

# Conan integration
include(${CMAKE_BINARY_DIR}/conan_toolchain.cmake OPTIONAL)
EOFCMAKE
fi

# Add find_package calls based on project type
cat >> CMakeLists.txt << 'EOFCMAKE'

# Find dependencies
EOFCMAKE

if [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
    cat >> CMakeLists.txt << 'EOFCMAKE'
find_package(Qt6 REQUIRED COMPONENTS Core Widgets)
set(CMAKE_AUTOMOC ON)
set(CMAKE_AUTOUIC ON)
set(CMAKE_AUTORCC ON)
EOFCMAKE
    
    if [ "$QT_SUBTYPE_CLEAN" = "QML/Quick" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'
find_package(Qt6 REQUIRED COMPONENTS Quick)
EOFCMAKE
    fi
elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
    if [ "$GUI_FRAMEWORK_CLEAN" = "SFML" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'
find_package(SFML 2.5 REQUIRED COMPONENTS system window graphics audio network)
EOFCMAKE
    elif [ "$GUI_FRAMEWORK_CLEAN" = "GTK" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'
find_package(PkgConfig REQUIRED)
pkg_check_modules(GTKMM REQUIRED gtkmm-4.0)
EOFCMAKE
    elif [ "$GUI_FRAMEWORK_CLEAN" = "wxWidgets" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'
find_package(wxWidgets REQUIRED COMPONENTS core base)
include(${wxWidgets_USE_FILE})
EOFCMAKE
    fi
fi

# Add dependency find_package calls
for dep in "${SELECTED_DEPS[@]}"; do
    case "$dep" in
        gtest|catch2|fmt|spdlog|nlohmann-json|cli11|cpr|abseil|boost)
            # These have standard CMake find modules
            ;;
    esac
done

# Add executable/library target
NAMESPACE_PATH="${PROJECT_NAME//-/_}"

cat >> CMakeLists.txt << EOFCMAKE

# Source files
set(SOURCES
    src/main.cpp
)

set(HEADERS
)

# Create executable
add_executable(\${PROJECT_NAME} \${SOURCES} \${HEADERS})

# Ensure executable is in build root for easy discovery
set_target_properties(\${PROJECT_NAME} PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "\${CMAKE_BINARY_DIR}"
)

# Include directories
target_include_directories(\${PROJECT_NAME} PRIVATE
    \${CMAKE_CURRENT_SOURCE_DIR}/include
)
EOFCMAKE

# Link libraries based on project type
if [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
    cat >> CMakeLists.txt << 'EOFCMAKE'

# Link Qt libraries
target_link_libraries(${PROJECT_NAME} PRIVATE
    Qt6::Core
    Qt6::Widgets
)
EOFCMAKE
    
    if [ "$QT_SUBTYPE_CLEAN" = "QML/Quick" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'
target_link_libraries(${PROJECT_NAME} PRIVATE Qt6::Quick)
EOFCMAKE
    fi
elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
    if [ "$GUI_FRAMEWORK_CLEAN" = "SFML" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'

# Link SFML libraries
target_link_libraries(${PROJECT_NAME} PRIVATE
    sfml-system
    sfml-window
    sfml-graphics
    sfml-audio
    sfml-network
)
EOFCMAKE
    elif [ "$GUI_FRAMEWORK_CLEAN" = "GTK" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'

# Link GTKmm libraries
target_include_directories(${PROJECT_NAME} PRIVATE ${GTKMM_INCLUDE_DIRS})
target_link_libraries(${PROJECT_NAME} PRIVATE ${GTKMM_LIBRARIES})
target_link_directories(${PROJECT_NAME} PRIVATE ${GTKMM_LIBRARY_DIRS})
EOFCMAKE
    elif [ "$GUI_FRAMEWORK_CLEAN" = "wxWidgets" ]; then
        cat >> CMakeLists.txt << 'EOFCMAKE'

# Link wxWidgets libraries
target_link_libraries(${PROJECT_NAME} PRIVATE ${wxWidgets_LIBRARIES})
EOFCMAKE
    fi
fi

# Add testing
cat >> CMakeLists.txt << 'EOFCMAKE'

# Testing (optional - enable with -DBUILD_TESTS=ON)
option(BUILD_TESTS "Build test executables" OFF)
if(BUILD_TESTS)
    enable_testing()
    add_subdirectory(tests)
endif()
EOFCMAKE

# Create tests/CMakeLists.txt
