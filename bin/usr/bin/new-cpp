EOFMAIN

        # Generate SFML Game header
        HEADER_GUARD="${NAMESPACE^^}_${PROJECT_NAME^^}_${MAIN_CLASS^^}_HPP"
        HEADER_GUARD="${HEADER_GUARD//-/_}"
        
        cat > "include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" << EOFHEADER
#ifndef ${HEADER_GUARD}
#define ${HEADER_GUARD}

#include <SFML/Graphics.hpp>

namespace ${FULL_NAMESPACE} {

class ${MAIN_CLASS} {
public:
    ${MAIN_CLASS}();
    ~${MAIN_CLASS}() = default;
    
    int run();
    
private:
    void processEvents();
    void update();
    void render();
    
    sf::RenderWindow window_;
    sf::CircleShape shape_;
};

} // namespace ${FULL_NAMESPACE}

#endif // ${HEADER_GUARD}
EOFHEADER

        cat > "src/${MAIN_CLASS}.cpp" << EOFIMPL
#include "${NAMESPACE_PATH}/${MAIN_CLASS}.hpp"

namespace ${FULL_NAMESPACE} {

${MAIN_CLASS}::${MAIN_CLASS}()
    : window_(sf::VideoMode(800, 600), "${PROJECT_NAME}")
    , shape_(100.f) {
    
    shape_.setFillColor(sf::Color::Green);
    shape_.setPosition(350.f, 250.f);
}

int ${MAIN_CLASS}::run() {
    while (window_.isOpen()) {
        processEvents();
        update();
        render();
    }
    return 0;
}

void ${MAIN_CLASS}::processEvents() {
    sf::Event event;
    while (window_.pollEvent(event)) {
        if (event.type == sf::Event::Closed)
            window_.close();
    }
}

void ${MAIN_CLASS}::update() {
    // Game logic here
}

void ${MAIN_CLASS}::render() {
    window_.clear();
    window_.draw(shape_);
    window_.display();
}

} // namespace ${FULL_NAMESPACE}
EOFIMPL

        sed -i "/set(SOURCES/a\\    src/${MAIN_CLASS}.cpp" CMakeLists.txt
        sed -i "/set(HEADERS/a\\    include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" CMakeLists.txt
        
    elif [ "$GUI_FRAMEWORK_CLEAN" = "GTK" ]; then
        # GTK Application
        cat > src/main.cpp << EOFMAIN
#include "${NAMESPACE_PATH}/${MAIN_CLASS}.hpp"
#include <gtkmm/application.h>

int main(int argc, char* argv[]) {
    auto app = Gtk::Application::create("${NAMESPACE}.${PROJECT_NAME//-/_}");
    return app->make_window_and_run<${FULL_NAMESPACE}::${MAIN_CLASS}>(argc, argv);
}
EOFMAIN

        # Generate GTK MainWindow header
        HEADER_GUARD="${NAMESPACE^^}_${PROJECT_NAME^^}_${MAIN_CLASS^^}_HPP"
        HEADER_GUARD="${HEADER_GUARD//-/_}"
        
        cat > "include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" << EOFHEADER
#ifndef ${HEADER_GUARD}
#define ${HEADER_GUARD}

#include <gtkmm/applicationwindow.h>
#include <gtkmm/button.h>
#include <gtkmm/box.h>
#include <gtkmm/label.h>

namespace ${FULL_NAMESPACE} {

class ${MAIN_CLASS} : public Gtk::ApplicationWindow {
public:
    ${MAIN_CLASS}();
    ~${MAIN_CLASS}() override = default;

protected:
    // Signal handlers
    void on_button_clicked();
    
    // Child widgets
    Gtk::Box box_;
    Gtk::Label label_;
    Gtk::Button button_;
};

} // namespace ${FULL_NAMESPACE}

#endif // ${HEADER_GUARD}
EOFHEADER

        cat > "src/${MAIN_CLASS}.cpp" << EOFIMPL
#include "${NAMESPACE_PATH}/${MAIN_CLASS}.hpp"

namespace ${FULL_NAMESPACE} {

${MAIN_CLASS}::${MAIN_CLASS}()
    : box_(Gtk::Orientation::VERTICAL)
    , label_("Hello from ${PROJECT_NAME}!")
    , button_("Click Me") {
    
    set_title("${PROJECT_NAME}");
    set_default_size(400, 300);
    
    box_.set_margin(10);
    box_.set_spacing(10);
    
    box_.append(label_);
    box_.append(button_);
    
    button_.signal_clicked().connect(
        sigc::mem_fun(*this, &${MAIN_CLASS}::on_button_clicked)
    );
    
    set_child(box_);
}

void ${MAIN_CLASS}::on_button_clicked() {
    label_.set_text("Button clicked!");
}

} // namespace ${FULL_NAMESPACE}
EOFIMPL

        sed -i "/set(SOURCES/a\\    src/${MAIN_CLASS}.cpp" CMakeLists.txt
        sed -i "/set(HEADERS/a\\    include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" CMakeLists.txt
        
    elif [ "$GUI_FRAMEWORK_CLEAN" = "wxWidgets" ]; then
        # wxWidgets Application
        cat > src/main.cpp << EOFMAIN
#include "${NAMESPACE_PATH}/${MAIN_CLASS}.hpp"
#include <wx/wx.h>

namespace ${FULL_NAMESPACE} {

class App : public wxApp {
public:
    bool OnInit() override {
        ${MAIN_CLASS}* frame = new ${MAIN_CLASS}();
        frame->Show(true);
        return true;
    }
};

} // namespace ${FULL_NAMESPACE}

wxIMPLEMENT_APP(${FULL_NAMESPACE}::App);
EOFMAIN

        # Generate wxWidgets MainFrame header
        HEADER_GUARD="${NAMESPACE^^}_${PROJECT_NAME^^}_${MAIN_CLASS^^}_HPP"
        HEADER_GUARD="${HEADER_GUARD//-/_}"
        
        cat > "include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" << EOFHEADER
#ifndef ${HEADER_GUARD}
#define ${HEADER_GUARD}

#include <wx/wx.h>

namespace ${FULL_NAMESPACE} {

class ${MAIN_CLASS} : public wxFrame {
public:
    ${MAIN_CLASS}();
    
private:
    void OnButtonClick(wxCommandEvent& event);
    
    wxPanel* panel_;
    wxStaticText* label_;
    wxButton* button_;
    
    wxDECLARE_EVENT_TABLE();
};

} // namespace ${FULL_NAMESPACE}

#endif // ${HEADER_GUARD}
EOFHEADER

        cat > "src/${MAIN_CLASS}.cpp" << EOFIMPL
#include "${NAMESPACE_PATH}/${MAIN_CLASS}.hpp"

namespace ${FULL_NAMESPACE} {

wxBEGIN_EVENT_TABLE(${MAIN_CLASS}, wxFrame)
    EVT_BUTTON(wxID_ANY, ${MAIN_CLASS}::OnButtonClick)
wxEND_EVENT_TABLE()

${MAIN_CLASS}::${MAIN_CLASS}()
    : wxFrame(nullptr, wxID_ANY, "${PROJECT_NAME}", wxDefaultPosition, wxSize(400, 300)) {
    
    panel_ = new wxPanel(this);
    
    auto* sizer = new wxBoxSizer(wxVERTICAL);
    
    label_ = new wxStaticText(panel_, wxID_ANY, "Hello from ${PROJECT_NAME}!",
        wxDefaultPosition, wxDefaultSize, wxALIGN_CENTER_HORIZONTAL);
    sizer->Add(label_, 0, wxALL | wxEXPAND, 10);
    
    button_ = new wxButton(panel_, wxID_ANY, "Click Me");
    sizer->Add(button_, 0, wxALL | wxCENTER, 10);
    
    panel_->SetSizer(sizer);
}

void ${MAIN_CLASS}::OnButtonClick(wxCommandEvent& event) {
    label_->SetLabel("Button clicked!");
}

} // namespace ${FULL_NAMESPACE}
EOFIMPL

        sed -i "/set(SOURCES/a\\    src/${MAIN_CLASS}.cpp" CMakeLists.txt
        sed -i "/set(HEADERS/a\\    include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" CMakeLists.txt
    fi
fi

