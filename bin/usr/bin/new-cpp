    # Generate header file
    HEADER_GUARD="${NAMESPACE^^}_${PROJECT_NAME^^}_${MAIN_CLASS^^}_HPP"
    HEADER_GUARD="${HEADER_GUARD//-/_}"
    
    cat > "include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" << EOFHEADER
#ifndef ${HEADER_GUARD}
#define ${HEADER_GUARD}

namespace ${FULL_NAMESPACE} {

class ${MAIN_CLASS} {
public:
    ${MAIN_CLASS}() = default;
    ~${MAIN_CLASS}() = default;
    
    int run(int argc, char* argv[]);
    
private:
    // Add your private members here
};

} // namespace ${FULL_NAMESPACE}

#endif // ${HEADER_GUARD}
EOFHEADER

    # Generate implementation stub
    cat > "src/${MAIN_CLASS}.cpp" << EOFIMPL
#include "${NAMESPACE_PATH}/${MAIN_CLASS}.hpp"
#include <iostream>

namespace ${FULL_NAMESPACE} {

int ${MAIN_CLASS}::run(int argc, char* argv[]) {
    std::cout << "Hello from ${PROJECT_NAME}!" << std::endl;
    return 0;
}

} // namespace ${FULL_NAMESPACE}
EOFIMPL

    # Update CMakeLists.txt sources
    sed -i "/set(SOURCES/a\\    src/${MAIN_CLASS}.cpp" CMakeLists.txt
    sed -i "/set(HEADERS/a\\    include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" CMakeLists.txt

elif [ "$PROJECT_TYPE_CLEAN" = "Qt" ]; then
    if [ "$QT_SUBTYPE_CLEAN" = "Widgets" ]; then
        # Qt Widgets application
        cat > src/main.cpp << EOFMAIN
#include <QApplication>
#include "${NAMESPACE_PATH}/${MAIN_CLASS}.hpp"

