    <qresource prefix="/">
        <file>qml/main.qml</file>
    </qresource>
</RCC>
EOFQRC

        # Update CMakeLists.txt for QML
        sed -i '/set(SOURCES/a\    resources.qrc' CMakeLists.txt
    fi

elif [ "$PROJECT_TYPE_CLEAN" = "Web/Backend" ]; then
    if [ "$WEB_FRAMEWORK_CLEAN" = "Drogon" ]; then
        cat > src/main.cpp << 'EOFDROGON'
#include <drogon/drogon.h>

int main() {
    // Set HTTP listener address and port
    drogon::app().addListener("0.0.0.0", 8080);
    
    // Load config file (optional)
    // drogon::app().loadConfigFile("config.json");
    
    // Register handlers
    drogon::app().registerHandler(
        "/",
        [](const drogon::HttpRequestPtr& req,
           std::function<void(const drogon::HttpResponsePtr&)>&& callback) {
            auto resp = drogon::HttpResponse::newHttpResponse();
            resp->setBody("Hello from PROJECTNAME!");
            callback(resp);
        },
        {drogon::Get}
    );
    
    drogon::app().registerHandler(
        "/api/hello",
        [](const drogon::HttpRequestPtr& req,
           std::function<void(const drogon::HttpResponsePtr&)>&& callback) {
            Json::Value json;
            json["message"] = "Hello, World!";
            json["status"] = "success";
            
            auto resp = drogon::HttpResponse::newHttpJsonResponse(json);
            callback(resp);
        },
        {drogon::Get, drogon::Post}
    );
    
    LOG_INFO << "Server running on http://0.0.0.0:8080";
    
    // Run the application
    drogon::app().run();
    return 0;
}
EOFDROGON
        sed -i "s/PROJECTNAME/${PROJECT_NAME}/g" src/main.cpp
        
    elif [ "$WEB_FRAMEWORK_CLEAN" = "Crow" ]; then
        cat > src/main.cpp << 'EOFCROW'
#include "crow.h"

int main() {
    crow::SimpleApp app;
    
    CROW_ROUTE(app, "/")([](){
        return "Hello from PROJECTNAME!";
    });
    
    CROW_ROUTE(app, "/api/hello")
        .methods("GET"_method, "POST"_method)
    ([](const crow::request& req){
        crow::json::wvalue json;
        json["message"] = "Hello, World!";
        json["status"] = "success";
        return crow::response(json);
    });
    
    app.port(8080).multithreaded().run();
    return 0;
}
EOFCROW
        sed -i "s/PROJECTNAME/${PROJECT_NAME}/g" src/main.cpp
        
    elif [ "$WEB_FRAMEWORK_CLEAN" = "oat++" ]; then
        cat > src/main.cpp << 'EOFOAT'
#include "oatpp/web/server/HttpConnectionHandler.hpp"
#include "oatpp/network/Server.hpp"
#include "oatpp/network/tcp/server/ConnectionProvider.hpp"

#include <iostream>

int main() {
    // Create router
    auto router = oatpp::web::server::HttpRouter::createShared();
    
    // Create connection handler
    auto connectionHandler = oatpp::web::server::HttpConnectionHandler::createShared(router);
    
    // Create connection provider
    auto connectionProvider = oatpp::network::tcp::server::ConnectionProvider::createShared(
        {"0.0.0.0", 8080, oatpp::network::Address::IP_4}
    );
    
    // Create server
    oatpp::network::Server server(connectionProvider, connectionHandler);
    
    std::cout << "Server running on http://0.0.0.0:8080" << std::endl;
    
    server.run();
    return 0;
}
EOFOAT
    fi

elif [ "$PROJECT_TYPE_CLEAN" = "GUI/Graphics" ]; then
    if [ "$GUI_FRAMEWORK_CLEAN" = "SFML" ]; then
        # SFML Game Application
        cat > src/main.cpp << EOFMAIN
#include <SFML/Graphics.hpp>
