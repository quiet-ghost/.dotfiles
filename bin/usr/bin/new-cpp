EOFTEST

# ============================================================================
# Generate Package Manager Manifests
# ============================================================================

if [ "$PKG_MANAGER_CLEAN" = "vcpkg" ]; then
    gum_info "Generating vcpkg.json manifest..."
    
    cat > vcpkg.json << 'EOFVCPKG'
{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "PROJECTNAME",
  "version": "0.1.0",
  "dependencies": [
EOFVCPKG
    
    # Replace project name
    sed -i "s/PROJECTNAME/${PROJECT_NAME}/" vcpkg.json
    
    # Add dependencies
    if [ ${#SELECTED_DEPS[@]} -gt 0 ]; then
        for i in "${!SELECTED_DEPS[@]}"; do
            dep="${SELECTED_DEPS[$i]}"
            if [ $i -eq $((${#SELECTED_DEPS[@]} - 1)) ]; then
                echo "    \"$dep\"" >> vcpkg.json
            else
                echo "    \"$dep\"," >> vcpkg.json
            fi
        done
    fi
    
    cat >> vcpkg.json << 'EOFVCPKG'
  ]
}
EOFVCPKG

elif [ "$PKG_MANAGER_CLEAN" = "Conan" ]; then
    gum_info "Generating conanfile.txt..."
    
    cat > conanfile.txt << 'EOFCONAN'
[requires]
EOFCONAN
    
    # Add dependencies
    for dep in "${SELECTED_DEPS[@]}"; do
        echo "$dep/[>=1.0.0]" >> conanfile.txt
    done
    
    cat >> conanfile.txt << 'EOFCONAN'

[generators]
CMakeDeps
CMakeToolchain

[options]

[imports]
EOFCONAN
fi

