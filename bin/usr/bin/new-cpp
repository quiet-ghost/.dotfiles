EOFIMPL

        sed -i "/set(SOURCES/a\\    src/${MAIN_CLASS}.cpp" CMakeLists.txt
        sed -i "/set(HEADERS/a\\    include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" CMakeLists.txt
        
    else
        # QML/Quick application
        cat > src/main.cpp << EOFMAIN
#include <QGuiApplication>
#include <QQmlApplicationEngine>

int main(int argc, char* argv[]) {
    QGuiApplication app(argc, argv);
    
    QQmlApplicationEngine engine;
    engine.load(QUrl(QStringLiteral("qrc:/qml/main.qml")));
    
    if (engine.rootObjects().isEmpty())
        return -1;
    
    return app.exec();
}
EOFMAIN

        # Create QML file
        mkdir -p qml
        cat > qml/main.qml << 'EOFQML'
import QtQuick
import QtQuick.Controls

ApplicationWindow {
    visible: true
    width: 800
    height: 600
    title: "PROJECTNAME"
    
    Column {
        anchors.centerIn: parent
        spacing: 20
        
        Label {
            text: "Hello from PROJECTNAME!"
            font.pixelSize: 24
            anchors.horizontalCenter: parent.horizontalCenter
        }
        
        Button {
            text: "Click Me"
            anchors.horizontalCenter: parent.horizontalCenter
            onClicked: console.log("Button clicked!")
        }
    }
}
EOFQML
        sed -i "s/PROJECTNAME/${PROJECT_NAME}/g" qml/main.qml
        
        # Create Qt resource file
        cat > resources.qrc << 'EOFQRC'
