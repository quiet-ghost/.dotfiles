    QApplication app(argc, argv);
    
    ${FULL_NAMESPACE}::${MAIN_CLASS} window;
    window.show();
    
    return app.exec();
}
EOFMAIN

        # Generate Qt MainWindow header
        HEADER_GUARD="${NAMESPACE^^}_${PROJECT_NAME^^}_${MAIN_CLASS^^}_HPP"
        HEADER_GUARD="${HEADER_GUARD//-/_}"
        
        cat > "include/${NAMESPACE_PATH}/${MAIN_CLASS}.hpp" << EOFHEADER
#ifndef ${HEADER_GUARD}
