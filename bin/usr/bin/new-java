#!/usr/bin/env bash

# Unified Java Project Generator
# Creates Maven, JavaFX, Spring Boot, or Jakarta EE projects
# 
# Usage: 
#   new-java                        - Interactive mode (all prompts)
#   new-java <project-name>         - Skip project name prompt
#   new-java <project-name> <Main>  - Skip project name and main class prompts
#
# Examples:
#   new-java                        - Fully interactive
#   new-java my-app                 - Use "my-app" as project name
#   new-java my-app MyApplication   - Use "my-app" and "MyApplication" as main class

set -e

# ============================================================================
# Rose Pine Color Scheme
# ============================================================================
BASE="#191724"
SURFACE="#1f1d2e"
OVERLAY="#26233a"
MUTED="#6e6a86"
SUBTLE="#908caa"
TEXT="#e0def4"
LOVE="#eb6f92"
GOLD="#f6c177"
ROSE="#ebbcba"
PINE="#31748f"
FOAM="#9ccfd8"
IRIS="#c4a7e7"
HIGHLIGHT_LOW="#21202e"
HIGHLIGHT_MED="#403d52"
HIGHLIGHT_HIGH="#524f67"

# ============================================================================
# Utility Functions
# ============================================================================

gum_header() {
    gum style \
        --foreground "$IRIS" \
        --border "rounded" \
        --border-foreground "$PINE" \
        --align "center" \
        --padding "1 4" \
        --margin "1 0" \
        "$@"
}

gum_info() {
    gum style --foreground "$FOAM" " $*"
}

gum_success() {
    gum style --foreground "$FOAM" --bold " $*"
}

gum_error() {
    gum style --foreground "$LOVE" --bold " $*"
}

gum_section() {
    gum style --foreground "$GOLD" --bold "$*"
}

validate_project_name() {
    local name="$1"
    [[ "$name" =~ ^[a-z0-9-]+$ ]]
}

validate_class_name() {
    local name="$1"
    [[ "$name" =~ ^[A-Z][a-zA-Z0-9]*$ ]]
}

check_command() {
    if ! command -v "$1" &> /dev/null; then
        gum_error "Error: $1 is not installed"
        [ -n "$2" ] && gum_info "Install with: $2"
        exit 1
    fi
}

trim() {
    local value="$1"
    value="${value#${value%%[![:space:]]*}}"
    value="${value%${value##*[![:space:]]}}"
    printf '%s' "$value"
}

pascal_case() {
    local input="$1"
    local output=""
    local part=""

    IFS='-' read -ra parts <<< "$input"
    for part in "${parts[@]}"; do
        output+="${part^}"
    done

    printf '%s' "$output"
}

select_database_entries() {
    local database="$1"
    local prompt="$2"
    local header="$3"
    local temp_db
    local display_list
    local selected

    display_list=$(echo "$database" | grep -v "^#" | grep -v "^$" | awk -F'|' '{
        split($1, parts, ":")
        id = parts[1]
        category = parts[2]
        gsub(/^[ \t]+|[ \t]+$/, "", id)
        gsub(/^[ \t]+|[ \t]+$/, "", category)
        description = $2
        gsub(/^[ \t]+|[ \t]+$/, "", description)
        printf "[%s] %s|%s\n", category, description, id
    }')

    temp_db=$(mktemp)
    echo "$database" > "$temp_db"

    selected=$(echo "$display_list" | fzf \
        --multi \
        --height=60% \
        --border=rounded \
        --prompt="$prompt" \
        --header="$header" \
        --preview="bash -c 'id=\$(echo {} | cut -d\"|\" -f2); grep \"^\$id:\" $temp_db | cut -d\"|\" -f2- | xargs'" \
        --preview-window=down:3:wrap \
        --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
        --color='header:italic:underline' \
    ) || true

    rm -f "$temp_db"
    printf '%s' "$selected"
}

has_selected_id() {
    local id="$1"
    local selected_ids="$2"
    [[ " $selected_ids " == *" $id "* ]]
}

normalize_jakarta_version() {
    case "$1" in
        "Jakarta EE 11"*) printf '11' ;;
        "Jakarta EE 10"*) printf '10' ;;
        "Jakarta EE 9.1"*) printf '9.1' ;;
        "Jakarta EE 9"*) printf '9' ;;
        "Java EE 8"*) printf '8' ;;
        *) printf '%s' "$1" ;;
    esac
}

normalize_jakarta_profile() {
    case "$1" in
        "Core"*) printf 'core' ;;
        "Web"*) printf 'web' ;;
        "Platform"*|"Full"*) printf 'full' ;;
        *) printf '%s' "$1" ;;
    esac
}

normalize_jakarta_server() {
    case "$1" in
        "None"*) printf 'none' ;;
        "Tomcat 11"*"server"*) printf 'tomcat11-local' ;;
        "Tomcat 11"*"client"*) printf 'tomcat11-remote' ;;
        "Tomcat 10.1"*"server"*) printf 'tomcat101-local' ;;
        "Tomcat 10.1"*"client"*) printf 'tomcat101-remote' ;;
        "Tomcat 10"*"server"*) printf 'tomcat10-local' ;;
        "Tomcat 10"*"client"*) printf 'tomcat10-remote' ;;
        "Tomcat 9"*"server"*) printf 'tomcat9-local' ;;
        "Tomcat 9"*"client"*) printf 'tomcat9-remote' ;;
        "GlassFish"*) printf 'glassfish' ;;
        "Payara"*) printf 'payara' ;;
        "WildFly"*) printf 'wildfly' ;;
        "Open Liberty"*) printf 'open-liberty' ;;
        "TomEE"*) printf 'tomee' ;;
        *) printf '%s' "$1" ;;
    esac
}

