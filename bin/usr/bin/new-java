jakarta_add_dependency() {
    local file="$1"
    local group_id_dep="$2"
    local artifact_id="$3"
    local version="$4"
    local scope="${5:-compile}"
    local key="$group_id_dep:$artifact_id"

    if [[ " $JAKARTA_DEP_KEYS " == *" $key "* ]]; then
        return
    fi

    JAKARTA_DEP_KEYS="$JAKARTA_DEP_KEYS $key"
    {
        echo "        <dependency>"
        echo "            <groupId>$group_id_dep</groupId>"
        echo "            <artifactId>$artifact_id</artifactId>"
        echo "            <version>$version</version>"
        if [ "$scope" != "compile" ]; then
            echo "            <scope>$scope</scope>"
        fi
        echo "        </dependency>"
    } >> "$file"
}

jakarta_add_feature_dependency() {
    local feature="$1"
    local file="$2"

    case "$feature" in
        platform-api) jakarta_add_dependency "$file" "$EE_PLATFORM_GROUP" "$EE_PLATFORM_ARTIFACT" "$EE_API_VERSION" provided ;;
        web-profile) jakarta_add_dependency "$file" "$EE_PLATFORM_GROUP" "$EE_WEB_ARTIFACT" "$EE_API_VERSION" provided ;;
        core-profile) jakarta_add_dependency "$file" "$EE_PLATFORM_GROUP" "$EE_CORE_ARTIFACT" "$EE_API_VERSION" provided ;;
        servlet) jakarta_add_dependency "$file" "$SERVLET_GROUP" "$SERVLET_ARTIFACT" "$SERVLET_VERSION" provided ;;
        jsp) jakarta_add_dependency "$file" "$JSP_GROUP" "$JSP_ARTIFACT" "$JSP_VERSION" provided ;;
        jstl) jakarta_add_dependency "$file" "$JSTL_GROUP" "$JSTL_ARTIFACT" "$JSTL_VERSION" ;;
        expression-language) jakarta_add_dependency "$file" "$EL_GROUP" "$EL_ARTIFACT" "$EL_VERSION" provided ;;
        websocket) jakarta_add_dependency "$file" "$WEBSOCKET_GROUP" "$WEBSOCKET_ARTIFACT" "$WEBSOCKET_VERSION" provided ;;
        jax-rs) jakarta_add_dependency "$file" "$JAXRS_GROUP" "$JAXRS_ARTIFACT" "$JAXRS_VERSION" provided ;;
        json-p) jakarta_add_dependency "$file" "$JSONP_GROUP" "$JSONP_ARTIFACT" "$JSONP_VERSION" provided ;;
        json-b) jakarta_add_dependency "$file" "$JSONB_GROUP" "$JSONB_ARTIFACT" "$JSONB_VERSION" provided ;;
        cdi) jakarta_add_dependency "$file" "$CDI_GROUP" "$CDI_ARTIFACT" "$CDI_VERSION" provided ;;
        bean-validation) jakarta_add_dependency "$file" "$VALIDATION_GROUP" "$VALIDATION_ARTIFACT" "$VALIDATION_VERSION" provided ;;
        jpa) jakarta_add_dependency "$file" "$PERSISTENCE_GROUP" "$PERSISTENCE_ARTIFACT" "$PERSISTENCE_VERSION" provided ;;
        jta) jakarta_add_dependency "$file" "$TRANSACTION_GROUP" "$TRANSACTION_ARTIFACT" "$TRANSACTION_VERSION" provided ;;
        ejb) jakarta_add_dependency "$file" "$EJB_GROUP" "$EJB_ARTIFACT" "$EJB_VERSION" provided ;;
        jms) jakarta_add_dependency "$file" "$JMS_GROUP" "$JMS_ARTIFACT" "$JMS_VERSION" provided ;;
        mail) jakarta_add_dependency "$file" "$MAIL_GROUP" "$MAIL_ARTIFACT" "$MAIL_VERSION" provided ;;
        security) jakarta_add_dependency "$file" "$SECURITY_GROUP" "$SECURITY_ARTIFACT" "$SECURITY_VERSION" provided ;;
        faces) jakarta_add_dependency "$file" "$FACES_GROUP" "$FACES_ARTIFACT" "$FACES_VERSION" provided ;;
        batch) jakarta_add_dependency "$file" "$BATCH_GROUP" "$BATCH_ARTIFACT" "$BATCH_VERSION" provided ;;
        concurrency) jakarta_add_dependency "$file" "$CONCURRENCY_GROUP" "$CONCURRENCY_ARTIFACT" "$CONCURRENCY_VERSION" provided ;;
        connectors) jakarta_add_dependency "$file" "$CONNECTOR_GROUP" "$CONNECTOR_ARTIFACT" "$CONNECTOR_VERSION" provided ;;
        annotations) jakarta_add_dependency "$file" "$ANNOTATION_GROUP" "$ANNOTATION_ARTIFACT" "$ANNOTATION_VERSION" provided ;;
        interceptors) jakarta_add_dependency "$file" "$INTERCEPTOR_GROUP" "$INTERCEPTOR_ARTIFACT" "$INTERCEPTOR_VERSION" provided ;;
        jersey-server) jakarta_add_dependency "$file" org.glassfish.jersey.containers jersey-container-servlet "$JERSEY_VERSION" ;;
        jersey-client) jakarta_add_dependency "$file" org.glassfish.jersey.core jersey-client "$JERSEY_VERSION" ;;
        jersey-json) jakarta_add_dependency "$file" org.glassfish.jersey.media jersey-media-json-jackson "$JERSEY_VERSION" ;;
        jersey-hk2) jakarta_add_dependency "$file" org.glassfish.jersey.inject jersey-hk2 "$JERSEY_VERSION" ;;
        jersey-cdi) jakarta_add_dependency "$file" org.glassfish.jersey.inject jersey-cdi2-se "$JERSEY_VERSION" ;;
        weld-se) jakarta_add_dependency "$file" org.jboss.weld.se weld-se-core "$WELD_VERSION" ;;
        hibernate-validator) jakarta_add_dependency "$file" org.hibernate.validator hibernate-validator "$HIBERNATE_VALIDATOR_VERSION" ;;
        hibernate-orm) jakarta_add_dependency "$file" org.hibernate.orm hibernate-core "$HIBERNATE_VERSION" ;;
        eclipselink) jakarta_add_dependency "$file" org.eclipse.persistence eclipselink "$ECLIPSELINK_VERSION" ;;
        mojarra) jakarta_add_dependency "$file" org.glassfish jakarta.faces "$MOJARRA_VERSION" ;;
        yasson) jakarta_add_dependency "$file" org.eclipse yasson "$YASSON_VERSION" ;;
        parsson) jakarta_add_dependency "$file" org.eclipse.parsson parsson "$PARSSON_VERSION" ;;
        postgresql) jakarta_add_dependency "$file" org.postgresql postgresql 42.7.8 ;;
        mysql) jakarta_add_dependency "$file" com.mysql mysql-connector-j 9.5.0 ;;
        h2) jakarta_add_dependency "$file" com.h2database h2 2.4.240 ;;
        testcontainers) jakarta_add_dependency "$file" org.testcontainers testcontainers 1.21.3 test ;;
        mockito) jakarta_add_dependency "$file" org.mockito mockito-core 5.20.0 test ;;
        assertj) jakarta_add_dependency "$file" org.assertj assertj-core 3.27.6 test ;;
        lombok) jakarta_add_dependency "$file" org.projectlombok lombok 1.18.42 provided ;;
    esac
}

validate_jakarta_selection() {
    local profile_count=0

    if has_selected_id "core-profile" "$JAKARTA_SELECTED_FEATURES"; then
        JAKARTA_PROFILE="core"
        profile_count=$((profile_count + 1))
    fi

    if has_selected_id "web-profile" "$JAKARTA_SELECTED_FEATURES"; then
        JAKARTA_PROFILE="web"
        profile_count=$((profile_count + 1))
    fi

    if has_selected_id "platform-api" "$JAKARTA_SELECTED_FEATURES"; then
        JAKARTA_PROFILE="full"
        profile_count=$((profile_count + 1))
    fi

    if [ "$profile_count" -gt 1 ]; then
        gum_error "Select only one Jakarta EE profile from the feature list."
        exit 1
    fi

    if [ "$profile_count" -eq 0 ]; then
        JAKARTA_PROFILE="custom"
    fi

    if [ "$JAKARTA_PROFILE" = "core" ] && { [ "$JAKARTA_VERSION" = "8" ] || [ "$JAKARTA_VERSION" = "9" ] || [ "$JAKARTA_VERSION" = "9.1" ]; }; then
        gum_error "Core Profile requires Jakarta EE 10 or later."
        exit 1
    fi

    if [ "$JAVA_VERSION" = "8" ] && { [ "$JAKARTA_VERSION" = "10" ] || [ "$JAKARTA_VERSION" = "11" ]; }; then
        gum_error "Java 8 is not compatible with Jakarta EE 10 or 11."
        exit 1
    fi

    if [ "$JAVA_VERSION" = "11" ] && [ "$JAKARTA_VERSION" = "11" ]; then
        gum_error "Jakarta EE 11 requires Java 17 or 21."
        exit 1
    fi

    case "$JAKARTA_SERVER" in
        tomcat11-*)
            if [ "$JAKARTA_VERSION" != "11" ]; then
                gum_error "Tomcat 11 is for Jakarta EE 11."
                exit 1
            fi
            ;;
        tomcat101-*)
            if [ "$JAKARTA_VERSION" != "10" ]; then
                gum_error "Tomcat 10.1 is for Jakarta EE 10."
                exit 1
            fi
            ;;
        tomcat10-*)
            if [ "$JAKARTA_VERSION" != "9.1" ] && [ "$JAKARTA_VERSION" != "9" ]; then
                gum_error "Tomcat 10 is for Jakarta EE 9/9.1."
                exit 1
            fi
            ;;
        tomcat9-*)
            if [ "$JAKARTA_VERSION" != "8" ]; then
                gum_error "Tomcat 9 uses Java EE 8 javax APIs."
                exit 1
            fi
            ;;
        tomee)
            if { [ "$JAKARTA_PROFILE" != "web" ] && [ "$JAKARTA_PROFILE" != "custom" ]; } || { [ "$JAKARTA_VERSION" != "8" ] && [ "$JAKARTA_VERSION" != "9.1" ]; }; then
                gum_error "TomEE supports Web Profile/custom web specs for Java EE 8 or Jakarta EE 9.1 in this generator."
                exit 1
            fi
            ;;
    esac
}

