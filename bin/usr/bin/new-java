# ============================================================================
# Main Script
# ============================================================================

# Show help if requested
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << 'EOF'
 Java Project Generator

Usage: 
  new-java                        - Interactive mode (all prompts)
  new-java <project-name>         - Skip project name prompt
  new-java <project-name> <Main>  - Skip project name and main class prompts

Examples:
  new-java                        - Fully interactive
  new-java my-app                 - Use "my-app" as project name
  new-java my-app MyApplication   - Use "my-app" and "MyApplication" as main class

Options:
  -h, --help                      - Show this help message

EOF
    exit 0
fi

# Parse command-line arguments
ARG_PROJECT_NAME="$1"
ARG_MAIN_CLASS="$2"

# Check dependencies
check_command gum "brew install gum or pacman -S gum"
check_command fzf "brew install fzf or pacman -S fzf"
check_command mvn "brew install maven or pacman -S maven"

# Welcome screen
gum_header " Java Project Generator" "Create Maven, JavaFX, Spring Boot, or Jakarta EE projects"

echo ""

# Project type selection
PROJECT_TYPE=$(gum choose \
    --header.foreground "$GOLD" \
    --cursor.foreground "$IRIS" \
    --selected.foreground "$FOAM" \
    --header " Select project type:" \
    " Maven (Standard Java)" \
    " JavaFX (GUI Application)" \
    " Spring Boot (Web/API)" \
    " Jakarta EE (Enterprise/Web)")

# Remove nerd font prefix for processing
# Extract just the key identifier: Maven, JavaFX, Spring, or Jakarta
PROJECT_TYPE_CLEAN=$(echo "$PROJECT_TYPE" | sed 's/^[[:space:]]*//' | sed 's/ (.*//' | awk '{print $1}')

echo ""
gum_section " Project Configuration"
echo ""

# Get project name with validation
if [ -n "$ARG_PROJECT_NAME" ]; then
    # Use argument if provided
    PROJECT_NAME="$ARG_PROJECT_NAME"
    
    # Validate the provided name
    if ! validate_project_name "$PROJECT_NAME"; then
        gum_error "Invalid project name: $PROJECT_NAME"
        gum_error "Use lowercase letters, numbers, and hyphens only."
        exit 1
    fi
    
    gum_info "Using project name: $PROJECT_NAME"
    echo ""
else
    # Interactive prompt
    while true; do
        PROJECT_NAME=$(gum input \
            --prompt.foreground "$FOAM" \
            --placeholder "my-awesome-app" \
            --header " Project name (lowercase, alphanumeric, hyphens):" \
            --header.foreground "$SUBTLE" \
            --prompt " ")
        
        if [ -z "$PROJECT_NAME" ]; then
            gum_error "Project name cannot be empty"
            continue
        fi
        
        if ! validate_project_name "$PROJECT_NAME"; then
            gum_error "Invalid name. Use lowercase letters, numbers, and hyphens only."
            continue
        fi
        
        break
    done
fi

# Get main class name (context-aware)
if [ "$PROJECT_TYPE_CLEAN" = "Maven" ]; then
    DEFAULT_MAIN="Main"
elif [ "$PROJECT_TYPE_CLEAN" = "JavaFX" ]; then
    DEFAULT_MAIN="App"
fi

if [ "$PROJECT_TYPE_CLEAN" != "Spring" ] && [ "$PROJECT_TYPE_CLEAN" != "Jakarta" ]; then
    if [ -n "$ARG_MAIN_CLASS" ]; then
        # Use argument if provided
        MAIN_CLASS="$ARG_MAIN_CLASS"
        
        # Validate the provided class name
        if ! validate_class_name "$MAIN_CLASS"; then
            gum_error "Invalid main class name: $MAIN_CLASS"
            gum_error "Use PascalCase (e.g., MyApp, MainClass)."
            exit 1
        fi
        
        gum_info "Using main class: $MAIN_CLASS"
        echo ""
    else
        # Interactive prompt
        echo ""
        while true; do
            MAIN_CLASS=$(gum input \
                --prompt.foreground "$FOAM" \
                --placeholder "$DEFAULT_MAIN" \
                --value "$DEFAULT_MAIN" \
                --header " Main class name (PascalCase):" \
                --header.foreground "$SUBTLE" \
                --prompt " ")
            
            if [ -z "$MAIN_CLASS" ]; then
                MAIN_CLASS="$DEFAULT_MAIN"
            fi
            
            if ! validate_class_name "$MAIN_CLASS"; then
                gum_error "Invalid class name. Use PascalCase (e.g., MyApp, MainClass)."
                continue
            fi
            
            break
        done
    fi
fi

# JavaFX structure selection
if [ "$PROJECT_TYPE_CLEAN" = "JavaFX" ]; then
    echo ""
    JAVAFX_STRUCTURE=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header " Select JavaFX structure:" \
        " Basic (No FXML)" \
        " FXML")
    JAVAFX_STRUCTURE_CLEAN=$(echo "$JAVAFX_STRUCTURE" | sed 's/^[[:space:]]*//' | sed 's/ (.*//')
fi

# Spring Boot specific inputs
if [ "$PROJECT_TYPE_CLEAN" = "Spring" ]; then
    echo ""
    APP_NAME=$(gum input \
        --prompt.foreground "$FOAM" \
        --placeholder "$PROJECT_NAME" \
        --value "$PROJECT_NAME" \
        --header " Application name:" \
        --header.foreground "$SUBTLE" \
        --prompt " ")
    
    echo ""
    DESCRIPTION=$(gum input \
        --prompt.foreground "$FOAM" \
        --placeholder "Demo project for Spring Boot" \
        --value "Demo project for Spring Boot" \
        --header " Description:" \
        --header.foreground "$SUBTLE" \
        --prompt " ")
fi

# Jakarta EE specific inputs
if [ "$PROJECT_TYPE_CLEAN" = "Jakarta" ]; then
    echo ""
    JAKARTA_TEMPLATE=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header " Select Jakarta EE template:" \
        " Web application" \
        " REST service" \
        " Library")
    JAKARTA_TEMPLATE=$(trim "$JAKARTA_TEMPLATE")

    echo ""
    JAKARTA_VERSION_LABEL=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header " Select Jakarta EE version:" \
        " Jakarta EE 11" \
        " Jakarta EE 10" \
        " Jakarta EE 9.1" \
        " Jakarta EE 9" \
        " Java EE 8 (javax)")
    JAKARTA_VERSION=$(normalize_jakarta_version "$(trim "$JAKARTA_VERSION_LABEL")")

    echo ""
    JAVA_VERSION=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header " Select Java SE version:" \
        "21" \
        "17" \
        "11" \
        "8")
    JAVA_VERSION=$(trim "$JAVA_VERSION")

    echo ""
    JAKARTA_SERVER_LABEL=$(gum choose \
        --header.foreground "$GOLD" \
        --cursor.foreground "$IRIS" \
        --selected.foreground "$FOAM" \
        --header " Select application server/runtime:" \
        " None" \
        " Tomcat 11 local server" \
        " Tomcat 11 remote client" \
        " Tomcat 10.1 local server" \
        " Tomcat 10.1 remote client" \
        " Tomcat 10 local server" \
        " Tomcat 10 remote client" \
        " Tomcat 9 local server" \
        " Tomcat 9 remote client" \
        " GlassFish" \
        " Payara" \
        " WildFly" \
        " Open Liberty" \
        " TomEE")
    JAKARTA_SERVER=$(normalize_jakarta_server "$(trim "$JAKARTA_SERVER_LABEL")")

    jakarta_set_versions

    case "$JAKARTA_TEMPLATE" in
        "REST service")
            JAKARTA_DEFAULT_FEATURES="servlet jax-rs jersey-server jersey-json jersey-hk2 cdi weld-se"
            ;;
        "Web application")
            JAKARTA_DEFAULT_FEATURES="servlet jsp"
            ;;
        *)
            JAKARTA_DEFAULT_FEATURES=""
            ;;
    esac

    echo ""
    gum_section " Jakarta EE Feature Selection"
    echo ""
    gum_info "Template defaults will be included automatically: $JAKARTA_DEFAULT_FEATURES"

    JAKARTA_SELECTED=$(select_database_entries \
        "$JAKARTA_FEATURE_DATABASE" \
        " Select Jakarta EE profile/features (TAB=multi-select, ENTER=confirm): " \
        "Optional: select one broad profile. Or select individual web, REST, enterprise APIs, implementations, databases, and testing.")

    JAKARTA_SELECTED_FEATURES="$JAKARTA_DEFAULT_FEATURES"
    if [ -n "$JAKARTA_SELECTED" ]; then
        while IFS= read -r display_line; do
            feature_id=$(echo "$display_line" | cut -d'|' -f2)
            if [ -n "$feature_id" ]; then
                JAKARTA_SELECTED_FEATURES="$JAKARTA_SELECTED_FEATURES $feature_id"
            fi
        done <<< "$JAKARTA_SELECTED"
    fi

    if [[ "$JAKARTA_SERVER" == tomcat* ]] && [ "$JAKARTA_TEMPLATE" != "Library" ]; then
        JAKARTA_SELECTED_FEATURES="$JAKARTA_SELECTED_FEATURES servlet"
    fi

    validate_jakarta_selection
fi

# Set base package
GROUP_ID="dev.quietghost"

# Calculate package name for Spring Boot
if [ "$PROJECT_TYPE_CLEAN" = "Spring" ]; then
    PACKAGE_NAME="$GROUP_ID.${PROJECT_NAME//-/}"
fi

# Calculate package name for Jakarta EE
if [ "$PROJECT_TYPE_CLEAN" = "Jakarta" ]; then
    PACKAGE_NAME="$GROUP_ID.${PROJECT_NAME//-/}"
fi

echo ""
gum_section " Project Summary"
echo ""

# Display summary
gum style \
    --border "rounded" \
    --border-foreground "$PINE" \
    --padding "1 2" \
    --margin "0 2" \
    "$(gum style --foreground "$FOAM" "Type:") $PROJECT_TYPE_CLEAN" \
    "$(gum style --foreground "$FOAM" "Name:") $PROJECT_NAME" \
    "$(gum style --foreground "$FOAM" "Package:") $GROUP_ID" \
    "$(if [ "$PROJECT_TYPE_CLEAN" = "JavaFX" ]; then echo "$(gum style --foreground "$FOAM" "Structure:") $JAVAFX_STRUCTURE_CLEAN"; fi)" \
    "$(if [ "$PROJECT_TYPE_CLEAN" = "Jakarta" ]; then echo "$(gum style --foreground "$FOAM" "Template:") $JAKARTA_TEMPLATE"; fi)" \
    "$(if [ "$PROJECT_TYPE_CLEAN" = "Jakarta" ]; then echo "$(gum style --foreground "$FOAM" "Jakarta EE:") $JAKARTA_VERSION / $JAKARTA_PROFILE / Java $JAVA_VERSION"; fi)" \
    "$(if [ "$PROJECT_TYPE_CLEAN" = "Jakarta" ]; then echo "$(gum style --foreground "$FOAM" "Runtime:") $JAKARTA_SERVER"; fi)" \
    "$(if [ "$PROJECT_TYPE_CLEAN" = "Jakarta" ]; then echo "$(gum style --foreground "$FOAM" "Features:") $JAKARTA_SELECTED_FEATURES"; fi)" \
    "$(if [ "$PROJECT_TYPE_CLEAN" != "Spring" ] && [ "$PROJECT_TYPE_CLEAN" != "Jakarta" ]; then echo "$(gum style --foreground "$FOAM" "Main Class:") $MAIN_CLASS"; fi)"

echo ""

# Confirm before proceeding
if ! gum confirm \
    --selected.foreground "$FOAM" \
    --unselected.foreground "$LOVE" \
    --affirmative " Create Project" \
    --negative " Cancel" \
    "Proceed with project creation?"; then
    gum_error "Project creation cancelled"
    exit 0
fi

echo ""

# ============================================================================
# Project Generation
# ============================================================================

case "$PROJECT_TYPE_CLEAN" in
    "Maven")
        # Generate Maven project
        gum_info "Generating Maven project..."
        echo ""
        
        gum spin \
            --spinner dot \
            --title " Creating Maven archetype..." \
            --title.foreground "$IRIS" \
            --spinner.foreground "$FOAM" \
            -- mvn archetype:generate -B \
                -DarchetypeGroupId=org.apache.maven.archetypes \
                -DarchetypeArtifactId=maven-archetype-quickstart \
                -DarchetypeVersion=1.5 \
                -DgroupId=$GROUP_ID \
                -DartifactId=$PROJECT_NAME \
                -Dpackage=$GROUP_ID \
                -Dversion=1.0-SNAPSHOT
        
        if [ $? -ne 0 ]; then
            gum_error "Failed to create Maven project"
            exit 1
        fi
        
        cd "$PROJECT_NAME"
        
        echo ""
        gum_section " Dependency Selection"
        echo ""
        
        # Transform database for fzf
        display_list=$(echo "$MAVEN_DEPENDENCY_DATABASE" | grep -v "^#" | grep -v "^$" | awk -F'|' '{
            split($1, parts, ":")
            category = parts[5]
            gsub(/^[ \t]+|[ \t]+$/, "", category)
            description = $2
            gsub(/^[ \t]+|[ \t]+$/, "", description)
            printf "[%s] %s\n", category, description
        }')
        
        # Create temporary file for preview
        temp_db=$(mktemp)
        echo "$MAVEN_DEPENDENCY_DATABASE" > "$temp_db"
        
        selected=$(echo "$display_list" | fzf \
            --multi \
            --height=60% \
            --border=rounded \
            --prompt=" Select dependencies (TAB=multi-select, ENTER=confirm, ESC=skip): " \
            --header="Categories: TESTING, LOGGING, JSON, UTILITIES, HTTP, DATABASE, ORM, WEB, CLI, etc." \
            --preview="bash -c 'desc=\$(echo {} | sed \"s/^\\\[.*\\\] //\"); grep \"| \$desc\$\" $temp_db | cut -d\"|\" -f1 | xargs'" \
            --preview-window=down:3:wrap \
            --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
            --color='header:italic:underline' \
        ) || true
        
        rm -f "$temp_db"
        
        # Process selected dependencies
        if [ -n "$selected" ]; then
            mapfile -t selected_deps <<< "$selected"
            echo ""
            gum_info "Adding ${#selected_deps[@]} dependencies..."
            
            temp_deps=$(mktemp)
            
            for display_line in "${selected_deps[@]}"; do
                desc=$(echo "$display_line" | sed 's/^\[.*\] //')
                original_line=$(echo "$MAVEN_DEPENDENCY_DATABASE" | grep "| $desc$")
                
                if [ -z "$original_line" ]; then
                    gum_error "Warning: Could not find dependency for: $display_line"
                    continue
                fi
                
                dep_info=$(echo "$original_line" | cut -d'|' -f1 | xargs)
                group_id_dep=$(echo "$dep_info" | cut -d: -f1)
                artifact_id=$(echo "$dep_info" | cut -d: -f2)
                version=$(echo "$dep_info" | cut -d: -f3)
                scope=$(echo "$dep_info" | cut -d: -f4)
                
                echo "    <dependency>" >> "$temp_deps"
                echo "      <groupId>$group_id_dep</groupId>" >> "$temp_deps"
                echo "      <artifactId>$artifact_id</artifactId>" >> "$temp_deps"
                echo "      <version>$version</version>" >> "$temp_deps"
                
                if [ "$scope" != "compile" ]; then
                    echo "      <scope>$scope</scope>" >> "$temp_deps"
                fi
                
                echo "    </dependency>" >> "$temp_deps"
            done
            
            temp_pom=$(mktemp)
            cp pom.xml "$temp_pom"
            dep_line=$(grep -n "</dependencies>" "$temp_pom" | head -1 | cut -d: -f1)
            
            if [ -n "$dep_line" ]; then
                head -n $((dep_line - 1)) "$temp_pom" > pom.xml
                cat "$temp_deps" >> pom.xml
                tail -n +$dep_line "$temp_pom" >> pom.xml
                gum_success "Dependencies added successfully"
            fi
            
            rm -f "$temp_deps" "$temp_pom"
            
            # Lombok special handling
            if echo "$selected" | grep -q "\[UTILITIES\] Lombok"; then
                gum_info "Configuring Lombok annotation processor..."
                sed -i '/<artifactId>maven-compiler-plugin<\/artifactId>/a\
          <configuration>\
            <annotationProcessorPaths>\
              <path>\
                <groupId>org.projectlombok</groupId>\
                <artifactId>lombok</artifactId>\
                <version>1.18.36</version>\
              </path>\
            </annotationProcessorPaths>\
          </configuration>' pom.xml
            fi
        else
            echo ""
            gum_info "No additional dependencies selected (JUnit 5 is included by default)"
        fi
        
        # Update Java version to 21
        gum_info "Setting Java version to 21..."
        sed -i 's/<maven\.compiler\.release>[0-9]*<\/maven\.compiler\.release>/<maven.compiler.release>21<\/maven.compiler.release>/' pom.xml
        sed -i 's/<maven\.compiler\.source>[0-9]*<\/maven\.compiler\.source>/<maven.compiler.source>21<\/maven.compiler.source>/' pom.xml
        sed -i 's/<maven\.compiler\.target>[0-9]*<\/maven\.compiler\.target>/<maven.compiler.target>21<\/maven.compiler.target>/' pom.xml
        
        # Rename App.java if needed
        if [ "$MAIN_CLASS" != "App" ]; then
            gum_info "Renaming App.java to ${MAIN_CLASS}.java..."
            
            app_file=$(find src/main/java -name "App.java" -type f)
            
            if [ -n "$app_file" ]; then
                sed -i "s/\bApp\b/${MAIN_CLASS}/g" "$app_file"
                new_file=$(echo "$app_file" | sed "s/App\.java/${MAIN_CLASS}.java/")
                mv "$app_file" "$new_file"
                
                find src/test/java -name "*.java" -type f -exec sed -i "s/\bApp\b/${MAIN_CLASS}/g" {} \;
                
                test_file=$(find src/test/java -name "AppTest.java" -type f)
                if [ -n "$test_file" ]; then
                    sed -i "s/\bAppTest\b/${MAIN_CLASS}Test/g" "$test_file"
                    new_test_file=$(echo "$test_file" | sed "s/AppTest\.java/${MAIN_CLASS}Test.java/")
                    mv "$test_file" "$new_test_file"
                fi
                
                gum_success "Successfully renamed all App references to ${MAIN_CLASS}"
            fi
        fi
        ;;
        
    "JavaFX")
        # Generate JavaFX project
        gum_info "Generating JavaFX project..."
        echo ""
        
        package_name="${PROJECT_NAME//-/}"
        project_title=$(echo "$package_name" | sed 's/.*/\L&/; s/^./\U&/')

        if [ "$JAVAFX_STRUCTURE_CLEAN" = "FXML" ]; then
            javafx_archetype="javafx-archetype-fxml"
        else
            javafx_archetype="javafx-archetype-simple"
        fi
        
        gum spin \
            --spinner dot \
            --title " Creating JavaFX archetype..." \
            --title.foreground "$IRIS" \
            --spinner.foreground "$FOAM" \
            -- mvn archetype:generate -B \
                -DarchetypeGroupId=org.openjfx \
                -DarchetypeArtifactId=$javafx_archetype \
                -DarchetypeVersion=0.0.6 \
                -DgroupId=$GROUP_ID \
                -DartifactId=$PROJECT_NAME \
                -Dpackage=$GROUP_ID.$package_name \
                -Dversion=1.0-SNAPSHOT \
                -Djavafx-version=21
        
        if [ $? -ne 0 ]; then
            gum_error "Failed to create JavaFX project"
            exit 1
        fi
        
        cd "$PROJECT_NAME"

        app_file=$(find src/main/java -name "App.java" -type f)

        if [ "$JAVAFX_STRUCTURE_CLEAN" = "Basic" ] && [ -n "$app_file" ]; then
            cat > "$app_file" << EOF
package $GROUP_ID.$package_name;

import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.layout.Pane;
import javafx.stage.Stage;

public class App extends Application {
    @Override
    public void start(Stage primaryStage) {
        Pane root = new Pane();
        Scene scene = new Scene(root, 640, 480);
        primaryStage.setTitle("$project_title");
        primaryStage.setScene(scene);
        primaryStage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
EOF
        fi
        
        # Rename App.java if custom main class specified
        if [ "$MAIN_CLASS" != "App" ]; then
            gum_info "Renaming App.java to ${MAIN_CLASS}.java..."
            
            app_file=$(find src/main/java -name "App.java" -type f)
            if [ -n "$app_file" ]; then
                sed -i "s/\bApp\b/${MAIN_CLASS}/g" "$app_file"
                new_file=$(echo "$app_file" | sed "s/App\.java/${MAIN_CLASS}.java/")
                mv "$app_file" "$new_file"
                
                find src/main/java -name "*.java" -type f -exec sed -i "s/\bApp\b/${MAIN_CLASS}/g" {} \;
                
                if [ -f "src/main/java/module-info.java" ]; then
                    sed -i "s/\bApp\b/${MAIN_CLASS}/g" src/main/java/module-info.java
                fi
                
                sed -i "s/\bApp\b/${MAIN_CLASS}/g" pom.xml

                if [ "$JAVAFX_STRUCTURE_CLEAN" = "FXML" ]; then
                    find src/main/resources -name "*.fxml" -type f -exec sed -i "s/\bApp\b/${MAIN_CLASS}/g" {} \;
                fi
                
                gum_success "Successfully renamed all App references to ${MAIN_CLASS}"
            fi
        fi

        sed -i "/<\/properties>/i\        <javafx.mainClass>$GROUP_ID.$package_name.$MAIN_CLASS</javafx.mainClass>" pom.xml
        sed -i 's|<mainClass>.*</mainClass>|<mainClass>${javafx.mainClass}</mainClass>|' pom.xml
        ;;

    "Jakarta")
        gum_info "Generating Jakarta EE project..."
        echo ""

        if [ -d "$PROJECT_NAME" ]; then
            echo ""
            if ! gum confirm \
                --selected.foreground "$FOAM" \
                --unselected.foreground "$LOVE" \
                "Directory '$PROJECT_NAME' exists. Overwrite?"; then
                gum_error "Cancelled"
                exit 0
            fi
            rm -rf "$PROJECT_NAME"
        fi

        mkdir -p "$PROJECT_NAME"
        cd "$PROJECT_NAME"

        PACKAGE_PATH="${PACKAGE_NAME//./\/}"
        CLASS_BASE=$(pascal_case "$PROJECT_NAME")
        ARTIFACT_PACKAGING="war"

        if [ "$JAKARTA_TEMPLATE" = "Library" ]; then
            ARTIFACT_PACKAGING="jar"
        fi

        mkdir -p "src/main/java/$PACKAGE_PATH" "src/test/java/$PACKAGE_PATH"
        if [ "$ARTIFACT_PACKAGING" = "war" ]; then
            mkdir -p src/main/webapp/WEB-INF
        fi

        deps_file=$(mktemp)
        JAKARTA_DEP_KEYS=""

        if [ "$JAKARTA_TEMPLATE" != "Library" ]; then
            case "$JAKARTA_PROFILE" in
                core) jakarta_add_feature_dependency core-profile "$deps_file" ;;
                web) jakarta_add_feature_dependency web-profile "$deps_file" ;;
                full) jakarta_add_feature_dependency platform-api "$deps_file" ;;
            esac
        fi

        for feature in $JAKARTA_SELECTED_FEATURES; do
            jakarta_add_feature_dependency "$feature" "$deps_file"
        done

        jakarta_add_dependency "$deps_file" org.junit.jupiter junit-jupiter-api "\${junit.version}" test
        jakarta_add_dependency "$deps_file" org.junit.jupiter junit-jupiter-engine "\${junit.version}" test

        deps_xml=$(cat "$deps_file")
        rm -f "$deps_file"

        cat > pom.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>$GROUP_ID</groupId>
    <artifactId>$PROJECT_NAME</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>$PROJECT_NAME</name>
    <packaging>$ARTIFACT_PACKAGING</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.target>$JAVA_VERSION</maven.compiler.target>
        <maven.compiler.source>$JAVA_VERSION</maven.compiler.source>
        <junit.version>5.13.2</junit.version>
    </properties>

    <dependencies>
$deps_xml
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
EOF

        if [ "$ARTIFACT_PACKAGING" = "war" ]; then
            cat >> pom.xml << EOF
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
EOF
        fi

        cat >> pom.xml << EOF
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
EOF

        if [ "$ARTIFACT_PACKAGING" = "war" ]; then
            if [ "$JAKARTA_VERSION" = "8" ]; then
                cat > src/main/webapp/WEB-INF/web.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
</web-app>
EOF
            else
                cat > src/main/webapp/WEB-INF/web.xml << EOF
<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
</web-app>
EOF
            fi
        fi

        if [ "$JAKARTA_TEMPLATE" = "Web application" ]; then
            cat > "src/main/java/$PACKAGE_PATH/HelloServlet.java" << EOF
package $PACKAGE_NAME;

import java.io.*;

import $EE_IMPORT_PACKAGE.servlet.http.*;
import $EE_IMPORT_PACKAGE.servlet.annotation.*;

@WebServlet(name = "helloServlet", value = "/hello-servlet")
public class HelloServlet extends HttpServlet {
    private String message;

    public void init() {
        message = "Hello World!";
    }

    public void doGet(HttpServletRequest request, HttpServletResponse response) throws IOException {
        response.setContentType("text/html");

        // Hello
        PrintWriter out = response.getWriter();
        out.println("<html><body>");
        out.println("<h1>" + message + "</h1>");
        out.println("</body></html>");
    }

    public void destroy() {
    }
}
EOF

            cat > src/main/webapp/index.jsp << EOF
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html>
<head>
    <title>JSP - Hello World</title>
</head>
<body>
<h1><%= "Hello World!" %>
</h1>
<br/>
<a href="hello-servlet">Hello Servlet</a>
</body>
</html>
EOF
        elif [ "$JAKARTA_TEMPLATE" = "REST service" ]; then
            cat > "src/main/java/$PACKAGE_PATH/HelloApplication.java" << EOF
package $PACKAGE_NAME;

import $EE_IMPORT_PACKAGE.ws.rs.ApplicationPath;
import $EE_IMPORT_PACKAGE.ws.rs.core.Application;

@ApplicationPath("/api")
public class HelloApplication extends Application {
}
EOF

            cat > "src/main/java/$PACKAGE_PATH/HelloResource.java" << EOF
package $PACKAGE_NAME;

import $EE_IMPORT_PACKAGE.ws.rs.GET;
import $EE_IMPORT_PACKAGE.ws.rs.Path;
import $EE_IMPORT_PACKAGE.ws.rs.Produces;
import $EE_IMPORT_PACKAGE.ws.rs.core.MediaType;

@Path("/hello-world")
public class HelloResource {
    @GET
    @Produces(MediaType.TEXT_PLAIN)
    public String hello() {
        return "Hello, World!";
    }
}
EOF

            cat > src/main/webapp/index.html << EOF
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>$PROJECT_NAME</title>
</head>
<body>
<h1>Jakarta EE REST service</h1>
<p><a href="api/hello-world">GET /api/hello-world</a></p>
</body>
</html>
EOF
        else
            cat > "src/main/java/$PACKAGE_PATH/${CLASS_BASE}Library.java" << EOF
package $PACKAGE_NAME;

public final class ${CLASS_BASE}Library {
    private ${CLASS_BASE}Library() {
    }

    public static String name() {
        return "$PROJECT_NAME";
    }
}
EOF
        fi

        cat > "src/test/java/$PACKAGE_PATH/${CLASS_BASE}Test.java" << EOF
package $PACKAGE_NAME;

import static org.junit.jupiter.api.Assertions.assertTrue;

import org.junit.jupiter.api.Test;

class ${CLASS_BASE}Test {
    @Test
    void projectIsGenerated() {
        assertTrue(true);
    }
}
EOF

        cat > .gitignore << 'EOF'
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.kotlin

### IntelliJ IDEA ###
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
*.iws
*.iml
*.ipr

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/

### Mac OS ###
.DS_Store
EOF

        gum spin \
            --spinner dot \
            --title " Adding Maven wrapper..." \
            --title.foreground "$IRIS" \
            --spinner.foreground "$FOAM" \
            -- mvn -q -N wrapper:wrapper -Dmaven=3.9.6

        cat > README.md << EOF
# $PROJECT_NAME

Generated Jakarta EE project.

- Template: $JAKARTA_TEMPLATE
- Jakarta EE version: $JAKARTA_VERSION
- Profile/API scope: $JAKARTA_PROFILE
- Java version: $JAVA_VERSION
- Runtime: $JAKARTA_SERVER
- Features: $JAKARTA_SELECTED_FEATURES

## Build

\`mvn clean package\`
EOF

        if [ "$JAKARTA_TEMPLATE" = "REST service" ]; then
            cat >> README.md << EOF

## Endpoint

\`/api/hello-world\`
EOF
        elif [ "$JAKARTA_TEMPLATE" = "Web application" ]; then
            cat >> README.md << EOF

## Endpoint

\`/hello-servlet\`
EOF
        fi

        if [[ "$JAKARTA_SERVER" == tomcat*-local ]]; then
            cat >> README.md << EOF

## Run On Local Tomcat

Configure Tomcat in your IDE, or use this dotfiles Neovim Java runner from inside the project:

\`<leader>jf\`
EOF
        elif [[ "$JAKARTA_SERVER" == tomcat*-remote ]]; then
            cat >> README.md << EOF

## Deploy To Remote Tomcat

Build the WAR with \`mvn clean package\`, then deploy \`target/$PROJECT_NAME-1.0-SNAPSHOT.war\` with your Tomcat Manager or IDE run configuration.
EOF
        fi

        gum_success "Jakarta EE project generated"
        ;;

    "Spring")
        # Check Spring CLI
        check_command spring "sdk install springboot"
        
        # Validate artifact
        if ! validate_project_name "$PROJECT_NAME"; then
            gum_error "Invalid artifact name for Spring Boot"
            exit 1
        fi
        
        # Check if directory exists
        if [ -d "$PROJECT_NAME" ]; then
            echo ""
            if ! gum confirm \
                --selected.foreground "$FOAM" \
                --unselected.foreground "$LOVE" \
                "Directory '$PROJECT_NAME' exists. Overwrite?"; then
                gum_error "Cancelled"
                exit 0
            fi
            rm -rf "$PROJECT_NAME"
        fi
        
        echo ""
        gum_section " Dependency Selection"
        echo ""
        
        # Transform database for fzf
        display_list=$(echo "$SPRING_DEPENDENCY_DATABASE" | grep -v "^#" | grep -v "^$" | awk -F'|' '{
            split($1, parts, ":")
            dep_id = parts[1]
            category = parts[2]
            gsub(/^[ \t]+|[ \t]+$/, "", category)
            description = $2
            gsub(/^[ \t]+|[ \t]+$/, "", description)
            printf "[%s] %s|%s\n", category, description, dep_id
        }')
        
        temp_db=$(mktemp)
        echo "$SPRING_DEPENDENCY_DATABASE" > "$temp_db"
        
        selected=$(echo "$display_list" | fzf \
            --multi \
            --height=60% \
            --border=rounded \
            --prompt=" Select starters (TAB=multi-select, ENTER=confirm, ESC=skip): " \
            --header="Spring Boot Starters - Categories: WEB, DATABASE, SECURITY, MESSAGING, MONITORING, etc." \
            --preview="bash -c 'desc=\$(echo {} | cut -d\"|\" -f1 | sed \"s/^\\\[.*\\\] //\"); grep \"| \$desc\$\" $temp_db | cut -d\"|\" -f1 | cut -d\":\" -f1 | xargs'" \
            --preview-window=down:3:wrap \
            --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
            --color='header:italic:underline' \
        ) || true
        
        rm -f "$temp_db"
        
        # Build dependency list
        dependency_list=""
        
        if [ -n "$selected" ]; then
            mapfile -t selected_deps <<< "$selected"
            
            for display_line in "${selected_deps[@]}"; do
                dep_id=$(echo "$display_line" | cut -d'|' -f2)
                
                if [ -z "$dependency_list" ]; then
                    dependency_list="$dep_id"
                else
                    dependency_list="$dependency_list,$dep_id"
                fi
            done
            
            echo ""
            gum_info "Selected dependencies: $dependency_list"
        else
            echo ""
            gum_info "No dependencies selected (bare Spring Boot project)"
        fi
        
        # Generate project
        echo ""
        gum_info "Generating Spring Boot project..."
        echo ""
        
        spring_cmd="spring init"
        spring_cmd="$spring_cmd --build=maven"
        spring_cmd="$spring_cmd --java-version=21"
        spring_cmd="$spring_cmd --packaging=jar"
        spring_cmd="$spring_cmd --group-id=$GROUP_ID"
        spring_cmd="$spring_cmd --artifact-id=$PROJECT_NAME"
        spring_cmd="$spring_cmd --name=\"$APP_NAME\""
        spring_cmd="$spring_cmd --description=\"$DESCRIPTION\""
        spring_cmd="$spring_cmd --package-name=$PACKAGE_NAME"
        
        if [ -n "$dependency_list" ]; then
            spring_cmd="$spring_cmd --dependencies=$dependency_list"
        fi
        
        spring_cmd="$spring_cmd $PROJECT_NAME"
        
        gum spin \
            --spinner dot \
            --title " Creating Spring Boot project..." \
            --title.foreground "$IRIS" \
            --spinner.foreground "$FOAM" \
            -- bash -c "$spring_cmd"
        
        if [ $? -ne 0 ]; then
            gum_error "Failed to create Spring Boot project"
            exit 1
        fi
        
        if [ ! -d "$PROJECT_NAME" ]; then
            gum_error "Project directory was not created"
            exit 1
        fi
        
        cd "$PROJECT_NAME"
        ;;
esac

# Success message
echo ""
gum style \
    --foreground "$FOAM" \
    --border "rounded" \
    --border-foreground "$IRIS" \
    --align "center" \
    --width 60 \
    --margin "1 2" \
    --padding "1 4" \
    " Project created successfully!" \
    "" \
    " Location: $(pwd)" \
    "$(if [ "$PROJECT_TYPE_CLEAN" != "Spring" ] && [ "$PROJECT_TYPE_CLEAN" != "Jakarta" ]; then echo " Main class: ${MAIN_CLASS}.java"; fi)" \
    " Package: $GROUP_ID" \
    "" \
    "Opening in Neovim..."

echo ""

nvim .
