#!/usr/bin/env bash
# Git worktree manager - Create or switch to worktrees with multiplexer integration
# Usage: wt [--exec <command>] [--window-name <name>] [--mux <mode>] [--no-fetch] [branch-name]

set -euo pipefail

WORKTREE_DIR=".worktrees"
EXEC_COMMAND=""
EXEC_WINDOW_NAME="task"
MUX_MODE="auto"
DO_FETCH=true

declare -A BRANCH_WORKTREE_PATH=()

usage() {
  cat <<'EOF'
Usage: wt [--exec <command>] [--window-name <name>] [--mux <mode>] [--no-fetch] [branch-name]

Create or switch to a git worktree.

With no branch name: fetch remotes, then interactively pick a worktree/branch.
Remote-only branches are tracked and checked out into .worktrees/.

Options:
  -x, --exec <command>        Run command in a multiplexer tab/window
  -n, --window-name <name>    Tab/window name to use with --exec (default: task)
  -m, --mux <mode>            Integration: auto, herdr, tmux, or none (default: auto)
      --no-fetch              Skip git fetch before listing/selecting
  -h, --help                  Show this help message
EOF
}

require_gum() {
  if ! command -v gum >/dev/null 2>&1; then
    printf 'Error: gum is required\n' >&2
    exit 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -x|--exec)
      if [[ $# -lt 2 ]]; then
        printf 'Error: %s requires a command\n' "$1" >&2
        exit 1
      fi
      EXEC_COMMAND="$2"
      shift 2
      ;;
    -n|--window-name)
      if [[ $# -lt 2 ]]; then
        printf 'Error: %s requires a window name\n' "$1" >&2
        exit 1
      fi
      EXEC_WINDOW_NAME="$2"
      shift 2
      ;;
    -m|--mux)
      if [[ $# -lt 2 ]]; then
        printf 'Error: %s requires a mode\n' "$1" >&2
        exit 1
      fi
      MUX_MODE="$2"
      case "$MUX_MODE" in
        auto|herdr|tmux|none) ;;
        *)
          printf 'Error: invalid mux mode %s (expected auto, herdr, tmux, or none)\n' "$MUX_MODE" >&2
          exit 1
          ;;
      esac
      shift 2
      ;;
    --no-fetch)
      DO_FETCH=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'Error: unknown option %s\n' "$1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -gt 1 ]]; then
  printf 'Error: expected at most one branch name\n' >&2
  exit 1
fi

session_name_for_branch() {
  local branch_name="$1"

  printf '%s\n' "${branch_name//\//-}"
}

worktree_path_for_branch() {
  local branch_name="$1"

  case "$branch_name" in
    issue/*)
      printf '%s/issue/%s\n' "$WORKTREE_DIR" "${branch_name#issue/}"
      ;;
    pr/*)
      printf '%s/pr/%s\n' "$WORKTREE_DIR" "${branch_name#pr/}"
      ;;
    issue-*)
      printf '%s/issue/%s\n' "$WORKTREE_DIR" "${branch_name#issue-}"
      ;;
    pr-*)
      printf '%s/pr/%s\n' "$WORKTREE_DIR" "${branch_name#pr-}"
      ;;
    *)
      printf '%s/%s\n' "$WORKTREE_DIR" "$branch_name"
      ;;
  esac
}

display_name_for_branch() {
  local branch_name="$1"

  case "$branch_name" in
    issue-*)
      printf 'issue/%s\n' "${branch_name#issue-}"
      ;;
    pr-*)
      printf 'pr/%s\n' "${branch_name#pr-}"
      ;;
    *)
      printf '%s\n' "$branch_name"
      ;;
  esac
}

link_or_stub_env_file() {
  local file_name="$1"
  local create_empty="${2:-true}"
  local source_path="$REPO_ROOT/$file_name"
  local target_path="$REPO_ROOT/$WORKTREE_PATH/$file_name"
  local example_path="$REPO_ROOT/${file_name}.example"

  if [ -e "$target_path" ] || [ -L "$target_path" ]; then
    return 0
  fi

  if [ -f "$source_path" ]; then
    ln -s "$source_path" "$target_path"
    echo "Linked $file_name into worktree"
    return 0
  fi

  if [ -f "$example_path" ]; then
    cp "$example_path" "$target_path"
    echo "Created placeholder $file_name from ${file_name}.example"
    return 0
  fi

  if [[ "$create_empty" == "true" ]]; then
    : > "$target_path"
    echo "Created empty placeholder $file_name"
  fi
}

allow_worktree_direnv() {
  local envrc_path="$WORKTREE_ABS_PATH/.envrc"

  if ! command -v direnv >/dev/null 2>&1; then
    return 0
  fi

  if [ ! -e "$envrc_path" ] && [ ! -L "$envrc_path" ]; then
    return 0
  fi

  if direnv allow "$envrc_path" >/dev/null 2>&1; then
    echo "Allowed direnv for worktree"
  fi
}

setup_worktree_env_files() {
  link_or_stub_env_file ".env"
  link_or_stub_env_file ".dev.vars"
  link_or_stub_env_file ".envrc" false
  allow_worktree_direnv
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

# Get repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Get project name (repo directory name)
PROJECT_NAME=$(basename "$REPO_ROOT")

# Prefer Herdr when nested unless explicitly overridden.
if [[ "$MUX_MODE" == "auto" ]]; then
  if [[ -n "${HERDR_ENV:-}" || -n "${HERDR_SOCKET_PATH:-}" ]]; then
    MUX_MODE="herdr"
  elif [[ -n "${TMUX:-}" ]]; then
    MUX_MODE="tmux"
  else
    MUX_MODE="none"
  fi
fi

if [[ "$MUX_MODE" == "herdr" ]] && ! command -v herdr >/dev/null 2>&1; then
  printf 'Error: herdr is required for --mux herdr\n' >&2
  exit 1
fi

if [[ "$MUX_MODE" == "tmux" ]] && ! command -v tmux >/dev/null 2>&1; then
  printf 'Error: tmux is required for --mux tmux\n' >&2
  exit 1
fi

# Ensure .worktrees directory exists
if [ ! -d "$WORKTREE_DIR" ]; then
  echo "Creating $WORKTREE_DIR directory..."
  mkdir -p "$WORKTREE_DIR"
fi

# Ensure .worktrees is in .gitignore
if [ -f ".gitignore" ]; then
  if ! grep -q "^${WORKTREE_DIR}/\$" .gitignore 2>/dev/null; then
    echo "Adding $WORKTREE_DIR/ to .gitignore..."
    echo "" >> .gitignore
    echo "# Git worktrees" >> .gitignore
    echo "${WORKTREE_DIR}/" >> .gitignore
  fi
else
  echo "Creating .gitignore with $WORKTREE_DIR/..."
  echo "# Git worktrees" > .gitignore
  echo "${WORKTREE_DIR}/" >> .gitignore
fi

window_name_exists() {
  local session_name="$1"
  local window_name="$2"

  tmux list-windows -t "$session_name" -F '#{window_name}' 2>/dev/null | grep -Fxq "$window_name"
}

unique_window_name() {
  local session_name="$1"
  local base_name="$2"
  local candidate="$base_name"
  local suffix=2

  while window_name_exists "$session_name" "$candidate"; do
    candidate="${base_name}-${suffix}"
    suffix=$((suffix + 1))
  done

  printf '%s\n' "$candidate"
}

ensure_tmux_session() {
  local session_name="$1"
  local worktree_path="$2"

  if tmux has-session -t "$session_name" 2>/dev/null; then
    echo "Tmux session '$session_name' already exists."
  else
    echo "Creating new tmux session: $session_name"
    tmux new-session -d -s "$session_name" -c "$worktree_path"
  fi
}

switch_to_tmux_session() {
  local session_name="$1"

  tmux switch-client -t "$session_name"
}

herdr_tab_name_exists() {
  local workspace_id="$1"
  local tab_name="$2"

  herdr tab list --workspace "$workspace_id" 2>/dev/null |
    jq -e --arg name "$tab_name" '.result.tabs[]? | select(.label == $name)' >/dev/null
}

unique_herdr_tab_name() {
  local workspace_id="$1"
  local base_name="$2"
  local candidate="$base_name"
  local suffix=2

  while herdr_tab_name_exists "$workspace_id" "$candidate"; do
    candidate="${base_name}-${suffix}"
    suffix=$((suffix + 1))
  done

  printf '%s\n' "$candidate"
}

run_command_in_herdr_workspace() {
  local workspace_id="$1"
  local worktree_path="$2"
  local command="$3"
  local requested_tab_name="$4"
  local tab_name created pane_id

  tab_name="$(unique_herdr_tab_name "$workspace_id" "$requested_tab_name")"
  echo "Opening Herdr tab '$tab_name' in workspace '$WORKTREE_DISPLAY_NAME'"
  created="$(
    herdr tab create \
      --workspace "$workspace_id" \
      --cwd "$worktree_path" \
      --label "$tab_name" \
      --focus
  )"
  pane_id="$(jq -er '.result.root_pane.pane_id' <<<"$created")"
  herdr pane run "$pane_id" "$command" >/dev/null
}

open_herdr_worktree() {
  local worktree_path="$1"
  local opened workspace_id

  if [[ -n "$EXEC_COMMAND" ]] && ! command -v jq >/dev/null 2>&1; then
    printf 'Error: jq is required for wt --exec with Herdr\n' >&2
    exit 1
  fi

  opened="$(
    herdr worktree open \
      --cwd "$REPO_ROOT" \
      --path "$worktree_path" \
      --label "$WORKTREE_DISPLAY_NAME" \
      --focus \
      --json
  )"

  if [[ -n "$EXEC_COMMAND" ]]; then
    workspace_id="$(jq -er '.result.workspace.workspace_id' <<<"$opened")"
    run_command_in_herdr_workspace \
      "$workspace_id" \
      "$worktree_path" \
      "$EXEC_COMMAND" \
      "$EXEC_WINDOW_NAME"
  fi
}

run_command_in_tmux_session() {
  local session_name="$1"
  local worktree_path="$2"
  local command="$3"
  local requested_window_name="$4"
  local window_name
  local window_index

  window_name="$(unique_window_name "$session_name" "$requested_window_name")"
  echo "Opening tmux window '$window_name' in session '$session_name'"
  window_index="$(tmux new-window -P -F '#{window_index}' -d -t "$session_name:" -n "$window_name" -c "$worktree_path" "$command")"
  tmux select-window -t "${session_name}:${window_index}"
}

open_worktree_in_mux() {
  local branch_name="$1"
  local worktree_path="$2"
  local session_name

  case "$MUX_MODE" in
    herdr)
      open_herdr_worktree "$worktree_path"
      ;;
    tmux)
      session_name="$(session_name_for_branch "$branch_name")"
      ensure_tmux_session "$session_name" "$worktree_path"
      if [[ -n "$EXEC_COMMAND" ]]; then
        run_command_in_tmux_session "$session_name" "$worktree_path" "$EXEC_COMMAND" "$EXEC_WINDOW_NAME"
      fi
      switch_to_tmux_session "$session_name"
      ;;
    none)
      if [[ -n "$EXEC_COMMAND" ]]; then
        printf 'cd %q && %s\n' "$WORKTREE_PATH" "$EXEC_COMMAND"
      else
        echo "cd $WORKTREE_PATH"
      fi
      ;;
  esac
}

fetch_remotes() {
  if [[ "$DO_FETCH" != "true" ]]; then
    return 0
  fi

  echo "Fetching remotes..."
  git fetch --all --prune
}

# Populate BRANCH_WORKTREE_PATH[branch] = absolute path
load_worktree_map() {
  BRANCH_WORKTREE_PATH=()
  local path="" branch="" bare="" detached=""

  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        path="${line#worktree }"
        branch=""
        bare=""
        detached=""
        ;;
      branch\ *)
        branch="${line#branch refs/heads/}"
        ;;
      bare)
        bare=1
        ;;
      detached)
        detached=1
        ;;
      "")
        if [[ -n "$path" && -z "$bare" && -z "$detached" && -n "$branch" ]]; then
          BRANCH_WORKTREE_PATH["$branch"]="$path"
        fi
        path=""
        branch=""
        bare=""
        detached=""
        ;;
    esac
  done < <(git worktree list --porcelain; printf '\n')
}

# Print remote-tracking refs as: <remote> <branch>
list_remote_branches() {
  local ref rest remote branch

  while IFS= read -r ref; do
    rest="${ref#refs/remotes/}"
    remote="${rest%%/*}"
    branch="${rest#*/}"
    if [[ "$branch" == "HEAD" ]]; then
      continue
    fi
    printf '%s %s\n' "$remote" "$branch"
  done < <(git for-each-ref --format='%(refname)' refs/remotes/)
}

# Prefer origin. Prints: <remote> <start-point>  e.g. origin origin/foo
find_remote_ref() {
  local branch_name="$1"
  local remote branch
  local found_remote="" found_start=""

  while read -r remote branch; do
    if [[ "$branch" != "$branch_name" ]]; then
      continue
    fi
    if [[ "$remote" == "origin" ]]; then
      printf '%s %s/%s\n' "$remote" "$remote" "$branch"
      return 0
    fi
    if [[ -z "$found_remote" ]]; then
      found_remote="$remote"
      found_start="${remote}/${branch}"
    fi
  done < <(list_remote_branches)

  if [[ -n "$found_remote" ]]; then
    printf '%s %s\n' "$found_remote" "$found_start"
    return 0
  fi

  return 1
}

select_base_branch() {
  local current_branch branches selected_base branch

  require_gum

  current_branch=$(git branch --show-current)
  branches=()
  [ -n "$current_branch" ] && branches+=("$current_branch (current)")

  if git show-ref --verify --quiet refs/heads/main; then
    [ "$current_branch" != "main" ] && branches+=("main")
  fi

  if git show-ref --verify --quiet refs/heads/master; then
    [ "$current_branch" != "master" ] && branches+=("master")
  fi

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if [[ "$branch" != "$current_branch" && "$branch" != "main" && "$branch" != "master" ]]; then
      branches+=("$branch")
    fi
  done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

  if [ ${#branches[@]} -eq 0 ]; then
    echo "Error: No branches available as base" >&2
    exit 1
  fi

  echo "Select base branch:" >&2
  selected_base=$(printf '%s\n' "${branches[@]}" | gum choose)

  if [ -z "$selected_base" ]; then
    echo "Cancelled." >&2
    exit 1
  fi

  selected_base="${selected_base% (current)}"
  printf '%s\n' "$selected_base"
}

prompt_new_branch_name() {
  local name

  require_gum
  name="$(gum input --placeholder "new-branch-name" --prompt "Branch: ")"
  if [[ -z "$name" ]]; then
    echo "Cancelled." >&2
    exit 1
  fi
  printf '%s\n' "$name"
}

pick_branch_interactively() {
  local labels=()
  local branch path remote label selected
  local -A seen=()
  local -A label_to_branch=()
  local new_label="✦  create new branch…"

  require_gum
  load_worktree_map

  for branch in "${!BRANCH_WORKTREE_PATH[@]}"; do
    path="${BRANCH_WORKTREE_PATH[$branch]}"
    if [[ "$path" == "$REPO_ROOT" ]]; then
      label=$(printf '●  %-9s  %s' "main" "$branch")
    else
      label=$(printf '●  %-9s  %s' "worktree" "$branch")
    fi
    labels+=("$label")
    label_to_branch["$label"]="$branch"
    seen["$branch"]=1
  done

  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    if [[ -n "${seen[$branch]:-}" ]]; then
      continue
    fi
    label=$(printf '○  %-9s  %s' "local" "$branch")
    labels+=("$label")
    label_to_branch["$label"]="$branch"
    seen["$branch"]=1
  done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

  while read -r remote branch; do
    [[ -z "$branch" ]] && continue
    if [[ -n "${seen[$branch]:-}" ]]; then
      continue
    fi
    label=$(printf '◌  %-9s  %s' "$remote" "$branch")
    labels+=("$label")
    label_to_branch["$label"]="$branch"
    seen["$branch"]=1
  done < <(list_remote_branches)

  labels+=("$new_label")

  selected="$(printf '%s\n' "${labels[@]}" | gum choose --height 20)"

  if [[ -z "$selected" ]]; then
    echo "Cancelled." >&2
    exit 1
  fi

  if [[ "$selected" == "$new_label" ]]; then
    prompt_new_branch_name
    return 0
  fi

  if [[ -z "${label_to_branch[$selected]:-}" ]]; then
    printf 'Error: unknown selection %s\n' "$selected" >&2
    exit 1
  fi

  printf '%s\n' "${label_to_branch[$selected]}"
}

finish_worktree() {
  if command -v mise > /dev/null 2>&1; then
    echo "Running mise trust for worktree..."
    mise trust "$WORKTREE_PATH" 2>/dev/null || true
  fi

  setup_worktree_env_files

  echo ""
  echo "✓ Worktree ready: $WORKTREE_DISPLAY_NAME"

  open_worktree_in_mux "$BRANCH_NAME" "$WORKTREE_ABS_PATH"
}

create_worktree_for_branch() {
  local remote_info remote start_point selected_base

  load_worktree_map

  # Already checked out somewhere — open that path
  if [[ -n "${BRANCH_WORKTREE_PATH[$BRANCH_NAME]:-}" ]]; then
    WORKTREE_ABS_PATH="${BRANCH_WORKTREE_PATH[$BRANCH_NAME]}"
    if [[ "$WORKTREE_ABS_PATH" == "$REPO_ROOT" ]]; then
      WORKTREE_PATH="."
    else
      WORKTREE_PATH="${WORKTREE_ABS_PATH#"$REPO_ROOT"/}"
    fi
    WORKTREE_DISPLAY_NAME="$(display_name_for_branch "$BRANCH_NAME")"
    echo "Worktree already exists at: $WORKTREE_DISPLAY_NAME"
    setup_worktree_env_files
    open_worktree_in_mux "$BRANCH_NAME" "$WORKTREE_ABS_PATH"
    exit 0
  fi

  # Path under .worktrees already present
  if [ -d "$WORKTREE_PATH" ]; then
    echo "Worktree already exists at: $WORKTREE_DISPLAY_NAME"
    setup_worktree_env_files
    open_worktree_in_mux "$BRANCH_NAME" "$WORKTREE_ABS_PATH"
    exit 0
  fi

  mkdir -p "$(dirname "$WORKTREE_ABS_PATH")"

  if git show-ref --verify --quiet "refs/heads/${BRANCH_NAME}"; then
    echo "Creating worktree from existing branch: $BRANCH_NAME"
    git worktree add "$WORKTREE_PATH" "$BRANCH_NAME"
    finish_worktree
    exit 0
  fi

  if remote_info="$(find_remote_ref "$BRANCH_NAME")"; then
    remote="${remote_info%% *}"
    start_point="${remote_info#* }"
    echo "Creating worktree tracking $remote/$BRANCH_NAME"
    git worktree add --track -b "$BRANCH_NAME" "$WORKTREE_PATH" "$start_point"
    finish_worktree
    exit 0
  fi

  echo "Branch '$BRANCH_NAME' does not exist locally or on a remote."
  echo ""
  selected_base="$(select_base_branch)"
  echo "Creating new branch '$BRANCH_NAME' from '$selected_base'..."
  git worktree add -b "$BRANCH_NAME" "$WORKTREE_PATH" "$selected_base"
  finish_worktree
}

# --- main ---

fetch_remotes

if [ -z "${1:-}" ]; then
  BRANCH_NAME="$(pick_branch_interactively)"
else
  BRANCH_NAME="$1"
fi

WORKTREE_PATH="$(worktree_path_for_branch "$BRANCH_NAME")"
WORKTREE_ABS_PATH="${REPO_ROOT}/${WORKTREE_PATH}"
WORKTREE_DISPLAY_NAME="$(display_name_for_branch "$BRANCH_NAME")"

create_worktree_for_branch
