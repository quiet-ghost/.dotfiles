#!/bin/bash

# Arch Install AI Tools Script
# Installs various AI assistants and code editors

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

# Check if a tool is already installed
check_installed() {
	local tool_name=$1
	local check_cmd=$2

	if eval "$check_cmd" &>/dev/null; then
		log_warning "$tool_name is already installed"
		return 0
	fi
	return 1
}

# Detect GPU and install appropriate Ollama version
install_ollama() {
	if check_installed "Ollama" "command -v ollama"; then
		return 0
	fi

	log_info "Detecting GPU for Ollama installation..."

	local ollama_package=""
	if command -v nvidia-smi &>/dev/null; then
		log_info "NVIDIA GPU detected, installing CUDA version..."
		ollama_package="ollama-cuda"
	elif command -v rocminfo &>/dev/null; then
		log_info "AMD GPU detected, installing ROCm version..."
		ollama_package="ollama-rocm"
	else
		log_info "No GPU detected, installing CPU version..."
		ollama_package="ollama"
	fi

	sudo pacman -S "$ollama_package" --noconfirm 2>/dev/null ||
		yay -S "$ollama_package" --noconfirm

	# Start Ollama service
	sudo systemctl enable --now ollama
	log_success "Ollama installed and service started"
}

# Main installation logic
case "${1:-}" in
    claude|claude-code)
        log_info "Installing Claude Code CLI..."
        
        # Check if already installed
        if command -v claude-code &>/dev/null; then
            log_warning "Claude Code is already installed"
            local current_version=$(claude-code --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' || echo "unknown")
            log_info "Current version: $current_version"
            echo -e "${YELLOW}To update, run:${NC} npm update -g @anthropic-ai/claude-code"
            exit 0
        fi
        
        # Install via npm (requires Node.js)
        if ! command -v npm &>/dev/null; then
            log_error "npm is not installed. Please install Node.js first."
            echo "Run: arch-install-dev-env node"
            exit 1
        fi
        
        npm install -g @anthropic-ai/claude-code
        log_success "Claude Code CLI installed successfully"
        echo -e "\n${GREEN}You can now run:${NC} claude-code --help"
        ;;

    opencode)
        log_info "Installing OpenCode CLI..."
        
        # Check if already installed
        if command -v opencode &>/dev/null; then
            log_warning "OpenCode is already installed"
            local current_version=$(opencode --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' || echo "unknown")
            log_info "Current version: $current_version"
            echo -e "${YELLOW}To update, run:${NC} npm update -g opencode-ai@latest"
            exit 0
        fi
        
        # Install via npm (requires Node.js)
        if ! command -v npm &>/dev/null; then
            log_error "npm is not installed. Please install Node.js first."
            echo "Run: arch-install-dev-env node"
            exit 1
        fi
        
        npm install -g opencode-ai@latest
        log_success "OpenCode CLI installed successfully"
        echo -e "\n${GREEN}You can now run:${NC} opencode --help"
        ;;

ollama)
	install_ollama
	echo -e "\n${GREEN}You can now run:${NC} ollama run llama2"
	echo -e "${BLUE}Popular models:${NC} llama2, codellama, mistral, phi"
	;;

lm-studio)
	if check_installed "LM Studio" "command -v lmstudio"; then
		exit 0
	fi

	log_info "Installing LM Studio..."
	yay -S lm-studio --noconfirm
	log_success "LM Studio installed successfully"
	;;

cursor)
	if check_installed "Cursor" "command -v cursor"; then
		exit 0
	fi

	log_info "Installing Cursor Editor..."
	yay -S cursor-bin --noconfirm
	log_success "Cursor installed successfully"
	;;

zed)
	if check_installed "Zed" "command -v zed"; then
		exit 0
	fi

	log_info "Installing Zed Editor..."
	sudo pacman -S zed --noconfirm 2>/dev/null || yay -S zed --noconfirm
	log_success "Zed installed successfully"
	;;

windsurf)
	if check_installed "Windsurf" "command -v windsurf"; then
		exit 0
	fi

	log_info "Installing Windsurf Editor..."
	yay -S windsurf --noconfirm
	log_success "Windsurf installed successfully"
	;;

    gemini)
        log_info "Setting up Gemini CLI..."
        
        # Install via npm
        if ! command -v npm &>/dev/null; then
            log_error "npm is not installed. Please install Node.js first."
            echo "Run: arch-install-dev-env node"
            exit 1
        fi
        
        if ! command -v gemini &>/dev/null; then
            npm install -g @google/gemini-cli
        else
            log_warning "Gemini CLI is already installed"
        fi
        
        log_success "Gemini CLI installed successfully"
        echo -e "\n${BLUE}Note:${NC} You'll need to set up your API key"
        echo -e "Visit: https://makersuite.google.com/app/apikey"
        ;;

    openai|gpt|codex)
        log_info "Setting up OpenAI Codex CLI..."
        
        # Install via npm
        if ! command -v npm &>/dev/null; then
            log_error "npm is not installed. Please install Node.js first."
            echo "Run: arch-install-dev-env node"
            exit 1
        fi
        
        if ! command -v codex &>/dev/null; then
            npm install -g @openai/codex
        else
            log_warning "OpenAI Codex is already installed"
        fi
        
        log_success "OpenAI Codex CLI installed successfully"
        echo -e "\n${GREEN}You can now run:${NC} codex --help"
        echo -e "\n${BLUE}Note:${NC} You'll need to set up your API key"
        echo -e "Export: export OPENAI_API_KEY='your-key-here'"
        ;;

crush)
	log_info "Installing Crush AI Assistant..."

	if ! command -v npm &>/dev/null; then
		log_error "npm is not installed. Please install Node.js first."
		echo "Run: arch-install-dev-env node"
		exit 1
	fi

	if ! command -v crush &>/dev/null; then
		npm install -g crush-ai
	else
		log_warning "Crush is already installed"
	fi

	log_success "Crush AI Assistant installed successfully"
	;;

*)
	log_error "Unknown AI tool: ${1:-none specified}"
	echo "Usage: $(basename "$0") <tool>"
	echo ""
        echo "Available AI Tools:"
        echo "  • claude        - Claude Code CLI (npm)"
        echo "  • opencode      - OpenCode CLI (npm)"
        echo "  • ollama        - Ollama (local LLMs)"
        echo "  • lm-studio     - LM Studio"
        echo "  • gemini        - Google Gemini CLI"
        echo "  • openai/codex  - OpenAI Codex CLI"
        echo "  • crush         - Crush AI Assistant"
	echo ""
	echo "AI-Powered Editors:"
	echo "  • cursor        - Cursor Editor"
	echo "  • zed           - Zed Editor"
	echo "  • windsurf      - Windsurf Editor"
	exit 1
	;;
esac
