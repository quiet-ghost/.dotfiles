#!/usr/bin/env bash

# Web search script using w3m and Brave Search
# Usage: ? <search query> or search <search query>

set -e

# Colors matching your theme
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Check if w3m is installed
if ! command -v w3m >/dev/null 2>&1; then
    echo -e "${RED}Error: w3m is not installed. Please install it first.${NC}"
    echo -e "${YELLOW}Install with: sudo pacman -S w3m${NC}"
    exit 1
fi

# Check if query provided
if [[ $# -eq 0 ]]; then
    echo -e "${YELLOW}Usage: $0 <search query>${NC}"
    echo -e "${YELLOW}Example: $0 arch linux installation${NC}"
    exit 1
fi

# Join all arguments into query string
query="$*"

# URL encode the query using printf for proper encoding
  encoded_query=$(printf '%s' "$query" | jq -sRr @uri 2>/dev/null || echo "${query// /%20}")

# Construct Brave Search URL (text-browser friendly)
search_url="https://search.brave.com/search?q=${encoded_query}"

# Launch w3m with theme-matched colors
echo -e "${CYAN}🔍 Searching Bing for: ${PURPLE}${query}${NC}"
w3m -o color=1 -o anchor_color="#9ccfd8" -o visited_color="#eb6f92" -o bg_color="#191724" -o basic_color="#e0def4" "${search_url}"
