#!/bin/bash

# Arch Install Development Environment Script
# Installs various development environments using mise and other tools

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

# Check if an environment is already installed
check_installed() {
    local env_name=$1
    local check_cmd=$2
    
    if eval "$check_cmd" &>/dev/null; then
        log_warning "$env_name is already installed"
        return 0
    fi
    return 1
}

# Install PHP with extensions
install_php() {
    if check_installed "PHP" "command -v php"; then
        return 0
    fi
    
    log_info "Installing PHP and Composer..."
    sudo pacman -S php composer php-sqlite --noconfirm

    # Add Composer to PATH if not already there
    if [[ ":$PATH:" != *":$HOME/.config/composer/vendor/bin:"* ]]; then
        echo 'export PATH="$HOME/.config/composer/vendor/bin:$PATH"' >> "$HOME/.zshrc"
        export PATH="$HOME/.config/composer/vendor/bin:$PATH"
        log_success "Added Composer global bin directory to PATH"
    fi

    # Enable PHP extensions
    local php_ini_path="/etc/php/php.ini"
    local extensions=("bcmath" "intl" "iconv" "openssl" "pdo_sqlite" "pdo_mysql")
    
    for ext in "${extensions[@]}"; do
        sudo sed -i "s/^;extension=${ext}/extension=${ext}/" "$php_ini_path"
    done
    
    log_success "PHP and Composer installed successfully"
}

# Install Node.js
install_node() {
    if check_installed "Node.js" "mise which node 2>/dev/null"; then
        return 0
    fi
    
    log_info "Installing Node.js LTS..."
    mise use --global node@lts
    log_success "Node.js installed successfully"
}

# Main installation logic
case "${1:-}" in
    ruby|rails)
        if check_installed "Ruby" "mise which ruby 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Ruby..."
        mise use --global ruby@latest
        mise settings add idiomatic_version_file_enable_tools ruby
        mise x ruby -- gem install rails --no-document
        log_success "Ruby on Rails installed successfully"
        echo -e "\n${GREEN}You can now run:${NC} rails new myproject"
        ;;
        
    node|nodejs)
        install_node
        ;;
        
    bun)
        if check_installed "Bun" "mise which bun 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Bun..."
        mise use --global bun@latest
        log_success "Bun installed successfully"
        ;;
        
    deno)
        if check_installed "Deno" "mise which deno 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Deno..."
        mise use --global deno@latest
        log_success "Deno installed successfully"
        ;;
        
    go|golang)
        if check_installed "Go" "mise which go 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Go..."
        mise use --global go@latest
        log_success "Go installed successfully"
        ;;
        
    php)
        install_php
        ;;
        
    laravel)
        log_info "Installing Laravel..."
        install_php
        install_node
        if ! command -v laravel &>/dev/null; then
            composer global require laravel/installer
        fi
        log_success "Laravel installed successfully"
        echo -e "\n${GREEN}You can now run:${NC} laravel new myproject"
        ;;
        
    symfony)
        log_info "Installing Symfony..."
        install_php
        if ! command -v symfony &>/dev/null; then
            curl -1sLf 'https://dl.cloudsmith.io/public/symfony/stable/setup.rpm.sh' | sudo -E bash
            sudo pacman -S symfony-cli --noconfirm 2>/dev/null || yay -S symfony-cli --noconfirm
        fi
        log_success "Symfony installed successfully"
        echo -e "\n${GREEN}You can now run:${NC} symfony new --webapp myproject"
        ;;
        
    python)
        if check_installed "Python" "mise which python 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Python..."
        mise use --global python@latest
        
        # Install uv if not present
        if ! command -v uv &>/dev/null; then
            log_info "Installing uv (Python package manager)..."
            curl -LsSf https://astral.sh/uv/install.sh | sh
        fi
        log_success "Python and uv installed successfully"
        ;;
        
    elixir)
        if check_installed "Elixir" "mise which elixir 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Elixir..."
        mise use --global erlang@latest
        mise use --global elixir@latest
        mise x elixir -- mix local.hex --force
        log_success "Elixir installed successfully"
        ;;
        
    phoenix)
        log_info "Installing Phoenix Framework..."
        # Ensure Erlang/Elixir are installed
        if ! mise which elixir &>/dev/null; then
            mise use --global erlang@latest
            mise use --global elixir@latest
        fi
        # Install Hex & Rebar
        mise x elixir -- mix local.hex --force
        mise x elixir -- mix local.rebar --force
        # Install Phoenix
        mise x elixir -- mix archive.install hex phx_new --force
        log_success "Phoenix Framework installed successfully"
        echo -e "\n${GREEN}You can now run:${NC} mix phx.new my_app"
        ;;
        
    rust)
        if check_installed "Rust" "command -v rustc"; then
            exit 0
        fi
        log_info "Installing Rust..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
        source "$HOME/.cargo/env"
        log_success "Rust installed successfully"
        ;;
        
    java)
        if check_installed "Java" "mise which java 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Java..."
        mise use --global java@latest
        log_success "Java installed successfully"
        ;;
        
    zig)
        if check_installed "Zig" "mise which zig 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing Zig..."
        mise use --global zig@latest
        log_success "Zig installed successfully"
        ;;
        
    ocaml)
        if check_installed "OCaml" "command -v opam"; then
            exit 0
        fi
        log_info "Installing OCaml..."
        bash -c "$(curl -fsSL https://raw.githubusercontent.com/ocaml/opam/master/shell/install.sh)"
        opam init --yes
        eval "$(opam env)"
        opam install ocaml-lsp-server odoc ocamlformat utop --yes
        log_success "OCaml installed successfully"
        ;;
        
    dotnet|net)
        if check_installed ".NET" "mise which dotnet 2>/dev/null"; then
            exit 0
        fi
        log_info "Installing .NET..."
        mise use --global dotnet@latest
        log_success ".NET installed successfully"
        ;;
        
    *)
        log_error "Unknown environment: ${1:-none specified}"
        echo "Usage: $(basename "$0") <environment>"
        echo ""
        echo "Available environments:"
        echo "  • ruby/rails    - Ruby on Rails"
        echo "  • node/nodejs   - Node.js LTS"
        echo "  • bun           - Bun runtime"
        echo "  • deno          - Deno runtime"
        echo "  • go/golang     - Go language"
        echo "  • php           - PHP with Composer"
        echo "  • laravel       - Laravel framework"
        echo "  • symfony       - Symfony framework"
        echo "  • python        - Python with uv"
        echo "  • elixir        - Elixir language"
        echo "  • phoenix       - Phoenix framework"
        echo "  • rust          - Rust language"
        echo "  • java          - Java"
        echo "  • zig           - Zig language"
        echo "  • ocaml         - OCaml language"
        echo "  • dotnet/net    - .NET SDK"
        exit 1
        ;;
esac