#!/usr/bin/env bash
# Git worktree lister - Show all worktrees with formatting
# Usage: wl

set -euo pipefail

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Error: Not in a git repository"
  exit 1
fi

# Get repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

echo "=== Git Worktrees ==="
echo ""

# Run git worktree list and format it
git worktree list | while IFS= read -r line; do
  path="${line%% *}"

  if [ "$path" = "$REPO_ROOT" ]; then
    printf '→ main\t%s\n' "$line"
  elif [[ "$path" == "$REPO_ROOT/.worktrees/"* ]]; then
    name="${path#"$REPO_ROOT/.worktrees/"}"
    printf '  %s\t%s\n' "$name" "$line"
  else
    printf '  %s\n' "$line"
  fi
done

echo ""
