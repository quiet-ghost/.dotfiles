#!/usr/bin/env bash

# Hypridle launcher - Detects device type and launches with appropriate config
# Syncs across devices via stow - automatically configures for laptop vs desktop

set -euo pipefail

log_info() {
    echo "[hypridle-launcher] $1" >&2
}

# Laptop = BAT* power supply. Ignore peripherals (e.g. hidpp_battery_*).
detect_device_type() {
    if compgen -G '/sys/class/power_supply/BAT*' >/dev/null; then
        echo "laptop"
    else
        echo "desktop"
    fi
}

# Laptop: screensaver @ 15m, then lock / dpms / suspend
generate_laptop_config() {
    cat <<'EOF'
general {
    lock_cmd = omarchy-system-lock
    before_sleep_cmd = OMARCHY_LOCK_ONLY=true omarchy-system-lock
    after_sleep_cmd = sleep 1 && omarchy-system-wake
    inhibit_sleep = 3
}

# Screensaver after 15 minutes
listener {
    timeout = 900
    on-timeout = pidof hyprlock || omarchy-launch-screensaver
}

# Lock shortly after screensaver start (near-simultaneous before idle reset)
listener {
    timeout = 902
    on-timeout = omarchy-system-lock
    on-resume = omarchy-system-wake
}

# Screen off after 18 minutes
listener {
    timeout = 1080
    on-timeout = hyprctl dispatch dpms off
    on-resume = omarchy-system-wake
}

# Suspend after 25 minutes
listener {
    timeout = 1500
    on-timeout = systemctl suspend
}
EOF
}

# Desktop: no automatic idle actions (dummy listener keeps hypridle happy)
generate_desktop_config() {
    cat <<'EOF'
general {
    lock_cmd = omarchy-system-lock
    before_sleep_cmd = OMARCHY_LOCK_ONLY=true omarchy-system-lock
    after_sleep_cmd = sleep 1 && omarchy-system-wake
    inhibit_sleep = 3
}

# Desktop: no screensaver / lock / dpms / suspend.
# hypridle errors on zero listeners; keep an unreachable no-op rule.
listener {
    timeout = 2147483647
    on-timeout = true
}
EOF
}

main() {
    local device_type config_dir config_file
    device_type=$(detect_device_type)
    config_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hypridle"
    config_file="$config_dir/hypridle.conf"

    mkdir -p "$config_dir"

    log_info "device=$device_type"

    if [ "$device_type" = "laptop" ]; then
        generate_laptop_config >"$config_file"
    else
        generate_desktop_config >"$config_file"
    fi

    # Drop stock hypridle started via PATH that prefers /usr/bin
    if pgrep -x hypridle >/dev/null; then
        log_info "stopping existing hypridle"
        pkill -x hypridle || true
        sleep 0.3
    fi

    log_info "exec /usr/bin/hypridle -c $config_file"
    exec /usr/bin/hypridle -c "$config_file"
}

main "$@"
