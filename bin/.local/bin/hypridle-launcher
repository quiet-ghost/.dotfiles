#!/usr/bin/env bash

# Hypridle launcher - Detects device type and launches with appropriate config
# Syncs across devices via Syncthing - automatically configures for laptop vs desktop

set -e

# Colors for logging
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# Detect if we're on a laptop (has battery) or desktop (no battery)
detect_device_type() {
    if ls /sys/class/power_supply/BAT* >/dev/null 2>&1; then
        echo "laptop"
    else
        echo "desktop"
    fi
}

# Generate laptop configuration
generate_laptop_config() {
    cat <<'EOF'
general {
    lock_cmd = omarchy-lock-screen                         # lock screen and 1password
    before_sleep_cmd = loginctl lock-session               # lock before suspend
    after_sleep_cmd = hyprctl dispatch dpms on             # to avoid having to press a key twice to turn on the display
    inhibit_sleep = 3                                      # wait until screen is locked
}

# Start screensaver after 10 minutes
listener {
    timeout = 600                                             # 10 min
    on-timeout = pidof hyprlock || omarchy-launch-screensaver # start screensaver (if we haven't locked already)
}

# Lock screen after 10 minutes
listener {
    timeout = 600                      # 10 min
    on-timeout = loginctl lock-session # lock screen when timeout has passed
}

# Turn off screen after 13 minutes
listener {
    timeout = 800                                            # 13.3 min
    on-timeout = hyprctl dispatch dpms off                   # screen off when timeout has passed
    on-resume = hyprctl dispatch dpms on && brightnessctl -r # screen on when activity is detected
}

# Suspend after 20 minutes (laptop only)
listener {
    timeout = 1200                     # 20 min
    on-timeout = systemctl suspend     # suspend when timeout has passed
}
EOF
}

# Generate desktop configuration (no timeouts - desktop stays on)
generate_desktop_config() {
    cat <<'EOF'
general {
    lock_cmd = omarchy-lock-screen                         # lock screen and 1password (manual only)
    before_sleep_cmd = loginctl lock-session               # lock before suspend (manual only)
    # after_sleep_cmd = hyprctl dispatch dpms on             # to avoid having to press a key twice to turn on the display
}

# Desktop configuration: NO automatic timeouts
# - No screensaver
# - No automatic locking
# - No screen off
# - No suspend
# Desktop should remain fully active until manually controlled
EOF
}

# Main execution
main() {
    DEVICE_TYPE=$(detect_device_type)
    CONFIG_DIR="$HOME/.cache/hypridle"
    CONFIG_FILE="$CONFIG_DIR/hypridle.conf"
    
    # Create cache directory if it doesn't exist
    mkdir -p "$CONFIG_DIR"
    
    log_info "Detected device type: ${YELLOW}$DEVICE_TYPE${NC}"
    
    # Generate appropriate config based on device type
    if [ "$DEVICE_TYPE" = "laptop" ]; then
        log_info "Generating laptop configuration with sleep/suspend enabled"
        generate_laptop_config > "$CONFIG_FILE"
    else
        log_info "Generating desktop configuration with sleep/suspend disabled"
        generate_desktop_config > "$CONFIG_FILE"
    fi
    
    log_success "Configuration generated at $CONFIG_FILE"
    
    # Kill any existing hypridle process
    if pidof hypridle >/dev/null; then
        log_info "Stopping existing hypridle process"
        killall hypridle
        sleep 1
    fi
    
    # Launch hypridle with the generated config
    log_info "Starting hypridle with $DEVICE_TYPE configuration"
    exec /usr/bin/hypridle -c "$CONFIG_FILE"
}

main "$@"
