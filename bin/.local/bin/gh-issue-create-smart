#!/usr/bin/env bash

set -euo pipefail

REPO=""
TEMPLATE_SELECTOR=""
EXTRA_ARGS=()

usage() {
  cat <<'EOF'
Usage: gh-issue-create-smart [options] [-- <gh issue create args>]

Create a GitHub issue from the terminal using Markdown templates or YAML issue forms.

Options:
  -R, --repo <owner/repo>     Target another repository
  -T, --template <name>       Template name, filename, or path to use
  -h, --help                  Show this help message

Examples:
  gh-issue-create-smart
  gh-issue-create-smart --template "Bug report"
  gh-issue-create-smart --repo owner/repo
  gh-issue-create-smart -- --milestone v1.0
EOF
}

require_command() {
  local command_name="$1"
  local message="$2"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf '%s\n' "$message" >&2
    exit 1
  fi
}

choose_one() {
  local prompt="$1"
  shift

  if command -v gum >/dev/null 2>&1; then
    gum choose --header "$prompt" "$@"
  else
    printf '%s\n' "$prompt" >&2
    select choice in "$@"; do
      if [[ -n "${choice:-}" ]]; then
        printf '%s\n' "$choice"
        return 0
      fi
    done
  fi
}

read_repo_args() {
  local -n target_ref=$1
  target_ref=()

  if [[ -n "$REPO" ]]; then
    target_ref=(--repo "$REPO")
  fi
}

resolve_repo() {
  local -a gh_repo_args

  read_repo_args gh_repo_args
  gh repo view "${gh_repo_args[@]}" --json nameWithOwner --template '{{.nameWithOwner}}'
}

download_template() {
  local repo_name="$1"
  local template_path="$2"
  local destination="$3"
  local -a gh_repo_args

  read_repo_args gh_repo_args
  gh api "${gh_repo_args[@]}" "repos/${repo_name}/contents/${template_path}" --jq '.content' | base64 -d > "$destination"
}

list_template_paths() {
  local repo_name="$1"
  local -a gh_repo_args

  read_repo_args gh_repo_args

  if gh api "${gh_repo_args[@]}" "repos/${repo_name}/contents/.github/ISSUE_TEMPLATE" --jq '.[] | select(.type == "file") | select(.name != "config.yml") | .path' 2>/dev/null; then
    return 0
  fi

  if gh api "${gh_repo_args[@]}" "repos/${repo_name}/contents/.github/ISSUE_TEMPLATE.md" --silent >/dev/null 2>&1; then
    printf '%s\n' '.github/ISSUE_TEMPLATE.md'
    return 0
  fi

  printf 'No issue templates found for %s\n' "$repo_name" >&2
  exit 1
}

template_meta() {
  local template_file="$1"

  ruby - "$template_file" <<'RUBY'
require 'yaml'

template_path = ARGV[0]
content = File.read(template_path)
extension = File.extname(template_path).downcase

def print_meta(format:, name:, description:)
  puts [name, description, format].join("\t")
end

if ['.yml', '.yaml'].include?(extension)
  data = YAML.safe_load(content, permitted_classes: [], aliases: true) || {}
  print_meta(
    format: 'issue-form',
    name: data['name'].to_s.strip.empty? ? File.basename(template_path) : data['name'].to_s.strip,
    description: data['description'].to_s.strip,
  )
  exit 0
end

if content.start_with?("---\n")
  parts = content.split(/^---\s*$\n?/, 3)
  if parts.length >= 3
    front_matter = YAML.safe_load(parts[1], permitted_classes: [], aliases: true) || {}
    print_meta(
      format: 'markdown',
      name: front_matter['name'].to_s.strip.empty? ? File.basename(template_path) : front_matter['name'].to_s.strip,
      description: front_matter['about'].to_s.strip,
    )
    exit 0
  end
end

print_meta(
  format: 'markdown',
  name: File.basename(template_path),
  description: '',
)
RUBY
}

render_draft() {
  local template_file="$1"
  local metadata_file="$2"
  local draft_file="$3"

  ruby - "$template_file" "$metadata_file" "$draft_file" <<'RUBY'
require 'json'
require 'yaml'

template_path, metadata_path, draft_path = ARGV
content = File.read(template_path)
extension = File.extname(template_path).downcase

def string_array(value)
  case value
  when Array
    value.map(&:to_s).map(&:strip).reject(&:empty?)
  when String
    value.split(',').map(&:strip).reject(&:empty?)
  else
    []
  end
end

def write_json(path, payload)
  File.write(path, JSON.pretty_generate(payload))
end

def render_markdown(template_path, content, metadata_path, draft_path)
  metadata = {
    'format' => 'markdown',
    'name' => File.basename(template_path),
    'description' => '',
    'title' => '',
    'labels' => [],
    'assignees' => [],
  }
  body = content

  if content.start_with?("---\n")
    parts = content.split(/^---\s*$\n?/, 3)
    if parts.length >= 3
      front_matter = YAML.safe_load(parts[1], permitted_classes: [], aliases: true) || {}
      metadata['name'] = front_matter['name'].to_s.strip unless front_matter['name'].to_s.strip.empty?
      metadata['description'] = front_matter['about'].to_s.strip
      metadata['title'] = front_matter['title'].to_s
      metadata['labels'] = string_array(front_matter['labels'])
      metadata['assignees'] = string_array(front_matter['assignees'])
      body = parts[2]
    end
  end

  write_json(metadata_path, metadata)

  File.open(draft_path, 'w') do |file|
    file.puts(metadata['title'])
    file.puts
    file.write(body)
  end
end

def render_field_comments(file, attributes)
  description = attributes['description'].to_s.strip
  placeholder = attributes['placeholder']
  value = attributes['value']

  file.puts("<!-- #{description} -->") unless description.empty?

  if placeholder.is_a?(String) && !placeholder.strip.empty?
    placeholder.split("\n").each do |line|
      file.puts("<!-- #{line} -->")
    end
  end

  if value.is_a?(String) && !value.strip.empty?
    file.puts(value)
  end
end

data = YAML.safe_load(content, permitted_classes: [], aliases: true) || {}

unless ['.yml', '.yaml'].include?(extension)
  render_markdown(template_path, content, metadata_path, draft_path)
  exit 0
end

fields = Array(data['body']).filter_map do |field|
  next unless field.is_a?(Hash)
  type = field['type'].to_s
  next if type == 'markdown'

  attributes = field['attributes'].is_a?(Hash) ? field['attributes'] : {}
  validations = field['validations'].is_a?(Hash) ? field['validations'] : {}

  {
    'id' => field['id'].to_s,
    'type' => type,
    'label' => attributes['label'].to_s,
    'required' => validations['required'] == true,
    'multiple' => attributes['multiple'] == true,
    'description' => attributes['description'].to_s,
    'placeholder' => attributes['placeholder'],
    'value' => attributes['value'],
    'render' => attributes['render'].to_s,
    'options' => Array(attributes['options']).map do |option|
      option.is_a?(Hash) ? { 'label' => option['label'].to_s, 'required' => option['required'] == true } : { 'label' => option.to_s, 'required' => false }
    end,
  }
end

metadata = {
  'format' => 'issue-form',
  'name' => data['name'].to_s,
  'description' => data['description'].to_s,
  'title' => data['title'].to_s,
  'labels' => string_array(data['labels']),
  'assignees' => string_array(data['assignees']),
  'fields' => fields,
}

write_json(metadata_path, metadata)

File.open(draft_path, 'w') do |file|
  file.puts(metadata['title'])
  file.puts
  file.puts("<!-- Template: #{metadata['name']} -->") unless metadata['name'].to_s.strip.empty?
  file.puts("<!-- #{metadata['description']} -->") unless metadata['description'].to_s.strip.empty?
  file.puts('<!-- Edit the sections below. Comment lines are ignored. -->')
  file.puts

  Array(data['body']).each do |field|
    next unless field.is_a?(Hash)

    type = field['type'].to_s
    attributes = field['attributes'].is_a?(Hash) ? field['attributes'] : {}
    validations = field['validations'].is_a?(Hash) ? field['validations'] : {}

    if type == 'markdown'
      value = attributes['value'].to_s.rstrip
      unless value.empty?
        value.each_line { |line| file.puts("<!-- #{line.rstrip} -->") }
        file.puts
      end
      next
    end

    field_metadata = {
      'id' => field['id'].to_s,
      'type' => type,
      'label' => attributes['label'].to_s,
      'required' => validations['required'] == true,
      'multiple' => attributes['multiple'] == true,
      'options' => Array(attributes['options']).map do |option|
        option.is_a?(Hash) ? { 'label' => option['label'].to_s, 'required' => option['required'] == true } : { 'label' => option.to_s, 'required' => false }
      end,
    }

    file.puts("<!-- ghis:field #{JSON.generate(field_metadata)} -->")
    file.puts("## #{attributes['label']}")

    case type
    when 'checkboxes'
      description = attributes['description'].to_s.strip
      file.puts("<!-- #{description} -->") unless description.empty?
      Array(attributes['options']).each do |option|
        option_label = option.is_a?(Hash) ? option['label'].to_s : option.to_s
        file.puts("- [ ] #{option_label}")
      end
    when 'dropdown'
      description = attributes['description'].to_s.strip
      file.puts("<!-- #{description} -->") unless description.empty?
      file.puts("<!-- Select #{attributes['multiple'] == true ? 'one or more' : 'one'} by checking the boxes below. -->")
      Array(attributes['options']).each do |option|
        option_label = option.is_a?(Hash) ? option['label'].to_s : option.to_s
        file.puts("- [ ] #{option_label}")
      end
    else
      render_field_comments(file, attributes)
    end

    file.puts
  end
end
RUBY
}

parse_draft() {
  local metadata_file="$1"
  local draft_file="$2"
  local body_file="$3"

  ruby - "$metadata_file" "$draft_file" "$body_file" <<'RUBY'
require 'json'

metadata_path, draft_path, body_path = ARGV
metadata = JSON.parse(File.read(metadata_path))
draft_lines = File.readlines(draft_path, chomp: true)

title = draft_lines.first.to_s.rstrip
if title.strip.empty?
  warn 'Issue title cannot be empty'
  exit 1
end

body_lines = draft_lines.drop(1)
body_lines.shift while body_lines.first == ''

if metadata['format'] == 'markdown'
  File.write(body_path, body_lines.join("\n").rstrip + "\n")
  puts title
  exit 0
end

fields = metadata.fetch('fields', [])
sections = {}
current_id = nil

body_lines.each do |line|
  if line =~ /^<!-- ghis:field (.+) -->$/
    data = JSON.parse(Regexp.last_match(1))
    current_id = data['id']
    sections[current_id] = { 'meta' => data, 'lines' => [] }
    next
  end

  next if current_id.nil?
  sections[current_id]['lines'] << line
end

rendered_sections = []

fields.each do |field|
  section = sections[field['id']]
  next unless section

  lines = section['lines'].dup
  lines.shift if lines.first.to_s == "## #{field['label']}"
  lines = lines.reject { |line| line.start_with?('<!--') }

  case field['type']
  when 'checkboxes', 'dropdown'
    checked_labels = lines.filter_map do |line|
      match = line.match(/^- \[(x|X)\] (.+)$/)
      match ? match[2].strip : nil
    end

    required_options = Array(field['options']).select { |option| option['required'] == true }.map { |option| option['label'] }
    missing_required = required_options - checked_labels
    unless missing_required.empty?
      warn "#{field['label']}: required selections are missing"
      exit 1
    end

    if field['required'] == true && checked_labels.empty?
      warn "#{field['label']}: select at least one option"
      exit 1
    end

    if field['type'] == 'dropdown' && field['multiple'] != true && checked_labels.length > 1
      warn "#{field['label']}: select only one option"
      exit 1
    end

    next if checked_labels.empty? && required_options.empty?

    rendered_sections << "## #{field['label']}\n" + checked_labels.map { |label| "- #{label}" }.join("\n")
  else
    content_lines = lines.drop_while(&:empty?)
    content_lines = content_lines.reverse.drop_while(&:empty?).reverse
    content = content_lines.join("\n").rstrip

    if field['required'] == true && content.strip.empty?
      warn "#{field['label']}: this field is required"
      exit 1
    end

    next if content.strip.empty?
    rendered_sections << "## #{field['label']}\n#{content}"
  end
end

File.write(body_path, rendered_sections.join("\n\n").rstrip + "\n")
puts title
RUBY
}

match_template() {
  local selector="$1"
  shift
  local path name description format
  local normalized_selector

  normalized_selector="$(printf '%s' "$selector" | tr '[:upper:]' '[:lower:]')"

  while IFS=$'\t' read -r path name description format; do
    [[ -n "$path" ]] || continue
    if [[ "$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')" == "$normalized_selector" ]] ||
       [[ "$(printf '%s' "$(basename "$path")" | tr '[:upper:]' '[:lower:]')" == "$normalized_selector" ]] ||
       [[ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" == "$normalized_selector" ]]; then
      printf '%s\t%s\t%s\t%s\n' "$path" "$name" "$description" "$format"
      return 0
    fi
  done

  return 1
}

main() {
  local -a gh_repo_args create_args
  local repo_name template_paths path line name description format selection selected_path selected_name
  local temp_dir template_file metadata_file draft_file body_file editor title template_catalog selected_display
  local -a labels assignees

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -R|--repo)
        if [[ $# -lt 2 ]]; then
          printf 'Error: %s requires a repository\n' "$1" >&2
          exit 1
        fi
        REPO="$2"
        shift 2
        ;;
      -T|--template)
        if [[ $# -lt 2 ]]; then
          printf 'Error: %s requires a template name\n' "$1" >&2
          exit 1
        fi
        TEMPLATE_SELECTOR="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        EXTRA_ARGS+=("$@")
        break
        ;;
      *)
        EXTRA_ARGS+=("$1")
        shift
        ;;
    esac
  done

  require_command gh 'gh CLI is required for gh-issue-create-smart'
  require_command ruby 'ruby is required for gh-issue-create-smart'

  if [[ -z "$REPO" ]] && ! git rev-parse --git-dir >/dev/null 2>&1; then
    printf 'gh-issue-create-smart must run inside a git repository or use --repo\n' >&2
    exit 1
  fi

  read_repo_args gh_repo_args
  repo_name="$(resolve_repo)"

  temp_dir="$(mktemp -d)"
  template_file=""
  metadata_file="$temp_dir/template.json"
  draft_file="$temp_dir/draft.md"
  body_file="$temp_dir/body.md"
  trap 'rm -rf "${temp_dir:-}"' EXIT

  mapfile -t template_paths < <(list_template_paths "$repo_name")

  if [[ ${#template_paths[@]} -eq 0 ]]; then
    printf 'No issue templates found for %s\n' "$repo_name" >&2
    exit 1
  fi

  template_catalog=""
  for path in "${template_paths[@]}"; do
    template_file="$temp_dir/$(basename "$path")"
    download_template "$repo_name" "$path" "$template_file"
    line="$(template_meta "$template_file")"
    template_catalog+="${path}"$'\t'"${line}"$'\n'
  done

  if [[ -n "$TEMPLATE_SELECTOR" ]]; then
    if ! selection="$(match_template "$TEMPLATE_SELECTOR" <<<"$template_catalog")"; then
      printf 'Template not found: %s\n' "$TEMPLATE_SELECTOR" >&2
      exit 1
    fi
  elif [[ ${#template_paths[@]} -eq 1 ]]; then
    selection="$(printf '%s' "$template_catalog" | sed -n '1p')"
  else
    mapfile -t options < <(while IFS=$'\t' read -r option_path option_name option_description option_format; do
      [[ -n "$option_path" ]] || continue
      if [[ -n "$option_description" ]]; then
        printf '%s (%s)\n' "$option_name" "$option_description"
      else
        printf '%s\n' "$option_name"
      fi
    done <<<"$template_catalog")

    selected_display="$(choose_one 'Select issue template' "${options[@]}")"
    selection="$(while IFS=$'\t' read -r option_path option_name option_description option_format; do
      [[ -n "$option_path" ]] || continue
      if [[ -n "$option_description" ]]; then
        if [[ "$selected_display" == "${option_name} (${option_description})" ]]; then
          printf '%s\t%s\t%s\t%s\n' "$option_path" "$option_name" "$option_description" "$option_format"
          break
        fi
      elif [[ "$selected_display" == "$option_name" ]]; then
        printf '%s\t%s\t%s\t%s\n' "$option_path" "$option_name" "$option_description" "$option_format"
        break
      fi
    done <<<"$template_catalog")"
  fi

  IFS=$'\t' read -r selected_path selected_name description format <<<"$selection"

  if [[ -z "$selected_path" ]]; then
    printf 'Failed to resolve issue template\n' >&2
    exit 1
  fi

  template_file="$temp_dir/$(basename "$selected_path")"
  download_template "$repo_name" "$selected_path" "$template_file"
  render_draft "$template_file" "$metadata_file" "$draft_file"

  editor="${VISUAL:-${EDITOR:-nvim}}"
  eval "$editor \"$draft_file\""

  title="$(parse_draft "$metadata_file" "$draft_file" "$body_file")"

  mapfile -t labels < <(ruby -rjson -e 'data = JSON.parse(File.read(ARGV[0])); Array(data["labels"]).each { |value| puts value }' "$metadata_file")
  mapfile -t assignees < <(ruby -rjson -e 'data = JSON.parse(File.read(ARGV[0])); Array(data["assignees"]).each { |value| puts value }' "$metadata_file")

  create_args=(--title "$title" --body-file "$body_file")
  for name in "${labels[@]}"; do
    create_args+=(--label "$name")
  done
  for name in "${assignees[@]}"; do
    create_args+=(--assignee "$name")
  done
  if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
    create_args+=("${EXTRA_ARGS[@]}")
  fi

  gh issue create "${gh_repo_args[@]}" "${create_args[@]}"
}

main "$@"
