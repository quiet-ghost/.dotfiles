#!/usr/bin/env bash

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

TEMPLATE_ROOT="$HOME/.dotfiles/templates/repo"
TEMPLATE_MODEL="openai/gpt-5.4"
TEMPLATE_API_KEY_ENV="OPENAI_API_KEY"
TEMPLATE_CODEOWNER="@quiet-ghost"
TEMPLATE_ISSUE_ASSIGNEE="quiet-ghost"
REPO_MODE=""
CONFLICT_STRATEGY="prompt"
HAS_REPO_CHANGES=false
TARGET_DIR=""
REPO_NAME=""

log_info() { echo -e "${BLUE}INFO${NC} $1"; }
log_success() { echo -e "${GREEN}OK${NC} $1"; }
log_warning() { echo -e "${YELLOW}WARN${NC} $1"; }
log_error() { echo -e "${RED}ERROR${NC} $1"; }

auto_allow_direnv() {
  local envrc_path="$TARGET_DIR/.envrc"

  if [[ ! -f "$envrc_path" ]]; then
    return 0
  fi

  if ! command -v direnv >/dev/null 2>&1; then
    log_info "direnv not installed; run 'direnv allow' later if you add it"
    return 0
  fi

  if direnv allow "$envrc_path" >/dev/null 2>&1; then
    log_success "Allowed direnv for ${TARGET_DIR#$HOME/}"
  else
    log_warning "Could not run 'direnv allow $envrc_path' automatically"
    log_info "Run: direnv allow $envrc_path"
  fi
}

print_header() {
  local message="$1"

  if command -v gum >/dev/null 2>&1; then
    gum style --border rounded --padding "0 1" --margin "1 0" --border-foreground 212 "$message"
  else
    echo -e "${PURPLE}$message${NC}"
  fi
}

usage() {
  cat <<'EOF'
Usage: repo-init [target-directory]

Interactive project bootstrapper for Ghost's local workflow.

Examples:
  repo-init
  repo-init my-new-project
EOF
}

choose_one() {
  local prompt="$1"
  shift

  if command -v gum >/dev/null 2>&1; then
    gum choose --header "$prompt" "$@"
  else
    printf '%s\n' "$prompt" >&2
    select choice in "$@"; do
      if [[ -n "${choice:-}" ]]; then
        printf '%s\n' "$choice"
        return 0
      fi
    done
  fi
}

input_text() {
  local prompt="$1"
  local placeholder="$2"
  local default_value="${3:-}"

  if command -v gum >/dev/null 2>&1; then
    gum input --prompt "$prompt " --placeholder "$placeholder" --value "$default_value"
  else
    local response
    if [[ -n "$default_value" ]]; then
      read -r -p "$prompt [$default_value]: " response
      printf '%s\n' "${response:-$default_value}"
    else
      read -r -p "$prompt: " response
      printf '%s\n' "$response"
    fi
  fi
}

confirm_action() {
  local prompt="$1"

  if command -v gum >/dev/null 2>&1; then
    gum confirm "$prompt"
  else
    local response
    read -r -p "$prompt [y/N]: " response
    [[ "$response" =~ ^[Yy]$ ]]
  fi
}

escape_sed_replacement() {
  printf '%s' "$1" | sed -e 's/[\\&/]/\\&/g'
}

render_template_file() {
  local source_file="$1"
  local destination_file="$2"
  local escaped_repo_name escaped_model escaped_api_key_env escaped_codeowner escaped_issue_assignee

  escaped_repo_name="$(escape_sed_replacement "$REPO_NAME")"
  escaped_model="$(escape_sed_replacement "$TEMPLATE_MODEL")"
  escaped_api_key_env="$(escape_sed_replacement "$TEMPLATE_API_KEY_ENV")"
  escaped_codeowner="$(escape_sed_replacement "$TEMPLATE_CODEOWNER")"
  escaped_issue_assignee="$(escape_sed_replacement "$TEMPLATE_ISSUE_ASSIGNEE")"

  mkdir -p "$(dirname "$destination_file")"
  sed \
    -e "s/__REPO_NAME__/${escaped_repo_name}/g" \
    -e "s/__MODEL__/${escaped_model}/g" \
    -e "s/__MODEL_API_KEY_ENV__/${escaped_api_key_env}/g" \
    -e "s/__CODEOWNER__/${escaped_codeowner}/g" \
    -e "s/__ISSUE_ASSIGNEE__/${escaped_issue_assignee}/g" \
    "$source_file" > "$destination_file"
}

dir_is_empty() {
  local dir="$1"
  shopt -s nullglob dotglob
  local entries=("$dir"/*)
  shopt -u nullglob dotglob
  [[ ${#entries[@]} -eq 0 ]]
}

module_label() {
  case "$1" in
    base) printf '%s\n' 'README starter' ;;
    opencode) printf '%s\n' 'OpenCode core files' ;;
    pr-review) printf '%s\n' 'Automatic PR review workflow' ;;
    review-command) printf '%s\n' 'Slash-command PR workflows (/review + /oc)' ;;
    pr-standards) printf '%s\n' 'PR standards workflow' ;;
    issue-templates) printf '%s\n' 'Issue templates' ;;
    issue-triage) printf '%s\n' 'Issue triage workflow' ;;
    issue-automation) printf '%s\n' 'Issue duplicate/compliance workflow' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

module_requires_model() {
  case "$1" in
    opencode|pr-review|review-command|issue-automation) return 0 ;;
    *) return 1 ;;
  esac
}

modules_require_model() {
  local module_name
  for module_name in "${MODULES[@]}"; do
    if module_requires_model "$module_name"; then
      return 0
    fi
  done
  return 1
}

module_requires_codeowner() {
  case "$1" in
    review-command) return 0 ;;
    *) return 1 ;;
  esac
}

modules_require_codeowner() {
  local module_name
  for module_name in "${MODULES[@]}"; do
    if module_requires_codeowner "$module_name"; then
      return 0
    fi
  done
  return 1
}

module_requires_issue_assignee() {
  case "$1" in
    issue-templates|issue-triage) return 0 ;;
    *) return 1 ;;
  esac
}

modules_require_issue_assignee() {
  local module_name
  for module_name in "${MODULES[@]}"; do
    if module_requires_issue_assignee "$module_name"; then
      return 0
    fi
  done
  return 1
}

append_module() {
  MODULES+=("$1")
}

normalize_modules() {
  local module_name
  local seen_modules=""
  local deduped_modules=()

  for module_name in "${MODULES[@]}"; do
    case "$module_name" in
      pr-review|review-command)
        if [[ " ${MODULES[*]} " != *" opencode "* ]]; then
          MODULES+=("opencode")
        fi
        ;;
      issue-triage)
        if [[ " ${MODULES[*]} " != *" issue-templates "* ]]; then
          MODULES+=("issue-templates")
        fi
        ;;
      issue-automation)
        if [[ " ${MODULES[*]} " != *" issue-templates "* ]]; then
          MODULES+=("issue-templates")
        fi
        ;;
    esac
  done

  for module_name in "${MODULES[@]}"; do
    if [[ " $seen_modules " == *" $module_name "* ]]; then
      continue
    fi

    deduped_modules+=("$module_name")
    seen_modules+=" $module_name"
  done

  MODULES=("${deduped_modules[@]}")
}

module_file_count() {
  local module_dir="$TEMPLATE_ROOT/$1"

  if [[ ! -d "$module_dir" ]]; then
    printf '0\n'
    return 0
  fi

  find "$module_dir" -type f | wc -l | tr -d ' '
}

planned_conflicts() {
  local count=0
  local module_name module_dir source_file relative_path destination_file

  for module_name in "${MODULES[@]}"; do
    module_dir="$TEMPLATE_ROOT/$module_name"

    while IFS= read -r -d '' source_file; do
      relative_path="${source_file#"$module_dir"/}"
      destination_file="$TARGET_DIR/$relative_path"
      if [[ -e "$destination_file" ]]; then
        count=$((count + 1))
      fi
    done < <(find "$module_dir" -type f -print0)
  done

  printf '%s\n' "$count"
}

resolve_conflict() {
  local destination_file="$1"
  local choice

  case "$CONFLICT_STRATEGY" in
    overwrite)
      return 0
      ;;
    skip)
      return 1
      ;;
    backup)
      cp "$destination_file" "$destination_file.bak.$(date +%s)"
      return 0
      ;;
    prompt)
      choice="$(choose_one "File exists: ${destination_file#$TARGET_DIR/}" "Skip" "Overwrite" "Backup and overwrite")"
      case "$choice" in
        "Skip") return 1 ;;
        "Overwrite") return 0 ;;
        "Backup and overwrite")
          cp "$destination_file" "$destination_file.bak.$(date +%s)"
          return 0
          ;;
      esac
      ;;
  esac

  log_error "Unknown conflict strategy: $CONFLICT_STRATEGY"
  exit 1
}

apply_module() {
  local module_name="$1"
  local module_dir="$TEMPLATE_ROOT/$module_name"
  local source_file relative_path destination_file

  if [[ ! -d "$module_dir" ]]; then
    log_error "Missing template module: $module_name"
    exit 1
  fi

  while IFS= read -r -d '' source_file; do
    relative_path="${source_file#"$module_dir"/}"
    destination_file="$TARGET_DIR/$relative_path"

    if [[ -e "$destination_file" ]] && ! resolve_conflict "$destination_file"; then
      log_warning "Skipped ${destination_file#$TARGET_DIR/}"
      continue
    fi

    render_template_file "$source_file" "$destination_file"
    log_success "Wrote ${destination_file#$TARGET_DIR/}"
  done < <(find "$module_dir" -type f -print0)
}

select_target_dir() {
  local provided_target="${1:-}"
  local location_choice repo_name target_dir

  if [[ -n "$provided_target" ]]; then
    printf '%s\n' "$provided_target"
    return 0
  fi

  location_choice="$(choose_one "Where should the project live?" "Use current directory" "Create new directory here")"

  if [[ "$location_choice" == "Use current directory" ]]; then
    printf '%s\n' "$PWD"
    return 0
  fi

  repo_name="$(input_text "Repository name" "my-project")"
  if [[ -z "$repo_name" ]]; then
    log_error "Repository name cannot be empty"
    exit 1
  fi

  target_dir="$PWD/$repo_name"
  printf '%s\n' "$target_dir"
}

detect_repo_mode() {
  if [[ -d "$TARGET_DIR/.git" ]]; then
    printf '%s\n' 'existing'
    return 0
  fi

  if [[ ! -d "$TARGET_DIR" ]] || dir_is_empty "$TARGET_DIR"; then
    printf '%s\n' 'new'
    return 0
  fi

  printf '%s\n' 'existing'
}

choose_repo_mode() {
  local detected_mode choice

  detected_mode="$(detect_repo_mode)"

  choice="$(choose_one "How should repo-init treat this directory?" "Use detected mode (${detected_mode})" "New project" "Existing repo")"

  case "$choice" in
    "Use detected mode (${detected_mode})") REPO_MODE="$detected_mode" ;;
    "New project") REPO_MODE='new' ;;
    "Existing repo") REPO_MODE='existing' ;;
    *)
      log_error "Unknown mode option: $choice"
      exit 1
      ;;
  esac
}

scan_repo_state() {
  local findings=()

  [[ -d "$TARGET_DIR/.git" ]] && findings+=("git repo")
  [[ -f "$TARGET_DIR/AGENTS.md" ]] && findings+=("AGENTS.md")
  [[ -f "$TARGET_DIR/opencode.json" ]] && findings+=("opencode.json")
  [[ -d "$TARGET_DIR/.github/workflows" ]] && findings+=(".github/workflows")

  if [[ ${#findings[@]} -eq 0 ]]; then
    log_info "No existing scaffold files detected"
    return 0
  fi

  log_info "Detected: ${findings[*]}"
}

configure_new_preset() {
  local preset

  preset="$(choose_one "Choose a new-project preset" "Complete workflow (Recommended)" "Minimal workflow" "OpenCode core" "Review command workflow" "Automatic PR review workflow" "Custom workflow")"

  case "$preset" in
    "Complete workflow (Recommended)")
      append_module base
      append_module opencode
      append_module pr-review
      append_module review-command
      append_module pr-standards
      append_module issue-templates
      append_module issue-triage
      append_module issue-automation
      ;;
    "Minimal workflow")
      append_module base
      ;;
    "OpenCode core")
      append_module base
      append_module opencode
      ;;
    "Review command workflow")
      append_module base
      append_module opencode
      append_module review-command
      ;;
    "Automatic PR review workflow")
      append_module base
      append_module opencode
      append_module pr-review
      ;;
    "Custom workflow")
      configure_custom_modules
      ;;
    *)
      log_error "Unknown preset: $preset"
      exit 1
      ;;
  esac
}

configure_existing_preset() {
  local preset

  preset="$(choose_one "Choose an existing-repo preset" "Complete workflow retrofit (Recommended)" "Add OpenCode core files" "Add automatic PR review workflow" "Add review command workflow" "Add PR standards workflow" "Add issue management workflow" "Add issue templates only" "Custom workflow")"

  case "$preset" in
    "Complete workflow retrofit (Recommended)")
      append_module opencode
      append_module pr-review
      append_module review-command
      append_module pr-standards
      append_module issue-templates
      append_module issue-triage
      append_module issue-automation
      ;;
    "Add OpenCode core files")
      append_module opencode
      ;;
    "Add automatic PR review workflow")
      append_module opencode
      append_module pr-review
      ;;
    "Add review command workflow")
      append_module opencode
      append_module review-command
      ;;
    "Add PR standards workflow")
      append_module pr-standards
      ;;
    "Add issue management workflow")
      append_module issue-templates
      append_module issue-triage
      append_module issue-automation
      ;;
    "Add issue templates only")
      append_module issue-templates
      ;;
    "Custom workflow")
      configure_custom_modules
      ;;
    *)
      log_error "Unknown preset: $preset"
      exit 1
      ;;
  esac
}

configure_custom_modules() {
  if confirm_action "Add README starter?"; then
    append_module base
  fi

  if confirm_action "Add OpenCode core files?"; then
    append_module opencode
  fi

  if confirm_action "Add automatic PR review workflow?"; then
    append_module pr-review
  fi

  if confirm_action "Add slash-command PR workflows (/review + /oc)?"; then
    append_module review-command
  fi

  if confirm_action "Add PR standards workflow?"; then
    append_module pr-standards
  fi

  if confirm_action "Add issue templates?"; then
    append_module issue-templates
  fi

  if confirm_action "Add issue triage workflow?"; then
    append_module issue-triage
  fi

  if confirm_action "Add issue duplicate/compliance workflow?"; then
    append_module issue-automation
  fi
}

configure_model() {
  local provider_choice custom_model opencode_model_choice

  provider_choice="$(choose_one "Choose the review model provider" "OpenAI (recommended)" "OpenCode" "Custom model string")"

  case "$provider_choice" in
    "OpenAI (recommended)")
      TEMPLATE_MODEL="$(input_text "OpenAI model" "openai/gpt-5.4" "openai/gpt-5.4")"
      TEMPLATE_API_KEY_ENV="OPENAI_API_KEY"
      ;;
    "OpenCode")
      opencode_model_choice="$(choose_one "Choose the OpenCode model" "opencode/gpt-5.4" "opencode/gpt-5.3-codex" "opencode/kimi-k2.5")"
      TEMPLATE_MODEL="$opencode_model_choice"
      TEMPLATE_API_KEY_ENV="OPENCODE_API_KEY"
      ;;
    "Custom model string")
      custom_model="$(input_text "Model" "provider/model")"
      if [[ -z "$custom_model" || "$custom_model" != */* ]]; then
        log_error "Custom model must use provider/model format"
        exit 1
      fi

      TEMPLATE_MODEL="$custom_model"
      TEMPLATE_API_KEY_ENV="$(input_text "API key env var" "OPENAI_API_KEY")"
      if [[ -z "$TEMPLATE_API_KEY_ENV" ]]; then
        log_error "API key env var cannot be empty"
        exit 1
      fi
      ;;
    *)
      log_error "Unknown provider option: $provider_choice"
      exit 1
      ;;
  esac
}

default_codeowner() {
  if command -v gh >/dev/null 2>&1; then
    local login
    login="$(gh api user --jq .login 2>/dev/null || true)"
    if [[ -n "$login" ]]; then
      printf '@%s\n' "$login"
      return 0
    fi
  fi

  printf '@quiet-ghost\n'
}

configure_codeowner() {
  local default_owner codeowner

  default_owner="$(default_codeowner)"
  codeowner="$(input_text "Primary CODEOWNER handle" "@org-or-user" "$default_owner")"

  if [[ -z "$codeowner" || "$codeowner" != @* ]]; then
    log_error "CODEOWNER handle must start with @"
    exit 1
  fi

  TEMPLATE_CODEOWNER="$codeowner"
}

default_issue_assignee() {
  if command -v gh >/dev/null 2>&1; then
    local login
    login="$(gh api user --jq .login 2>/dev/null || true)"
    if [[ -n "$login" ]]; then
      printf '%s\n' "$login"
      return 0
    fi
  fi

  if [[ "$TEMPLATE_CODEOWNER" =~ ^@[^/]+$ ]]; then
    printf '%s\n' "${TEMPLATE_CODEOWNER#@}"
    return 0
  fi

  printf 'quiet-ghost\n'
}

configure_issue_assignee() {
  local default_assignee assignee

  default_assignee="$(default_issue_assignee)"
  assignee="$(input_text "Default issue assignee login" "github-login" "$default_assignee")"

  if [[ -z "$assignee" || "$assignee" == @* || "$assignee" == */* ]]; then
    log_error "Issue assignee must be a single GitHub login without @"
    exit 1
  fi

  TEMPLATE_ISSUE_ASSIGNEE="$assignee"
}

choose_conflict_strategy() {
  local choice

  choice="$(choose_one "How should existing files be handled?" "Prompt on conflicts (Recommended)" "Skip existing files" "Backup and overwrite" "Overwrite existing files")"

  case "$choice" in
    "Prompt on conflicts (Recommended)") CONFLICT_STRATEGY='prompt' ;;
    "Skip existing files") CONFLICT_STRATEGY='skip' ;;
    "Backup and overwrite") CONFLICT_STRATEGY='backup' ;;
    "Overwrite existing files") CONFLICT_STRATEGY='overwrite' ;;
    *)
      log_error "Unknown conflict option: $choice"
      exit 1
      ;;
  esac
}

preview_plan() {
  local module_name module_count conflict_count

  print_header "Planned changes"
  log_info "Mode: $REPO_MODE"
  log_info "Target: $TARGET_DIR"

  module_count=0
  for module_name in "${MODULES[@]}"; do
    module_count=$((module_count + 1))
    log_info "Module ${module_count}: $(module_label "$module_name")"
  done

  conflict_count="$(planned_conflicts)"
  if [[ "$conflict_count" -gt 0 ]]; then
    log_info "Existing files that may conflict: $conflict_count"
  fi
}

should_run_git_init() {
  if [[ -d "$TARGET_DIR/.git" ]]; then
    return 1
  fi

  if [[ "$REPO_MODE" == 'new' ]]; then
    confirm_action "Run git init in $TARGET_DIR?"
    return $?
  fi

  confirm_action "Initialize git in this existing directory?"
}

main() {
  local module_name
  MODULES=()

  if [[ "${1:-}" == '--help' || "${1:-}" == '-h' ]]; then
    usage
    exit 0
  fi

  print_header "Repository scaffold"

  TARGET_DIR="$(select_target_dir "${1:-}")"
  mkdir -p "$TARGET_DIR"
  TARGET_DIR="$(realpath "$TARGET_DIR")"
  REPO_NAME="$(basename "$TARGET_DIR")"

  choose_repo_mode
  scan_repo_state

  if [[ "$REPO_MODE" == 'new' ]]; then
    configure_new_preset
  else
    configure_existing_preset
  fi

  normalize_modules

  if [[ ${#MODULES[@]} -eq 0 ]]; then
    log_warning "No scaffold modules selected"
    exit 0
  fi

  if modules_require_model; then
    configure_model
  fi

  if modules_require_codeowner; then
    configure_codeowner
  fi

  if modules_require_issue_assignee; then
    configure_issue_assignee
  fi

  if [[ "$REPO_MODE" == 'existing' ]]; then
    choose_conflict_strategy
  fi

  preview_plan

  if ! confirm_action "Apply these templates?"; then
    log_info "Cancelled"
    exit 0
  fi

  if should_run_git_init; then
    git init "$TARGET_DIR" >/dev/null
    log_success "Initialized git repository"
  else
    log_info "Skipped git init"
  fi

  for module_name in "${MODULES[@]}"; do
    apply_module "$module_name"
  done

  print_header "Done"
  log_success "Project scaffolded at $TARGET_DIR"
  auto_allow_direnv
  if modules_require_model; then
    log_info "Configured model: $TEMPLATE_MODEL"
    log_info "Remember to add secret: $TEMPLATE_API_KEY_ENV"
  fi
  if modules_require_codeowner; then
    log_info "Configured CODEOWNER: $TEMPLATE_CODEOWNER"
  fi
  if modules_require_issue_assignee; then
    log_info "Configured issue assignee: $TEMPLATE_ISSUE_ASSIGNEE"
  fi
  log_info "Next steps: cd $TARGET_DIR"
}

main "$@"
